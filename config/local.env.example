# Copy to config/local.env and source it before running hardware workflows.
# Do not commit serial numbers, private paths, or credentials.

# Full external SDKs/toolchains (not included in the portable source bundle).
export PHANTOM_NCS_WORKSPACE="/path/to/nrf_sdk/v3.0.0-rc1"
export PHANTOM_NCS_TOOLCHAIN="/path/to/nrf_sdk/toolchains/7cbc0036f4"
export PHANTOM_NRF5_SDK_ROOT="/path/to/nRF5_SDK_17.1.0_ddde560"

# Optional parser/native/CUDA and UHD overrides.
export PHANTOM_PARSER_PYTHON="/path/to/PhantomChannel/.venv-cuda/bin/python"
export PHANTOM_CAPTURE_BIN="/path/to/uhd_b210_capture_framed_udp"
export PHANTOM_UHD_LIBRARY="/path/to/uhd-4.6.0.0/lib"

# Hardware-specific values are intentionally kept in the YAML config.

