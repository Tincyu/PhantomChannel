+/* Build the complete PC frame directly into the controller TX image. */
+static size_t phantom_central_frame_build(uint8_t *dst, size_t capacity)
+{
+	unsigned int key;
+	size_t covert_len;
+	size_t frame_len;
+	uint16_t sequence;
+	uint8_t check = 0U;
+
+	key = irq_lock();
+	covert_len = phantom_central_covert_len;
+	frame_len = PHANTOM_PC_FRAME_OVERHEAD + covert_len;
+	if (covert_len == 0U || dst == NULL || capacity < frame_len) {
+	#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+		phantom_central_frame_failure = (covert_len == 0U) ? 1U :
+			(dst == NULL ? 2U : 3U);
+	#endif
+		irq_unlock(key);
+		return 0U;
+	}
+
+	sequence = phantom_central_sequence++;
+	dst[0] = 0x50U;
+	dst[1] = 0x43U;
+	dst[2] = (uint8_t)(sequence & 0xffU);
+	dst[3] = (uint8_t)(sequence >> 8);
+	dst[4] = (uint8_t)covert_len;
+	memcpy(&dst[5], phantom_central_covert, covert_len);
+	for (size_t i = 0U; i < frame_len - 1U; i++) {
+		check ^= dst[i];
+	}
+	dst[frame_len - 1U] = check;
+	irq_unlock(key);
+	return frame_len;
+}
