+int bt_phantomchannel_central_set_covert(const uint8_t *data, size_t len)
+{
+#if defined(CONFIG_PHANTOMCHANNEL_CENTRAL_TX)
+	unsigned int key;
+
+	if (len > PHANTOM_CENTRAL_MAX_COVERT_LEN || (len != 0U && data == NULL)) {
+		return -EINVAL;
+	}
+
+	key = irq_lock();
+	if (len != 0U) {
+		memcpy(phantom_central_covert, data, len);
+	}
+	phantom_central_covert_len = (uint16_t)len;
+	phantom_central_sequence = 0U;
+	#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+	phantom_central_counter_report_reset = true;
+	#endif
+	irq_unlock(key);
+	return 0;
+#else
+	ARG_UNUSED(data);
+	ARG_UNUSED(len);
+	return -ENOTSUP;
+#endif
+}
+
+static size_t phantom_central_covert_len_get(void)
+{
+	unsigned int key = irq_lock();
+	size_t len = phantom_central_covert_len;
+
+	irq_unlock(key);
+	return len;
+}
