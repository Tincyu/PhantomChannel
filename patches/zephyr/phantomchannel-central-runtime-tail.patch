+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#ifndef ZEPHYR_INCLUDE_BLUETOOTH_PHANTOMCHANNEL_H_
+#define ZEPHYR_INCLUDE_BLUETOOTH_PHANTOMCHANNEL_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Maximum runtime payload accepted by the central post-CRC path. */
+#define BT_PHANTOMCHANNEL_MAX_COVERT_LEN 239U
+
+/**
+ * Replace the central controller's runtime covert payload.
+ *
+ * The payload is copied into controller-owned storage. The next eligible
+ * central data PDU carries a generated PC frame after the standard CRC;
+ * the application/GATT value is not enlarged. Passing NULL with len 0
+ * disables the post-CRC tail.
+ *
+ * @return 0 on success, -EINVAL for an invalid pointer/length, or
+ *         -ENOTSUP when the controller central extension is not built.
+ */
+int bt_phantomchannel_central_set_covert(const uint8_t *data, size_t len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_INCLUDE_BLUETOOTH_PHANTOMCHANNEL_H_ */
