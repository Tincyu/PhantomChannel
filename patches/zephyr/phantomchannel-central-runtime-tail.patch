+static uint8_t phantom_central_covert[PHANTOM_CENTRAL_MAX_COVERT_LEN];
+static uint16_t phantom_central_covert_len;
+static uint16_t phantom_central_sequence;
+#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+static volatile uint32_t phantom_central_frame_failure;
