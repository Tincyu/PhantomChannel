diff --git a/samples/bluetooth/phantomchannel_hrs_peripheral/src/main.c b/samples/bluetooth/phantomchannel_hrs_peripheral/src/main.c
new file mode 100644
index 00000000000..fd51025cc87
--- /dev/null
+++ b/samples/bluetooth/phantomchannel_hrs_peripheral/src/main.c
@@ -0,0 +1,354 @@
+/*
+ * Phone-facing PhantomChannel HRS peripheral.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <zephyr/bluetooth/addr.h>
+#include <zephyr/bluetooth/bluetooth.h>
+#include <zephyr/bluetooth/conn.h>
+#include <zephyr/bluetooth/gatt.h>
+#include <zephyr/bluetooth/hci.h>
+#include <zephyr/bluetooth/uuid.h>
+#include <zephyr/kernel.h>
+#include <zephyr/sys/byteorder.h>
+#include <zephyr/sys/printk.h>
+
+#define PHANTOM_FRAME_OVERHEAD 6U
+#define PHANTOM_MARKER_LEN 3U
+#define PHANTOM_MAX_COVERT_LEN 240U
+#define PHANTOM_NORMAL_PREFIX_LEN CONFIG_PHANTOMCHANNEL_NORMAL_PREFIX_LEN
+#if IS_ENABLED(CONFIG_PHANTOMCHANNEL_PERIPHERAL_TX)
+#define PHANTOM_COVERT_LEN CONFIG_PHANTOMCHANNEL_COVERT_LEN
+#define PHANTOM_COVERT_MARKER_BYTE \
+	((uint8_t)CONFIG_PHANTOMCHANNEL_COVERT_MARKER_BYTE)
+#define PHANTOM_FRAME_LEN (PHANTOM_FRAME_OVERHEAD + PHANTOM_COVERT_LEN)
+#define PHANTOM_NOTIFY_LEN \
+	(PHANTOM_NORMAL_PREFIX_LEN + PHANTOM_MARKER_LEN + PHANTOM_FRAME_LEN)
+#define PHANTOM_COVERT_LEN_VALUE ((unsigned int)CONFIG_PHANTOMCHANNEL_COVERT_LEN)
+#else
+#define PHANTOM_NOTIFY_LEN (PHANTOM_NORMAL_PREFIX_LEN)
+#define PHANTOM_COVERT_LEN_VALUE 0U
+#endif
+
+BUILD_ASSERT(PHANTOM_NORMAL_PREFIX_LEN >= 2U);
+#if IS_ENABLED(CONFIG_PHANTOMCHANNEL_PERIPHERAL_TX)
+BUILD_ASSERT(PHANTOM_COVERT_LEN >= 1U);
+BUILD_ASSERT(PHANTOM_COVERT_LEN <= PHANTOM_MAX_COVERT_LEN);
+BUILD_ASSERT(PHANTOM_NOTIFY_LEN <= 248U);
+#endif
+
+static const struct bt_data ad[] = {
+	BT_DATA_BYTES(BT_DATA_FLAGS, BT_LE_AD_GENERAL | BT_LE_AD_NO_BREDR),
+	BT_DATA_BYTES(BT_DATA_UUID16_ALL, BT_UUID_16_ENCODE(BT_UUID_HRS_VAL)),
+};
+
+static const struct bt_data sd[] = {
+	BT_DATA(BT_DATA_NAME_COMPLETE, CONFIG_BT_DEVICE_NAME,
+		sizeof(CONFIG_BT_DEVICE_NAME) - 1U),
+};
+
+static struct bt_conn *current_conn;
+static bool notify_enabled;
+static uint16_t phantom_seq;
+static uint8_t identity_id = BT_ID_DEFAULT;
+static struct k_work_delayable notify_work;
+static struct k_work_delayable advertising_work;
+K_MUTEX_DEFINE(conn_mutex);
+
+static uint8_t hrs_value[PHANTOM_NOTIFY_LEN];
+#if IS_ENABLED(CONFIG_PHANTOMCHANNEL_PERIPHERAL_TX)
+static uint8_t covert_payload[PHANTOM_COVERT_LEN];
+static uint8_t covert_frame[PHANTOM_FRAME_LEN];
+#endif
+static uint32_t notify_attempts;
+static uint32_t notify_ok;
+static uint32_t notify_errors;
+static int last_notify_error;
+
+static void ccc_changed(const struct bt_gatt_attr *attr, uint16_t value);
+
+BT_GATT_SERVICE_DEFINE(hrs_service,
+	BT_GATT_PRIMARY_SERVICE(BT_UUID_HRS),
+	BT_GATT_CHARACTERISTIC(BT_UUID_HRS_MEASUREMENT, BT_GATT_CHRC_NOTIFY,
+			       BT_GATT_PERM_NONE, NULL, NULL, NULL),
+	BT_GATT_CCC(ccc_changed, BT_GATT_PERM_READ | BT_GATT_PERM_WRITE),
+);
+
+#if IS_ENABLED(CONFIG_PHANTOMCHANNEL_PERIPHERAL_TX)
+static void fill_covert_payload(void)
+{
+	covert_payload[0] = PHANTOM_COVERT_MARKER_BYTE;
+	for (size_t i = 1U; i < sizeof(covert_payload); i++) {
+		covert_payload[i] = (uint8_t)(((i - 1U) % 255U) + 1U);
+	}
+}
+
+static void build_covert_frame(uint16_t seq)
+{
+	uint8_t check = 0U;
+
+	covert_frame[0] = 0x50;
+	covert_frame[1] = 0x43;
+	sys_put_le16(seq, &covert_frame[2]);
+	covert_frame[4] = (uint8_t)sizeof(covert_payload);
+	memcpy(&covert_frame[5], covert_payload, sizeof(covert_payload));
+
+	for (size_t i = 0U; i < sizeof(covert_frame) - 1U; i++) {
+		check ^= covert_frame[i];
+	}
+	covert_frame[sizeof(covert_frame) - 1U] = check;
+}
+#endif
+
+static void build_hrs_value(uint16_t seq)
+{
+	memset(hrs_value, 0, sizeof(hrs_value));
+	/* HRS flags: 8-bit heart rate, sensor contact supported and detected. */
+	hrs_value[0] = 0x06U;
+	/* Make the value visibly change in nRF Connect while staying in a
+	 * physiological-looking bench range. */
+	hrs_value[1] = (uint8_t)(60U + (seq % 41U));
+	for (size_t i = 2U; i < PHANTOM_NORMAL_PREFIX_LEN; i++) {
+		hrs_value[i] = 0U;
+	}
+#if IS_ENABLED(CONFIG_PHANTOMCHANNEL_PERIPHERAL_TX)
+	hrs_value[PHANTOM_NORMAL_PREFIX_LEN + 0U] = 0xaaU;
+	hrs_value[PHANTOM_NORMAL_PREFIX_LEN + 1U] = 0xaaU;
+	hrs_value[PHANTOM_NORMAL_PREFIX_LEN + 2U] = 0x00U;
+	memcpy(&hrs_value[PHANTOM_NORMAL_PREFIX_LEN + PHANTOM_MARKER_LEN],
+	       covert_frame, sizeof(covert_frame));
+#endif
+}
+
+static void log_tx(uint16_t seq, int err)
+{
+	printk("HRS_TX {\"seq\":%u,\"bpm\":%u,\"status\":%d,"
+	       "\"attempts\":%u,\"ok\":%u,\"errors\":%u,"
+	       "\"last_error\":%d,\"timestamp_us\":%lld}\n",
+	       seq, hrs_value[1], err, notify_attempts, notify_ok,
+	       notify_errors, last_notify_error, k_uptime_get() * 1000LL);
+}
+
+static void schedule_notification(void)
+{
+	k_work_reschedule(&notify_work,
+			  K_MSEC(CONFIG_PHANTOMCHANNEL_NOTIFY_INTERVAL_MS));
+}
+
+static void notify_handler(struct k_work *work)
+{
+	struct bt_conn *conn = NULL;
+	uint16_t seq;
+	int err;
+
+	ARG_UNUSED(work);
+
+	k_mutex_lock(&conn_mutex, K_FOREVER);
+	if (current_conn != NULL) {
+		conn = bt_conn_ref(current_conn);
+	}
+	k_mutex_unlock(&conn_mutex);
+
+	if (conn == NULL || !notify_enabled) {
+		if (conn != NULL) {
+			bt_conn_unref(conn);
+		}
+		return;
+	}
+
+	seq = phantom_seq++;
+#if IS_ENABLED(CONFIG_PHANTOMCHANNEL_PERIPHERAL_TX)
+	fill_covert_payload();
+	build_covert_frame(seq);
+#endif
+	build_hrs_value(seq);
+	notify_attempts++;
+	err = bt_gatt_notify(conn, &hrs_service.attrs[2], hrs_value,
+			     sizeof(hrs_value));
+	if (err == 0) {
+		notify_ok++;
+	} else {
+		notify_errors++;
+		last_notify_error = err;
+	}
+	log_tx(seq, err);
+
+	bt_conn_unref(conn);
+	schedule_notification();
+}
+
+static void ccc_changed(const struct bt_gatt_attr *attr, uint16_t value)
+{
+	ARG_UNUSED(attr);
+
+	notify_enabled = (value == BT_GATT_CCC_NOTIFY);
+	printk("HRS_CCC {\"notify\":%u,\"timestamp_us\":%lld}\n",
+	       notify_enabled ? 1U : 0U, k_uptime_get() * 1000LL);
+	if (notify_enabled) {
+		schedule_notification();
+	} else {
+		k_work_cancel_delayable(&notify_work);
+	}
+}
+
+static int configure_static_identity(void)
+{
+	bt_addr_le_t identity_addr;
+	char addr_str[BT_ADDR_LE_STR_LEN];
+	int id;
+	int err;
+
+	err = bt_addr_le_from_str(CONFIG_PHANTOMCHANNEL_STATIC_ADDRESS, "random",
+				  &identity_addr);
+	if (err != 0) {
+		printk("HRS_IDENTITY_ERROR {\"address\":\"%s\",\"error\":%d}\n",
+		       CONFIG_PHANTOMCHANNEL_STATIC_ADDRESS, err);
+		return err;
+	}
+	if (!BT_ADDR_IS_STATIC(&identity_addr.a)) {
+		return -EINVAL;
+	}
+
+	id = bt_id_create(&identity_addr, NULL);
+	if (id < 0) {
+		return id;
+	}
+	identity_id = (uint8_t)id;
+	bt_addr_le_to_str(&identity_addr, addr_str, sizeof(addr_str));
+	printk("HRS_IDENTITY {\"id\":%d,\"address\":\"%s\"}\n",
+	       id, addr_str);
+	return 0;
+}
+
+static int configure_low_band_channel_map(void)
+{
+	if (!IS_ENABLED(CONFIG_PHANTOMCHANNEL_LOW_BAND_CHAN_MAP)) {
+		printk("HRS_CHAN_MAP {\"enabled\":0}\n");
+		return 0;
+	}
+
+	uint8_t chan_map[5] = { 0xffU, 0xffU, 0x01U, 0x00U, 0x00U };
+	int err = bt_le_set_chan_map(chan_map);
+
+	printk("HRS_CHAN_MAP {\"enabled\":1,\"status\":%d}\n", err);
+	return err;
+}
+
+static int start_advertising(void)
+{
+	struct bt_le_adv_param adv_param = *BT_LE_ADV_CONN_FAST_1;
+	int err;
+
+	adv_param.id = identity_id;
+	err = bt_le_adv_start(&adv_param, ad, ARRAY_SIZE(ad), sd, ARRAY_SIZE(sd));
+	printk("HRS_ADV_START {\"status\":%d,\"timestamp_us\":%lld}\n",
+	       err, k_uptime_get() * 1000LL);
+	return err;
+}
+
+static void advertising_handler(struct k_work *work)
+{
+	int err;
+
+	ARG_UNUSED(work);
+	err = start_advertising();
+	if (err == -ENOMEM || err == -EAGAIN) {
+		k_work_reschedule(&advertising_work, K_MSEC(100));
+	}
+}
+
+static void connected(struct bt_conn *conn, uint8_t err)
+{
+	struct bt_le_conn_param fast_param =
+		BT_LE_CONN_PARAM_INIT(BT_GAP_US_TO_CONN_INTERVAL(20000),
+				      BT_GAP_US_TO_CONN_INTERVAL(20000), 0,
+				      BT_GAP_MS_TO_CONN_TIMEOUT(4000));
+	char addr[BT_ADDR_LE_STR_LEN];
+
+	bt_addr_le_to_str(bt_conn_get_dst(conn), addr, sizeof(addr));
+	if (err != 0U) {
+		printk("HRS_CONNECT_FAILED {\"peer\":\"%s\",\"error\":%u}\n",
+		       addr, err);
+		return;
+	}
+
+	k_mutex_lock(&conn_mutex, K_FOREVER);
+	if (current_conn != NULL) {
+		bt_conn_unref(current_conn);
+	}
+	current_conn = bt_conn_ref(conn);
+	k_mutex_unlock(&conn_mutex);
+
+	phantom_seq = 0U;
+	notify_attempts = 0U;
+	notify_ok = 0U;
+	notify_errors = 0U;
+	last_notify_error = 0;
+	printk("HRS_CONNECTED {\"peer\":\"%s\",\"timestamp_us\":%lld}\n",
+	       addr, k_uptime_get() * 1000LL);
+	printk("HRS_CONN_PARAM_REQUEST {\"interval_min_us\":20000,"
+	       "\"interval_max_us\":20000,\"status\":%d}\n",
+	       bt_conn_le_param_update(conn, &fast_param));
+}
+
+static void disconnected(struct bt_conn *conn, uint8_t reason)
+{
+	char addr[BT_ADDR_LE_STR_LEN];
+
+	bt_addr_le_to_str(bt_conn_get_dst(conn), addr, sizeof(addr));
+	printk("HRS_DISCONNECTED {\"peer\":\"%s\",\"reason\":%u}\n",
+	       addr, reason);
+	notify_enabled = false;
+	k_work_cancel_delayable(&notify_work);
+
+	k_mutex_lock(&conn_mutex, K_FOREVER);
+	if (current_conn != NULL) {
+		bt_conn_unref(current_conn);
+		current_conn = NULL;
+	}
+	k_mutex_unlock(&conn_mutex);
+	k_work_reschedule(&advertising_work, K_MSEC(100));
+}
+
+BT_CONN_CB_DEFINE(conn_callbacks) = {
+	.connected = connected,
+	.disconnected = disconnected,
+};
+
+int main(void)
+{
+	int err;
+
+	k_work_init_delayable(&notify_work, notify_handler);
+	k_work_init_delayable(&advertising_work, advertising_handler);
+
+	err = bt_enable(NULL);
+	printk("HRS_BOOT {\"bt_enable\":%d,\"device\":\"%s\","
+	       "\"service\":\"180d\",\"measurement\":\"2a37\","
+	       "\"covert_len\":%u,\"normal_prefix_len\":%u,"
+	       "\"notify_interval_ms\":%u}\n",
+	       err, CONFIG_BT_DEVICE_NAME, PHANTOM_COVERT_LEN_VALUE,
+	       (unsigned int)PHANTOM_NORMAL_PREFIX_LEN,
+	       (unsigned int)CONFIG_PHANTOMCHANNEL_NOTIFY_INTERVAL_MS);
+	if (err != 0) {
+		return 0;
+	}
+
+	(void)configure_low_band_channel_map();
+	if (configure_static_identity() != 0) {
+		return 0;
+	}
+	(void)start_advertising();
+
+	while (true) {
+		k_sleep(K_SECONDS(1));
+	}
+
+	return 0;
+}
