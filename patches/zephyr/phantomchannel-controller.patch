diff --git a/samples/bluetooth/phantomchannel_pip_cis_hrs_central_52833/src/main.c b/samples/bluetooth/phantomchannel_pip_cis_hrs_central_52833/src/main.c
new file mode 100644
index 00000000000..25ed653c420
--- /dev/null
+++ b/samples/bluetooth/phantomchannel_pip_cis_hrs_central_52833/src/main.c
@@ -0,0 +1,508 @@
+/*
+ * HRS subscriber for the isolated PhantomChannel PIP peripheral.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <zephyr/bluetooth/addr.h>
+#include <zephyr/bluetooth/bluetooth.h>
+#include <zephyr/bluetooth/conn.h>
+#include <zephyr/bluetooth/gap.h>
+#include <zephyr/bluetooth/gatt.h>
+#include <zephyr/bluetooth/hci.h>
+#include <zephyr/bluetooth/iso.h>
+#include <zephyr/bluetooth/uuid.h>
+#include <zephyr/kernel.h>
+#include <zephyr/sys/printk.h>
+
+static struct bt_conn *default_conn;
+static struct bt_uuid_16 discover_uuid = BT_UUID_INIT_16(0);
+static struct bt_gatt_discover_params discover_params;
+static struct bt_gatt_subscribe_params subscribe_params;
+static bt_addr_le_t target_address;
+static bool target_valid;
+static bool subscribed;
+static struct k_work_delayable stats_work;
+static K_MUTEX_DEFINE(state_mutex);
+
+static uint32_t notification_count;
+static uint32_t valid_count;
+static uint32_t malformed_count;
+static uint32_t bpm_gap_count;
+static uint32_t previous_count;
+static uint8_t last_bpm;
+static bool have_bpm;
+
+#if defined(CONFIG_PHANTOMCHANNEL_CIS_ENABLE) && CONFIG_PHANTOMCHANNEL_CIS_ENABLE
+static struct k_work_delayable cis_send_work;
+static struct bt_iso_chan cis_chan;
+static struct bt_iso_cig *cis_cig;
+static uint16_t cis_seq_num;
+static uint32_t cis_tx_count;
+static uint32_t cis_tx_errors;
+
+NET_BUF_POOL_FIXED_DEFINE(cis_tx_pool, 1,
+			  BT_ISO_SDU_BUF_SIZE(CONFIG_BT_ISO_TX_MTU),
+			  CONFIG_BT_CONN_TX_USER_DATA_SIZE, NULL);
+
+static void cis_timer_timeout(struct k_work *work)
+{
+	static uint8_t data[CONFIG_PHANTOMCHANNEL_CIS_TX_MTU];
+	static bool initialized;
+	static size_t len_to_send = 1U;
+	struct net_buf *buf;
+	int err;
+
+	ARG_UNUSED(work);
+	if (!initialized) {
+		for (size_t index = 0U; index < ARRAY_SIZE(data); index++) {
+			data[index] = (uint8_t)index;
+		}
+		initialized = true;
+	}
+
+	buf = net_buf_alloc(&cis_tx_pool, K_NO_WAIT);
+	if (buf == NULL) {
+		cis_tx_errors++;
+		printk("CIS_TX_ERROR {\"reason\":\"buffer\",\"errors\":%u}\n",
+		       cis_tx_errors);
+		goto schedule;
+	}
+
+	net_buf_reserve(buf, BT_ISO_CHAN_SEND_RESERVE);
+	net_buf_add_mem(buf, data, len_to_send);
+	err = bt_iso_chan_send(&cis_chan, buf, cis_seq_num);
+	if (err != 0) {
+		cis_tx_errors++;
+		net_buf_unref(buf);
+	}
+	cis_tx_count++;
+	printk("CIS_TX {\"seq\":%u,\"len\":%u,\"status\":%d,"
+	       "\"count\":%u,\"errors\":%u}\n",
+	       cis_seq_num, (unsigned int)len_to_send, err, cis_tx_count,
+	       cis_tx_errors);
+	cis_seq_num++;
+	len_to_send++;
+	if (len_to_send > ARRAY_SIZE(data)) {
+		len_to_send = 1U;
+	}
+
+schedule:
+	(void)k_work_schedule(&cis_send_work,
+			      K_USEC(CONFIG_PHANTOMCHANNEL_CIS_SDU_INTERVAL_US));
+}
+
+static void cis_connected(struct bt_iso_chan *chan)
+{
+	ARG_UNUSED(chan);
+	cis_seq_num = 0U;
+	cis_tx_count = 0U;
+	cis_tx_errors = 0U;
+	printk("CIS_CONNECTED {\"role\":\"central\",\"sdu_interval_us\":%u,"
+	       "\"mtu\":%u}\n",
+	       (unsigned int)CONFIG_PHANTOMCHANNEL_CIS_SDU_INTERVAL_US,
+	       (unsigned int)CONFIG_PHANTOMCHANNEL_CIS_TX_MTU);
+	(void)k_work_schedule(&cis_send_work, K_NO_WAIT);
+}
+
+static void cis_disconnected(struct bt_iso_chan *chan, uint8_t reason)
+{
+	ARG_UNUSED(chan);
+	(void)k_work_cancel_delayable(&cis_send_work);
+	printk("CIS_DISCONNECTED {\"reason\":%u,\"tx_count\":%u,"
+	       "\"errors\":%u}\n", reason, cis_tx_count, cis_tx_errors);
+}
+
+static struct bt_iso_chan_ops cis_ops = {
+	.connected = cis_connected,
+	.disconnected = cis_disconnected,
+};
+
+static struct bt_iso_chan_io_qos cis_tx_qos = {
+	.sdu = CONFIG_PHANTOMCHANNEL_CIS_TX_MTU,
+	.phy = BT_GAP_LE_PHY_2M,
+	.rtn = 1U,
+	.path = NULL,
+};
+
+static struct bt_iso_chan_qos cis_qos = {
+	.tx = &cis_tx_qos,
+	.rx = NULL,
+};
+
+static int cis_create(void)
+{
+	struct bt_iso_chan *channels[1] = { &cis_chan };
+	struct bt_iso_cig_param param = { 0 };
+
+	param.cis_channels = channels;
+	param.num_cis = ARRAY_SIZE(channels);
+	param.sca = BT_GAP_SCA_UNKNOWN;
+	param.packing = 0U;
+	param.framing = 0U;
+	param.c_to_p_latency = 10U;
+	param.p_to_c_latency = 10U;
+	param.c_to_p_interval = CONFIG_PHANTOMCHANNEL_CIS_SDU_INTERVAL_US;
+	param.p_to_c_interval = CONFIG_PHANTOMCHANNEL_CIS_SDU_INTERVAL_US;
+
+	return bt_iso_cig_create(&param, &cis_cig);
+}
+
+static int cis_connect(struct bt_conn *conn)
+{
+	struct bt_iso_connect_param param = {
+		.acl = conn,
+		.iso_chan = &cis_chan,
+	};
+	int err = bt_iso_chan_connect(&param, 1U);
+
+	printk("CIS_CONNECT_REQUEST {\"status\":%d}\n", err);
+	return err;
+}
+#endif
+
+static void start_discovery(struct bt_conn *conn);
+
+static uint8_t hrs_notify_func(struct bt_conn *conn,
+				       struct bt_gatt_subscribe_params *params,
+				       const void *data, uint16_t length)
+{
+	uint8_t flags = 0U;
+	uint8_t bpm = 0U;
+	bool valid = false;
+	bool gap = false;
+
+	ARG_UNUSED(conn);
+	if (data == NULL) {
+		printk("HRS_UNSUBSCRIBED\n");
+		subscribed = false;
+		params->value_handle = 0U;
+		return BT_GATT_ITER_STOP;
+	}
+
+	if (length != 2U) {
+		goto record;
+	}
+	flags = ((const uint8_t *)data)[0];
+	bpm = ((const uint8_t *)data)[1];
+	valid = flags == 0x06U && bpm >= 40U && bpm <= 220U;
+
+record:
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	notification_count++;
+	if (valid) {
+		valid_count++;
+		if (have_bpm) {
+			uint8_t expected = last_bpm == 100U ? 60U :
+				(last_bpm == 220U ? 40U : (uint8_t)(last_bpm + 1U));
+			gap = bpm != expected;
+			if (gap) {
+				bpm_gap_count++;
+			}
+		}
+		last_bpm = bpm;
+		have_bpm = true;
+	} else {
+		malformed_count++;
+	}
+	k_mutex_unlock(&state_mutex);
+
+	printk("HRS_NOTIFY {\"flags\":%u,\"bpm\":%u,\"len\":%u,"
+	       "\"valid\":%u,\"bpm_gap\":%u,\"timestamp_us\":%lld}\n",
+	       flags, bpm, length, valid ? 1U : 0U, gap ? 1U : 0U,
+	       k_uptime_get() * 1000LL);
+	return BT_GATT_ITER_CONTINUE;
+}
+
+static void stats_work_handler(struct k_work *work)
+{
+	uint32_t count;
+	uint32_t valid;
+	uint32_t malformed;
+	uint32_t gaps;
+	uint8_t bpm;
+
+	ARG_UNUSED(work);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	count = notification_count;
+	valid = valid_count;
+	malformed = malformed_count;
+	gaps = bpm_gap_count;
+	bpm = last_bpm;
+	k_mutex_unlock(&state_mutex);
+	printk("HRS_CENTRAL_STATS {\"connected\":%u,\"subscribed\":%u,"
+	       "\"notifications\":%u,\"delta\":%u,\"valid\":%u,"
+	       "\"malformed\":%u,\"bpm_gaps\":%u,\"last_bpm\":%u}\n",
+	       default_conn != NULL ? 1U : 0U, subscribed ? 1U : 0U,
+	       count, count - previous_count, valid, malformed, gaps, bpm);
+	previous_count = count;
+	(void)k_work_reschedule(&stats_work,
+				K_MSEC(CONFIG_PHANTOMCHANNEL_HRS_STATS_INTERVAL_MS));
+}
+
+static uint8_t discover_func(struct bt_conn *conn,
+				     const struct bt_gatt_attr *attr,
+				     struct bt_gatt_discover_params *params)
+{
+	int err;
+
+	if (attr == NULL) {
+		printk("HRS_DISCOVERY_DONE\n");
+		memset(params, 0, sizeof(*params));
+		return BT_GATT_ITER_STOP;
+	}
+
+	{
+		char uuid_text[BT_UUID_STR_LEN];
+		bt_uuid_to_str(attr->uuid, uuid_text, sizeof(uuid_text));
+		printk("HRS_DISCOVERY_ATTR {\"handle\":%u,\"uuid\":\"%s\","
+		       "\"type\":%u}\n", attr->handle, uuid_text,
+		       (unsigned int)params->type);
+	}
+
+	if (!bt_uuid_cmp(params->uuid, BT_UUID_HRS)) {
+		/* Keep the standard Zephyr discovery sequence used by central_hr:
+		 * filter the characteristic declaration by its value UUID. */
+		memcpy(&discover_uuid, BT_UUID_HRS_MEASUREMENT, sizeof(discover_uuid));
+		params->uuid = &discover_uuid.uuid;
+		params->start_handle = attr->handle + 1U;
+		params->type = BT_GATT_DISCOVER_CHARACTERISTIC;
+	} else if (params->type == BT_GATT_DISCOVER_CHARACTERISTIC) {
+		const struct bt_gatt_chrc *chrc = attr->user_data;
+
+		if (chrc != NULL) {
+			char char_uuid[BT_UUID_STR_LEN];
+			bt_uuid_to_str(chrc->uuid, char_uuid, sizeof(char_uuid));
+			printk("HRS_DISCOVERY_CHAR {\"uuid\":\"%s\",\"value_handle\":%u}\n",
+			       char_uuid, chrc->value_handle);
+		}
+
+		if (chrc == NULL || bt_uuid_cmp(chrc->uuid,
+						BT_UUID_HRS_MEASUREMENT) != 0) {
+			return BT_GATT_ITER_CONTINUE;
+		}
+		subscribe_params.value_handle = chrc->value_handle;
+		memcpy(&discover_uuid, BT_UUID_GATT_CCC, sizeof(discover_uuid));
+		params->uuid = &discover_uuid.uuid;
+		params->start_handle = attr->handle + 2U;
+		params->type = BT_GATT_DISCOVER_DESCRIPTOR;
+	} else {
+		subscribe_params.notify = hrs_notify_func;
+		subscribe_params.value = BT_GATT_CCC_NOTIFY;
+		subscribe_params.ccc_handle = attr->handle;
+		err = bt_gatt_subscribe(conn, &subscribe_params);
+		printk("HRS_SUBSCRIBE {\"status\":%d,\"value_handle\":%u,"
+		       "\"ccc_handle\":%u}\n", err,
+		       subscribe_params.value_handle, subscribe_params.ccc_handle);
+		if (err == 0 || err == -EALREADY) {
+			subscribed = true;
+		}
+		return BT_GATT_ITER_STOP;
+	}
+
+	err = bt_gatt_discover(conn, params);
+	if (err != 0) {
+		printk("HRS_DISCOVERY_ERROR {\"status\":%d}\n", err);
+	}
+	return BT_GATT_ITER_STOP;
+}
+
+static int start_scan(void);
+
+static void device_found(const bt_addr_le_t *addr, int8_t rssi, uint8_t type,
+				 struct net_buf_simple *ad)
+{
+	char address_text[BT_ADDR_LE_STR_LEN];
+	int err;
+
+	ARG_UNUSED(ad);
+	if (default_conn != NULL || !target_valid ||
+	    (type != BT_GAP_ADV_TYPE_ADV_IND &&
+	     type != BT_GAP_ADV_TYPE_ADV_DIRECT_IND &&
+	     type != BT_GAP_ADV_TYPE_EXT_ADV) ||
+	    bt_addr_le_cmp(addr, &target_address) != 0) {
+		return;
+	}
+	bt_addr_le_to_str(addr, address_text, sizeof(address_text));
+	printk("HRS_TARGET_FOUND {\"address\":\"%s\",\"rssi\":%d}\n",
+	       address_text, rssi);
+	err = bt_le_scan_stop();
+	if (err != 0) {
+		printk("HRS_SCAN_STOP {\"status\":%d}\n", err);
+		return;
+	}
+	err = bt_conn_le_create(addr, BT_CONN_LE_CREATE_CONN,
+				BT_LE_CONN_PARAM(BT_GAP_US_TO_CONN_INTERVAL(15000),
+						BT_GAP_US_TO_CONN_INTERVAL(15000), 0, 400),
+				&default_conn);
+	printk("HRS_CONNECT_CREATE {\"status\":%d}\n", err);
+	if (err != 0) {
+		default_conn = NULL;
+		(void)start_scan();
+	}
+}
+
+static int start_scan(void)
+{
+	struct bt_le_scan_param params = {
+		.type = BT_LE_SCAN_TYPE_ACTIVE,
+		.options = BT_LE_SCAN_OPT_NONE,
+		.interval = BT_GAP_SCAN_FAST_INTERVAL,
+		.window = BT_GAP_SCAN_FAST_WINDOW,
+	};
+	int err = bt_le_scan_start(&params, device_found);
+
+	printk("HRS_SCAN {\"status\":%d}\n", err);
+	return err;
+}
+
+static void mtu_exchange_cb(struct bt_conn *conn, uint8_t err,
+				    struct bt_gatt_exchange_params *params)
+{
+	ARG_UNUSED(params);
+	printk("HRS_MTU {\"status\":%u,\"mtu\":%u}\n", err,
+	       bt_gatt_get_mtu(conn));
+	if (err == 0U) {
+		start_discovery(conn);
+	}
+}
+
+static struct bt_gatt_exchange_params mtu_exchange_params = {
+	.func = mtu_exchange_cb,
+};
+
+static void start_discovery(struct bt_conn *conn)
+{
+	int err;
+
+	memset(&discover_params, 0, sizeof(discover_params));
+	/* BT_UUID_HRS is a block-scope compound literal.  Discovery is
+	 * asynchronous, so keep a static copy alive until all requests finish. */
+	memcpy(&discover_uuid, BT_UUID_HRS, sizeof(discover_uuid));
+	discover_params.uuid = &discover_uuid.uuid;
+	discover_params.func = discover_func;
+	discover_params.start_handle = BT_ATT_FIRST_ATTRIBUTE_HANDLE;
+	discover_params.end_handle = BT_ATT_LAST_ATTRIBUTE_HANDLE;
+	discover_params.type = BT_GATT_DISCOVER_PRIMARY;
+	err = bt_gatt_discover(conn, &discover_params);
+	printk("HRS_DISCOVERY_START {\"status\":%d,\"mtu\":%u}\n", err,
+	       bt_gatt_get_mtu(conn));
+}
+
+static void connected(struct bt_conn *conn, uint8_t err)
+{
+	struct bt_conn_info info;
+	char peer[BT_ADDR_LE_STR_LEN];
+
+	bt_addr_le_to_str(bt_conn_get_dst(conn), peer, sizeof(peer));
+	if (err != 0U) {
+		printk("HRS_CONNECTED {\"status\":%u,\"peer\":\"%s\"}\n",
+		       err, peer);
+		if (default_conn != NULL) {
+			bt_conn_unref(default_conn);
+			default_conn = NULL;
+		}
+		(void)start_scan();
+		return;
+	}
+	printk("HRS_CONNECTED {\"status\":0,\"peer\":\"%s\","
+	       "\"pairing\":0,\"bonding\":0,\"encryption\":0}\n", peer);
+#if defined(CONFIG_PHANTOMCHANNEL_CIS_ENABLE) && CONFIG_PHANTOMCHANNEL_CIS_ENABLE
+	(void)cis_connect(conn);
+#endif
+	if (bt_conn_get_info(conn, &info) == 0 && info.type == BT_CONN_TYPE_LE) {
+		printk("HRS_PHY {\"tx_phy\":%u,\"rx_phy\":%u,\"interval_ms\":%u}\n",
+		       info.le.phy != NULL ? info.le.phy->tx_phy : 0U,
+		       info.le.phy != NULL ? info.le.phy->rx_phy : 0U,
+		       BT_CONN_INTERVAL_TO_MS(info.le.interval));
+	}
+#if defined(CONFIG_PHANTOMCHANNEL_HRS_REQUEST_2M) && \
+	CONFIG_PHANTOMCHANNEL_HRS_REQUEST_2M
+	printk("HRS_PHY_REQUEST {\"mode\":\"2M\",\"status\":%d}\n",
+	       bt_conn_le_phy_update(conn, BT_CONN_LE_PHY_PARAM_2M));
+#endif
+	err = bt_gatt_exchange_mtu(conn, &mtu_exchange_params);
+	if (err == -EALREADY) {
+		start_discovery(conn);
+	} else if (err != 0) {
+		printk("HRS_MTU {\"status\":%d,\"mtu\":%u}\n", err,
+		       bt_gatt_get_mtu(conn));
+	}
+}
+
+static void disconnected(struct bt_conn *conn, uint8_t reason)
+{
+#if defined(CONFIG_PHANTOMCHANNEL_CIS_ENABLE) && CONFIG_PHANTOMCHANNEL_CIS_ENABLE
+	(void)k_work_cancel_delayable(&cis_send_work);
+#endif
+	printk("HRS_DISCONNECTED {\"reason\":%u,\"timestamp_us\":%lld}\n",
+	       reason, k_uptime_get() * 1000LL);
+	subscribed = false;
+	if (default_conn == conn) {
+		bt_conn_unref(default_conn);
+		default_conn = NULL;
+	}
+	(void)start_scan();
+}
+
+static void phy_updated(struct bt_conn *conn,
+			struct bt_conn_le_phy_info *param)
+{
+	printk("HRS_PHY_UPDATED {\"tx_phy\":%u,\"rx_phy\":%u}\n",
+	       param->tx_phy, param->rx_phy);
+}
+
+BT_CONN_CB_DEFINE(hrs_central_conn_callbacks) = {
+	.connected = connected,
+	.disconnected = disconnected,
+	.le_phy_updated = phy_updated,
+};
+
+int main(void)
+{
+	int err;
+
+	err = bt_addr_le_from_str(CONFIG_PHANTOMCHANNEL_HRS_TARGET_ADDRESS,
+				  "random", &target_address);
+	if (err != 0 || !BT_ADDR_IS_STATIC(&target_address.a)) {
+		printk("HRS_TARGET_ERROR {\"status\":%d}\n",
+		       err != 0 ? err : -EINVAL);
+		return 0;
+	}
+	target_valid = true;
+	err = bt_enable(NULL);
+	printk("HRS_CENTRAL_BOOT {\"bt_enable\":%d,\"target\":\"%s\","
+	       "\"service\":\"180d\",\"measurement\":\"2a37\","
+	       "\"phantom_tx\":0,\"pip_tx\":0,\"encryption\":0,"
+	       "\"bonding\":0}\n", err,
+	       CONFIG_PHANTOMCHANNEL_HRS_TARGET_ADDRESS);
+	if (err != 0) {
+		return 0;
+	}
+#if defined(CONFIG_PHANTOMCHANNEL_CIS_ENABLE) && CONFIG_PHANTOMCHANNEL_CIS_ENABLE
+	cis_chan.ops = &cis_ops;
+	cis_chan.qos = &cis_qos;
+	err = cis_create();
+	printk("CIG_CREATED {\"status\":%d,\"sdu_interval_us\":%u,"
+	       "\"mtu\":%u}\n", err,
+	       (unsigned int)CONFIG_PHANTOMCHANNEL_CIS_SDU_INTERVAL_US,
+	       (unsigned int)CONFIG_PHANTOMCHANNEL_CIS_TX_MTU);
+	if (err != 0) {
+		return 0;
+	}
+	k_work_init_delayable(&cis_send_work, cis_timer_timeout);
+#endif
+	k_work_init_delayable(&stats_work, stats_work_handler);
+	(void)k_work_reschedule(&stats_work,
+				K_MSEC(CONFIG_PHANTOMCHANNEL_HRS_STATS_INTERVAL_MS));
+	(void)start_scan();
+	while (true) {
+		k_sleep(K_SECONDS(1));
+	}
+}
