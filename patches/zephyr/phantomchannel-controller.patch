+		uint8_t crc0 = bit_reverse8((crc_data >> 16) & 0xFF);
+		uint8_t crc1 = bit_reverse8((crc_data >> 8) & 0xFF);
+		uint8_t crc2 = bit_reverse8(crc_data & 0xFF);
+
+		pdu_data_tx_cp->lldata[flag_pos + 0] = crc0;
+		pdu_data_tx_cp->lldata[flag_pos + 1] = crc1;
+		pdu_data_tx_cp->lldata[flag_pos + 2] = crc2;
+
+		if(is_data){
+			memcpy(&pdu_data_tx_cp->lldata[flag_pos + 3],  &pdu_data_tx->lldata[flag_pos+3] , covert_len);
+			#if defined(CONFIG_PHANTOMCHANNEL_PERIPHERAL_TX) || \
+				(defined(CONFIG_PHANTOMCHANNEL_LL_TX_DEBUG) && CONFIG_PHANTOMCHANNEL_LL_TX_DEBUG)
+			if (covert_len >= 6U &&
+			    pdu_data_tx_cp->lldata[flag_pos + 3] == 0x50 &&
+			    pdu_data_tx_cp->lldata[flag_pos + 4] == 0x43) {
+				uint16_t phantom_seq =
+					(uint16_t)pdu_data_tx_cp->lldata[flag_pos + 5] |
+					((uint16_t)pdu_data_tx_cp->lldata[flag_pos + 6] << 8);
+				uint8_t phantom_payload_len =
+					pdu_data_tx_cp->lldata[flag_pos + 7];
+				uint8_t phantom_marker =
+					(phantom_payload_len > 0U) ?
+					pdu_data_tx_cp->lldata[flag_pos + 8] : 0U;
+
+				phantom_ll_tx_log_enqueue(phantom_seq, cur_data_chan_use,
+							  lll->access_addr,
+							  lll->crc_init,
+							  pdu_data_tx_cp->len,
+							  (uint16_t)covert_len,
+							  phantom_payload_len,
+							  phantom_marker);
+			}
+			#endif
+		}else if (is_ctelike)
+		{
+			memcpy(&pdu_data_tx_cp->lldata[flag_pos + 3],  &pdu_data_tx->lldata[flag_pos+3] , covert_len);
+			
+			for(int i = 0; i < 3; i++){
+				crc_buf[2 + crc_buf[1] + i] = pdu_data_tx_cp->lldata[flag_pos + i];
+			}
+
+			data_whitening_lut(crc_buf, 2 + flag_pos + 3, cur_data_chan_use);
+
+			((uint8_t *)&pdu_data_tx_cp[0])[0] = crc_buf[0];
+
+			pdu_data_tx_cp->len = crc_buf[1];
+
+			memcpy(&pdu_data_tx_cp->lldata[0],  &crc_buf[2], flag_pos + 3);
+
+			lll_chan_set_nowhiten(cur_data_chan_use);
+		}
+	
+		radio_crc_disable(0UL);
+		radio_pkt_configure(RADIO_PKT_CONF_LENGTH_8BIT, 254, pkt_flags);
+
+		NRF_RADIO->PCNF1 &= ~(RADIO_PCNF1_MAXLEN_Msk | RADIO_PCNF1_STATLEN_Msk |
+					RADIO_PCNF1_BALEN_Msk | RADIO_PCNF1_ENDIAN_Msk);
+		NRF_RADIO->PCNF1 |=
+			((((uint32_t)(254)) << RADIO_PCNF1_MAXLEN_Pos) & RADIO_PCNF1_MAXLEN_Msk) |
+			(((3 + covert_len) << RADIO_PCNF1_STATLEN_Pos) & RADIO_PCNF1_STATLEN_Msk) |
+			(((3UL) << RADIO_PCNF1_BALEN_Pos) & RADIO_PCNF1_BALEN_Msk) |
+			(((RADIO_PCNF1_ENDIAN_Little) << RADIO_PCNF1_ENDIAN_Pos) & RADIO_PCNF1_ENDIAN_Msk);
