+CONFIG_LOG_BACKEND_UART=n
+CONFIG_LOG_BACKEND_RTT=n
+
+CONFIG_MAIN_STACK_SIZE=4096
+CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=4096
+
+CONFIG_PHANTOMCHANNEL_PIP_PERIPHERAL_TX=y
+CONFIG_PHANTOMCHANNEL_PIP_TIMING=y
+CONFIG_PHANTOMCHANNEL_PIP_FORCE_EVERY_NOTIFY=n
+CONFIG_PHANTOMCHANNEL_PIP_COUNTER_DEBUG=y
+CONFIG_PHANTOMCHANNEL_EMBED_ENABLE=y
+CONFIG_PHANTOMCHANNEL_PERIPHERAL_TX=y
+CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG=y
+CONFIG_PHANTOMCHANNEL_LL_RX_DEBUG=y
+CONFIG_PHANTOMCHANNEL_COVERT_LEN=2
+CONFIG_PHANTOMCHANNEL_COVERT_MARKER_BYTE=165
+CONFIG_PHANTOMCHANNEL_NOTIFY_INTERVAL_MS=1000
+# Strict v3 fixed-length vector: incompatible CSA#1 channels wait with an
+# empty PDU; the marker notification is not permitted to leak as fallback.
+# visible 26 + marker 3 + covert 2 is a 31-byte ATT value.  The LL PDU
+# adds 7 bytes of L2CAP/ATT headers, so pdu->len=38 and H_f.LENGTH=44;
+# this is compatible with channel 4 for an odd first real-AA byte.
+CONFIG_PHANTOMCHANNEL_PIP_VISIBLE_VALUE_LEN=26
+CONFIG_PHANTOMCHANNEL_STATIC_ADDRESS="C0:DE:52:84:00:40"
+CONFIG_PHANTOMCHANNEL_PIP_FORCE_2M=n
