diff --git a/samples/bluetooth/phantomchannel_central_gatt_write/src/main.c b/samples/bluetooth/phantomchannel_central_gatt_write/src/main.c
new file mode 100644
index 00000000000..a25bb2df63f
--- /dev/null
+++ b/samples/bluetooth/phantomchannel_central_gatt_write/src/main.c
@@ -0,0 +1,732 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <zephyr/kernel.h>
+#include <zephyr/sys/byteorder.h>
+#include <zephyr/sys/printk.h>
+#include <zephyr/sys/util.h>
+
+#include <zephyr/bluetooth/bluetooth.h>
+#include <zephyr/bluetooth/conn.h>
+#include <zephyr/bluetooth/gatt.h>
+#include <zephyr/bluetooth/gap.h>
+#include <zephyr/bluetooth/hci.h>
+#include <zephyr/bluetooth/uuid.h>
+
+#define PHANTOM_SERVICE_UUID \
+	BT_UUID_128_ENCODE(0x0000ff00, 0x0000, 0x1000, 0x8000, 0x00805f9b34fb)
+#define PHANTOM_WRITE_UUID \
+	BT_UUID_128_ENCODE(0x0000ff01, 0x0000, 0x1000, 0x8000, 0x00805f9b34fb)
+
+#define PHANTOM_MARKER_LEN 3U
+#define PHANTOM_FRAME_OVERHEAD 6U
+#define PHANTOM_WRITE_PREFIX_LEN 1U
+#define PHANTOM_FRAME_LEN (PHANTOM_FRAME_OVERHEAD + CONFIG_PHANTOMCHANNEL_COVERT_LEN)
+#define PHANTOM_WRITE_VALUE_LEN \
+	(PHANTOM_WRITE_PREFIX_LEN + PHANTOM_MARKER_LEN + PHANTOM_FRAME_LEN)
+
+#define PHANTOM_PC_MAGIC_0 0x50U
+#define PHANTOM_PC_MAGIC_1 0x43U
+#define PHANTOM_PAYLOAD_MARKER 0xA5U
+#define CENTRAL_NEAREST_SCAN_WINDOW_MS 1000U
+#define PHANTOM_DEBUG_CONN_INTERVAL_UNITS CONFIG_PHANTOMCHANNEL_CONN_INTERVAL_UNITS
+
+BUILD_ASSERT(CONFIG_PHANTOMCHANNEL_COVERT_LEN <= 234U,
+	     "central payload must fit in one 251-byte LL PDU");
+BUILD_ASSERT(PHANTOM_WRITE_VALUE_LEN <= 244U,
+	     "GATT write value exceeds the single-PDU budget");
+
+static struct bt_uuid_128 service_uuid = BT_UUID_INIT_128(PHANTOM_SERVICE_UUID);
+static struct bt_uuid_128 write_uuid = BT_UUID_INIT_128(PHANTOM_WRITE_UUID);
+
+static struct bt_conn *default_conn;
+#if defined(CONFIG_PHANTOMCHANNEL_FIXED_TARGET) && CONFIG_PHANTOMCHANNEL_FIXED_TARGET
+static bt_addr_le_t fixed_target_addr;
+#endif
+static uint16_t service_start_handle;
+static uint16_t write_value_handle;
+static uint16_t service_end_handle;
+
+static struct bt_gatt_discover_params service_discover_params;
+static struct bt_gatt_discover_params char_discover_params;
+static struct bt_gatt_exchange_params mtu_exchange_params;
+
+static struct k_work_delayable scan_work;
+static struct k_work_delayable connect_work;
+static struct k_work_delayable tx_work;
+static struct k_work_delayable stats_work;
+static K_MUTEX_DEFINE(state_mutex);
+
+enum central_state {
+	CENTRAL_IDLE,
+	CENTRAL_SCANNING,
+	CENTRAL_CONNECTING,
+	CENTRAL_MTU,
+	CENTRAL_DISCOVERING,
+	CENTRAL_READY,
+	CENTRAL_STOPPING,
+};
+
+static enum central_state state;
+static bt_addr_le_t nearest_addr;
+static int8_t nearest_rssi;
+static bool nearest_valid;
+static uint16_t next_sequence;
+static uint32_t queued_count;
+static uint32_t failed_count;
+static uint32_t enomem_count;
+static uint32_t other_error_count;
+static int last_write_error;
+static uint32_t previous_queued_count;
+static uint32_t previous_failed_count;
+static bool required_phy_ready;
+
+static uint8_t write_value[PHANTOM_WRITE_VALUE_LEN];
+
+static void schedule_scan(k_timeout_t delay);
+static void disconnect_current(void);
+static uint8_t discover_func(struct bt_conn *conn, const struct bt_gatt_attr *attr,
+			     struct bt_gatt_discover_params *params);
+
+static void set_state(enum central_state new_state)
+{
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	state = new_state;
+	k_mutex_unlock(&state_mutex);
+}
+
+static enum central_state get_state(void)
+{
+	enum central_state current;
+
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	current = state;
+	k_mutex_unlock(&state_mutex);
+
+	return current;
+}
+
+static bool is_current_connection(struct bt_conn *conn)
+{
+	bool current;
+
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	current = conn != NULL && conn == default_conn;
+	k_mutex_unlock(&state_mutex);
+	return current;
+}
+
+#if (defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M) || \
+	(defined(CONFIG_PHANTOMCHANNEL_FORCE_1M) && CONFIG_PHANTOMCHANNEL_FORCE_1M)
+static bool connection_is_required_phy(struct bt_conn *conn)
+{
+	struct bt_conn_info info;
+
+	if (bt_conn_get_info(conn, &info) != 0 || info.type != BT_CONN_TYPE_LE ||
+	    info.le.phy == NULL) {
+		return false;
+	}
+
+#if defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M
+	return info.le.phy->tx_phy == BT_GAP_LE_PHY_2M &&
+	       info.le.phy->rx_phy == BT_GAP_LE_PHY_2M;
+#else
+	return info.le.phy->tx_phy == BT_GAP_LE_PHY_1M &&
+	       info.le.phy->rx_phy == BT_GAP_LE_PHY_1M;
+#endif
+}
+
+static void maybe_start_tx_after_phy_update(struct bt_conn *conn)
+{
+	if (required_phy_ready && get_state() == CENTRAL_READY && is_current_connection(conn)) {
+		printk("CENTRAL_PHY_REQUIRED_READY mode=%s\n",
+#if defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M
+		       "2M"
+#else
+		       "1M"
+#endif
+		       );
+		(void)k_work_reschedule(&tx_work, K_NO_WAIT);
+	}
+}
+
+#if (defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M) || \
+	(defined(CONFIG_PHANTOMCHANNEL_FORCE_1M) && CONFIG_PHANTOMCHANNEL_FORCE_1M)
+static void request_required_phy(struct bt_conn *conn)
+{
+	#if defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M
+	int err = bt_conn_le_phy_update(conn, BT_CONN_LE_PHY_PARAM_2M);
+
+	printk("CENTRAL_PHY_REQUEST mode=2M err=%d\n", err);
+	#else
+	int err = bt_conn_le_phy_update(conn, BT_CONN_LE_PHY_PARAM_1M);
+
+	printk("CENTRAL_PHY_REQUEST mode=1M err=%d\n", err);
+	#endif
+}
+#endif
+#endif
+
+static void build_write_value(uint16_t sequence)
+{
+	uint8_t *frame = &write_value[PHANTOM_WRITE_PREFIX_LEN + PHANTOM_MARKER_LEN];
+	uint8_t checksum = 0U;
+
+	/* The first byte is a normal application byte before the controller marker. */
+	write_value[0] = 0x01U;
+	write_value[1] = 0xAAU;
+	write_value[2] = 0xAAU;
+	write_value[3] = 0x00U;
+
+	frame[0] = PHANTOM_PC_MAGIC_0;
+	frame[1] = PHANTOM_PC_MAGIC_1;
+	sys_put_le16(sequence, &frame[2]);
+	frame[4] = CONFIG_PHANTOMCHANNEL_COVERT_LEN;
+
+	/* A5 is deliberately part of the covert payload and is counted in rate. */
+	frame[5] = PHANTOM_PAYLOAD_MARKER;
+	for (size_t i = 1U; i < CONFIG_PHANTOMCHANNEL_COVERT_LEN; i++) {
+		/* 1..233 avoids creating a second aa aa 00 marker in the frame. */
+		frame[5U + i] = (uint8_t)(1U + ((sequence + i - 1U) % 233U));
+	}
+
+	for (size_t i = 0U; i < (PHANTOM_FRAME_LEN - 1U); i++) {
+		checksum ^= frame[i];
+	}
+	frame[PHANTOM_FRAME_LEN - 1U] = checksum;
+}
+
+static void device_found(const bt_addr_le_t *addr, int8_t rssi, uint8_t type,
+			 struct net_buf_simple *ad)
+{
+	bool is_better;
+	char addr_str[BT_ADDR_LE_STR_LEN];
+
+	ARG_UNUSED(ad);
+
+	if (get_state() != CENTRAL_SCANNING) {
+		return;
+	}
+
+	/* Use only connectable advertising packets as candidates. Scan responses
+	 * are not independently connectable and may arrive with a different RSSI.
+	 */
+	if (type != BT_GAP_ADV_TYPE_ADV_IND && type != BT_GAP_ADV_TYPE_ADV_DIRECT_IND) {
+		return;
+	}
+
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	is_better = !nearest_valid || rssi > nearest_rssi;
+	if (is_better) {
+		memcpy(&nearest_addr, addr, sizeof(nearest_addr));
+		nearest_rssi = rssi;
+		nearest_valid = true;
+	}
+	k_mutex_unlock(&state_mutex);
+
+	if (is_better) {
+		bt_addr_le_to_str(addr, addr_str, sizeof(addr_str));
+		printk("CENTRAL_NEAREST_CANDIDATE addr=%s rssi=%d\n", addr_str, rssi);
+	}
+}
+
+static int start_scan(void)
+{
+	struct bt_le_scan_param scan_param = {
+		.type = BT_LE_SCAN_TYPE_ACTIVE,
+		.options = BT_LE_SCAN_OPT_NONE,
+		.interval = BT_GAP_SCAN_FAST_INTERVAL,
+		.window = BT_GAP_SCAN_FAST_WINDOW,
+	};
+	int err;
+
+	if (default_conn != NULL) {
+		return -EALREADY;
+	}
+
+#if defined(CONFIG_PHANTOMCHANNEL_FIXED_TARGET) && CONFIG_PHANTOMCHANNEL_FIXED_TARGET
+	if (IS_ENABLED(CONFIG_PHANTOMCHANNEL_FIXED_TARGET)) {
+		char addr_str[BT_ADDR_LE_STR_LEN];
+
+		err = bt_addr_le_from_str(CONFIG_PHANTOMCHANNEL_TARGET_ADDRESS, "random",
+					  &fixed_target_addr);
+		if (err != 0) {
+			printk("CENTRAL_FIXED_TARGET_ADDRESS_ERR=%d address=%s\n", err,
+			       CONFIG_PHANTOMCHANNEL_TARGET_ADDRESS);
+			set_state(CENTRAL_IDLE);
+			return err;
+		}
+
+		bt_addr_le_to_str(&fixed_target_addr, addr_str, sizeof(addr_str));
+		set_state(CENTRAL_CONNECTING);
+		printk("CENTRAL_CONNECT_FIXED addr=%s interval_units=%u timeout_ms=4000\n",
+		       addr_str, PHANTOM_DEBUG_CONN_INTERVAL_UNITS);
+
+		err = bt_conn_le_create(&fixed_target_addr, BT_CONN_LE_CREATE_CONN,
+							BT_LE_CONN_PARAM(PHANTOM_DEBUG_CONN_INTERVAL_UNITS,
+									PHANTOM_DEBUG_CONN_INTERVAL_UNITS, 0,
+									BT_GAP_MS_TO_CONN_TIMEOUT(4000)),
+					&default_conn);
+		if (err != 0) {
+			printk("CENTRAL_FIXED_CREATE_ERR=%d\n", err);
+			default_conn = NULL;
+			set_state(CENTRAL_IDLE);
+			schedule_scan(K_MSEC(250));
+		}
+
+		return err;
+	}
+#endif
+
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	nearest_valid = false;
+	nearest_rssi = INT8_MIN;
+	k_mutex_unlock(&state_mutex);
+	set_state(CENTRAL_SCANNING);
+
+	err = bt_le_scan_start(&scan_param, device_found);
+	if (err == 0) {
+		printk("CENTRAL_SCAN_STARTED mode=nearest_rssi window_ms=%u verify_service=0000ff00-0000-1000-8000-00805f9b34fb\n",
+		       CENTRAL_NEAREST_SCAN_WINDOW_MS);
+		(void)k_work_reschedule(&connect_work, K_MSEC(CENTRAL_NEAREST_SCAN_WINDOW_MS));
+	} else {
+		printk("CENTRAL_SCAN_START_ERR=%d\n", err);
+		set_state(CENTRAL_IDLE);
+	}
+
+	return err;
+}
+
+static void scan_work_fn(struct k_work *work)
+{
+	ARG_UNUSED(work);
+	(void)start_scan();
+}
+
+static void connect_work_fn(struct k_work *work)
+{
+	bt_addr_le_t candidate;
+	int8_t candidate_rssi;
+	bool have_candidate;
+	char addr_str[BT_ADDR_LE_STR_LEN];
+	int err;
+
+	ARG_UNUSED(work);
+
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	have_candidate = nearest_valid && state == CENTRAL_SCANNING;
+	if (have_candidate) {
+		memcpy(&candidate, &nearest_addr, sizeof(candidate));
+		candidate_rssi = nearest_rssi;
+	}
+	k_mutex_unlock(&state_mutex);
+
+	if (!have_candidate) {
+		printk("CENTRAL_NO_CONNECTABLE_DEVICE\n");
+		(void)bt_le_scan_stop();
+		set_state(CENTRAL_IDLE);
+		schedule_scan(K_MSEC(250));
+		return;
+	}
+
+	bt_addr_le_to_str(&candidate, addr_str, sizeof(addr_str));
+	printk("CENTRAL_CONNECT_NEAREST addr=%s rssi=%d\n", addr_str, candidate_rssi);
+	set_state(CENTRAL_CONNECTING);
+
+	err = bt_le_scan_stop();
+	if (err != 0 && err != -EALREADY) {
+		printk("CENTRAL_SCAN_STOP_ERR=%d\n", err);
+		set_state(CENTRAL_IDLE);
+		schedule_scan(K_MSEC(250));
+		return;
+	}
+
+	err = bt_conn_le_create(&candidate, BT_CONN_LE_CREATE_CONN,
+				BT_LE_CONN_PARAM(PHANTOM_DEBUG_CONN_INTERVAL_UNITS,
+							PHANTOM_DEBUG_CONN_INTERVAL_UNITS, 0,
+							BT_GAP_MS_TO_CONN_TIMEOUT(4000)),
+				&default_conn);
+	if (err != 0) {
+		printk("CENTRAL_CREATE_ERR=%d\n", err);
+		default_conn = NULL;
+		set_state(CENTRAL_IDLE);
+		schedule_scan(K_MSEC(250));
+	}
+}
+
+static void schedule_scan(k_timeout_t delay)
+{
+	(void)k_work_reschedule(&scan_work, delay);
+}
+
+static void fail_discovery(const char *stage, int err)
+{
+	printk("CENTRAL_%s_FAIL=%d\n", stage, err);
+	(void)k_work_cancel_delayable(&tx_work);
+	set_state(CENTRAL_STOPPING);
+	disconnect_current();
+}
+
+static void start_characteristic_discovery(struct bt_conn *conn)
+{
+	int err;
+
+	memset(&char_discover_params, 0, sizeof(char_discover_params));
+	char_discover_params.uuid = &write_uuid.uuid;
+	char_discover_params.func = discover_func;
+	char_discover_params.start_handle = service_start_handle + 1U;
+	char_discover_params.end_handle = service_end_handle;
+	char_discover_params.type = BT_GATT_DISCOVER_CHARACTERISTIC;
+
+	err = bt_gatt_discover(conn, &char_discover_params);
+	if (err != 0) {
+		fail_discovery("CHAR_DISCOVER", err);
+	}
+}
+
+static uint8_t discover_func(struct bt_conn *conn, const struct bt_gatt_attr *attr,
+			     struct bt_gatt_discover_params *params)
+{
+	if (!is_current_connection(conn)) {
+		memset(params, 0, sizeof(*params));
+		return BT_GATT_ITER_STOP;
+	}
+
+	if (params == &service_discover_params) {
+		if (attr == NULL) {
+			memset(params, 0, sizeof(*params));
+			fail_discovery("SERVICE_DISCOVER", -ENOENT);
+			return BT_GATT_ITER_STOP;
+		}
+
+		const struct bt_gatt_service_val *service = attr->user_data;
+		if (service == NULL) {
+			fail_discovery("SERVICE_VALUE", -EINVAL);
+			return BT_GATT_ITER_STOP;
+		}
+
+		service_start_handle = attr->handle;
+		service_end_handle = service->end_handle;
+		memset(params, 0, sizeof(*params));
+		start_characteristic_discovery(conn);
+		return BT_GATT_ITER_STOP;
+	}
+
+	if (params == &char_discover_params) {
+		if (attr == NULL) {
+			memset(params, 0, sizeof(*params));
+			fail_discovery("CHAR_DISCOVER", -ENOENT);
+			return BT_GATT_ITER_STOP;
+		}
+
+		const struct bt_gatt_chrc *chrc = attr->user_data;
+		if (chrc == NULL || (chrc->properties & BT_GATT_CHRC_WRITE_WITHOUT_RESP) == 0U) {
+			return BT_GATT_ITER_CONTINUE;
+		}
+
+		write_value_handle = chrc->value_handle;
+		memset(params, 0, sizeof(*params));
+		set_state(CENTRAL_READY);
+		printk("CENTRAL_READY handle=%u mtu=%u value_len=%u interval_ms=%u phy_required=%s\n",
+		       write_value_handle, bt_gatt_get_mtu(conn), PHANTOM_WRITE_VALUE_LEN,
+		       CONFIG_PHANTOMCHANNEL_WRITE_INTERVAL_MS,
+#if defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M
+		       "2M"
+#elif defined(CONFIG_PHANTOMCHANNEL_FORCE_1M) && CONFIG_PHANTOMCHANNEL_FORCE_1M
+		       "1M"
+#else
+		       "none"
+#endif
+		       );
+	#if (defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M) || \
+	(defined(CONFIG_PHANTOMCHANNEL_FORCE_1M) && CONFIG_PHANTOMCHANNEL_FORCE_1M)
+		maybe_start_tx_after_phy_update(conn);
+	#else
+		(void)k_work_reschedule(&tx_work, K_NO_WAIT);
+#endif
+		return BT_GATT_ITER_STOP;
+	}
+
+	return BT_GATT_ITER_STOP;
+}
+
+static void start_service_discovery(struct bt_conn *conn)
+{
+	int err;
+
+	if (!is_current_connection(conn)) {
+		return;
+	}
+
+	if (bt_gatt_get_mtu(conn) < 247U) {
+		fail_discovery("MTU_TOO_SMALL", (int)bt_gatt_get_mtu(conn));
+		return;
+	}
+
+	memset(&service_discover_params, 0, sizeof(service_discover_params));
+	service_discover_params.uuid = &service_uuid.uuid;
+	service_discover_params.func = discover_func;
+	service_discover_params.start_handle = BT_ATT_FIRST_ATTRIBUTE_HANDLE;
+	service_discover_params.end_handle = BT_ATT_LAST_ATTRIBUTE_HANDLE;
+	service_discover_params.type = BT_GATT_DISCOVER_PRIMARY;
+
+	err = bt_gatt_discover(conn, &service_discover_params);
+	if (err != 0) {
+		fail_discovery("SERVICE_DISCOVER", err);
+	} else {
+		set_state(CENTRAL_DISCOVERING);
+		printk("CENTRAL_DISCOVERY_STARTED mtu=%u\n", bt_gatt_get_mtu(conn));
+	}
+}
+
+static void mtu_exchange_cb(struct bt_conn *conn, uint8_t err,
+			    struct bt_gatt_exchange_params *params)
+{
+	ARG_UNUSED(params);
+
+	if (!is_current_connection(conn)) {
+		return;
+	}
+
+	if (err != 0U) {
+		fail_discovery("MTU_EXCHANGE", err);
+		return;
+	}
+
+	printk("CENTRAL_MTU_READY mtu=%u\n", bt_gatt_get_mtu(conn));
+	start_service_discovery(conn);
+}
+
+static void disconnect_current(void)
+{
+	(void)k_work_cancel_delayable(&tx_work);
+	if (default_conn != NULL) {
+		(void)bt_conn_disconnect(default_conn, BT_HCI_ERR_REMOTE_USER_TERM_CONN);
+	}
+}
+
+static void connected(struct bt_conn *conn, uint8_t err)
+{
+	char addr_str[BT_ADDR_LE_STR_LEN];
+
+	if (conn != default_conn) {
+		return;
+	}
+
+	bt_addr_le_to_str(bt_conn_get_dst(conn), addr_str, sizeof(addr_str));
+	if (err != 0U) {
+		printk("CENTRAL_CONNECT_FAIL addr=%s err=%u %s\n", addr_str, err,
+		       bt_hci_err_to_str(err));
+		bt_conn_unref(default_conn);
+		default_conn = NULL;
+		set_state(CENTRAL_IDLE);
+		schedule_scan(K_MSEC(250));
+		return;
+	}
+
+	printk("CENTRAL_CONNECTED addr=%s\n", addr_str);
+#if (defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M) || \
+	(defined(CONFIG_PHANTOMCHANNEL_FORCE_1M) && CONFIG_PHANTOMCHANNEL_FORCE_1M)
+	required_phy_ready = connection_is_required_phy(conn);
+	printk("CENTRAL_PHY_REQUESTED mode=%s current_required=%u\n",
+#if defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M
+	       "2M", required_phy_ready
+#else
+	       "1M", required_phy_ready
+#endif
+	       );
+	#if (defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M) || \
+		(defined(CONFIG_PHANTOMCHANNEL_FORCE_1M) && CONFIG_PHANTOMCHANNEL_FORCE_1M)
+		if (!required_phy_ready) {
+			request_required_phy(conn);
+		}
+#endif
+#endif
+	set_state(CENTRAL_MTU);
+	mtu_exchange_params.func = mtu_exchange_cb;
+	err = bt_gatt_exchange_mtu(conn, &mtu_exchange_params);
+	if (err == -EALREADY) {
+		start_service_discovery(conn);
+	} else if (err != 0) {
+		fail_discovery("MTU_EXCHANGE", err);
+	}
+}
+
+#if defined(CONFIG_BT_USER_PHY_UPDATE)
+static void le_phy_updated(struct bt_conn *conn, struct bt_conn_le_phy_info *param)
+{
+	char addr_str[BT_ADDR_LE_STR_LEN];
+
+	bt_addr_le_to_str(bt_conn_get_dst(conn), addr_str, sizeof(addr_str));
+	printk("CENTRAL_PHY_UPDATED addr=%s tx_phy=%u rx_phy=%u\n",
+	       addr_str, param->tx_phy, param->rx_phy);
+#if (defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M) || \
+	(defined(CONFIG_PHANTOMCHANNEL_FORCE_1M) && CONFIG_PHANTOMCHANNEL_FORCE_1M)
+	required_phy_ready = connection_is_required_phy(conn);
+	if (!required_phy_ready) {
+		printk("CENTRAL_PHY_REQUIRED actual_tx=%u actual_rx=%u\n",
+		       param->tx_phy, param->rx_phy);
+		(void)k_work_cancel_delayable(&tx_work);
+	#if (defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M) || \
+		(defined(CONFIG_PHANTOMCHANNEL_FORCE_1M) && CONFIG_PHANTOMCHANNEL_FORCE_1M)
+		request_required_phy(conn);
+	#endif
+	} else {
+		maybe_start_tx_after_phy_update(conn);
+	}
+#endif
+}
+#endif
+
+static void disconnected(struct bt_conn *conn, uint8_t reason)
+{
+	char addr_str[BT_ADDR_LE_STR_LEN];
+
+	if (conn != default_conn) {
+		return;
+	}
+
+	bt_addr_le_to_str(bt_conn_get_dst(conn), addr_str, sizeof(addr_str));
+	printk("CENTRAL_DISCONNECTED addr=%s reason=0x%02x %s\n", addr_str, reason,
+	       bt_hci_err_to_str(reason));
+
+	set_state(CENTRAL_STOPPING);
+	(void)k_work_cancel_delayable(&tx_work);
+	(void)k_work_cancel_delayable(&connect_work);
+	bt_conn_unref(default_conn);
+	default_conn = NULL;
+	required_phy_ready = false;
+	write_value_handle = 0U;
+	set_state(CENTRAL_IDLE);
+	schedule_scan(K_MSEC(250));
+}
+
+BT_CONN_CB_DEFINE(conn_callbacks) = {
+	.connected = connected,
+	.disconnected = disconnected,
+#if defined(CONFIG_BT_USER_PHY_UPDATE)
+	.le_phy_updated = le_phy_updated,
+#endif
+};
+
+static void tx_work_fn(struct k_work *work)
+{
+	struct bt_conn *conn = NULL;
+	uint16_t handle = 0U;
+	int err;
+	bool still_current;
+
+	ARG_UNUSED(work);
+
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	if (state == CENTRAL_READY && default_conn != NULL) {
+#if (defined(CONFIG_PHANTOMCHANNEL_FORCE_2M) && CONFIG_PHANTOMCHANNEL_FORCE_2M) || \
+	(defined(CONFIG_PHANTOMCHANNEL_FORCE_1M) && CONFIG_PHANTOMCHANNEL_FORCE_1M)
+		if (!required_phy_ready) {
+			k_mutex_unlock(&state_mutex);
+			return;
+		}
+#endif
+		conn = bt_conn_ref(default_conn);
+		handle = write_value_handle;
+	}
+	k_mutex_unlock(&state_mutex);
+
+	if (conn == NULL) {
+		return;
+	}
+
+	build_write_value(next_sequence);
+	err = bt_gatt_write_without_response(conn, handle, write_value,
+					    sizeof(write_value), false);
+	if (err == 0) {
+		queued_count++;
+		next_sequence++;
+	} else {
+		failed_count++;
+		last_write_error = err;
+		if (err == -ENOMEM) {
+			enomem_count++;
+		} else {
+			other_error_count++;
+		}
+	}
+
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	still_current = default_conn == conn && state == CENTRAL_READY;
+	k_mutex_unlock(&state_mutex);
+	bt_conn_unref(conn);
+	if (still_current) {
+		(void)k_work_reschedule(&tx_work,
+					K_MSEC(CONFIG_PHANTOMCHANNEL_WRITE_INTERVAL_MS));
+	}
+}
+
+static void stats_work_fn(struct k_work *work)
+{
+	struct bt_conn *stats_conn = NULL;
+	uint16_t mtu = 0U;
+	uint32_t queued_delta;
+	uint32_t failed_delta;
+
+	ARG_UNUSED(work);
+	queued_delta = queued_count - previous_queued_count;
+	failed_delta = failed_count - previous_failed_count;
+	previous_queued_count = queued_count;
+	previous_failed_count = failed_count;
+
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	if (default_conn != NULL) {
+		stats_conn = bt_conn_ref(default_conn);
+	}
+	k_mutex_unlock(&state_mutex);
+	if (stats_conn != NULL) {
+		mtu = bt_gatt_get_mtu(stats_conn);
+		bt_conn_unref(stats_conn);
+	}
+
+	printk("CENTRAL_STATS state=%u mtu=%u queued=%u(+%u) failed=%u(+%u) enomem=%u other=%u last_err=%d\n",
+	       get_state(), mtu,
+	       queued_count, queued_delta, failed_count, failed_delta, enomem_count,
+	       other_error_count, last_write_error);
+	(void)k_work_reschedule(&stats_work, K_SECONDS(1));
+}
+
+int main(void)
+{
+	int err;
+
+	k_work_init_delayable(&scan_work, scan_work_fn);
+	k_work_init_delayable(&connect_work, connect_work_fn);
+	k_work_init_delayable(&tx_work, tx_work_fn);
+	k_work_init_delayable(&stats_work, stats_work_fn);
+	state = CENTRAL_IDLE;
+
+	err = bt_enable(NULL);
+	if (err != 0) {
+		printk("CENTRAL_BT_ENABLE_ERR=%d\n", err);
+		return 0;
+	}
+
+	printk("CENTRAL_INIT covert_len=%u frame_len=%u write_len=%u interval_ms=%u\n",
+	       CONFIG_PHANTOMCHANNEL_COVERT_LEN, PHANTOM_FRAME_LEN,
+	       PHANTOM_WRITE_VALUE_LEN, CONFIG_PHANTOMCHANNEL_WRITE_INTERVAL_MS);
+
+	(void)k_work_reschedule(&stats_work, K_SECONDS(1));
+	(void)start_scan();
+
+	while (true) {
+		k_sleep(K_SECONDS(1));
+	}
+
+	return 0;
+}
