--- /dev/null
+++ b/samples/bluetooth/phantomchannel_pip_cis_hrs_peripheral/src/main.c
@@ -0,0 +1,531 @@
+/*
+ * Phone-facing PIP Heart Rate Service peripheral for nRF52840.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <zephyr/bluetooth/addr.h>
+#include <zephyr/bluetooth/bluetooth.h>
+#include <zephyr/bluetooth/conn.h>
+#include <zephyr/bluetooth/gatt.h>
+#include <zephyr/bluetooth/hci.h>
+#include <zephyr/bluetooth/iso.h>
+#include <zephyr/bluetooth/uuid.h>
+#include <zephyr/kernel.h>
+#include <zephyr/sys/byteorder.h>
+#include <zephyr/sys/printk.h>
+
+#define PIP_SERVICE_UUID_VAL \
+	BT_UUID_128_ENCODE(0x70630011, 0x5048, 0x414e, 0x544f, 0x4d4348414e4c)
+#define PIP_DATA_UUID_VAL \
+	BT_UUID_128_ENCODE(0x70630012, 0x5048, 0x414e, 0x544f, 0x4d4348414e4c)
+
+#define HRS_VISIBLE_LEN 2U
+#define PIP_MARKER_LEN 3U
+#define PIP_COVERT_LEN CONFIG_PHANTOMCHANNEL_COVERT_LEN
+#define PIP_VALUE_LEN (HRS_VISIBLE_LEN + PIP_MARKER_LEN + PIP_COVERT_LEN)
+#define PIP_MARKER_BYTE ((uint8_t)CONFIG_PHANTOMCHANNEL_COVERT_MARKER_BYTE)
+#define WATCHDOG_TIMEOUT_MS 3000U
+
+BUILD_ASSERT(PIP_COVERT_LEN <= 32U);
+BUILD_ASSERT(PIP_VALUE_LEN <= 244U);
+
+static const struct bt_data ad[] = {
+	BT_DATA_BYTES(BT_DATA_FLAGS, BT_LE_AD_GENERAL | BT_LE_AD_NO_BREDR),
+	BT_DATA_BYTES(BT_DATA_UUID16_ALL, BT_UUID_16_ENCODE(BT_UUID_HRS_VAL)),
+};
+
+static const struct bt_data sd[] = {
+	BT_DATA(BT_DATA_NAME_COMPLETE, CONFIG_BT_DEVICE_NAME,
+		sizeof(CONFIG_BT_DEVICE_NAME) - 1U),
+};
+
+static struct bt_uuid_128 pip_service_uuid = BT_UUID_INIT_128(PIP_SERVICE_UUID_VAL);
+static struct bt_uuid_128 pip_data_uuid = BT_UUID_INIT_128(PIP_DATA_UUID_VAL);
+static struct bt_conn *current_conn;
+static uint8_t identity_id = BT_ID_DEFAULT;
+static bool notify_enabled;
+static bool phy_2m;
+static bool phy_settled;
+static uint16_t sequence;
+static uint16_t pending_sequence;
+static uint16_t pending_retry_count;
+static bool pending_notification;
+static uint8_t pending_stage;
+static int64_t last_progress_ms;
+static int64_t last_cycle_start_ms;
+static struct k_work_delayable notify_work;
+static struct k_work_delayable advertising_work;
+static struct k_work_delayable watchdog_work;
+static void phy_settle_handler(struct k_work *work);
+static K_WORK_DELAYABLE_DEFINE(phy_settle_work, phy_settle_handler);
+static K_MUTEX_DEFINE(state_mutex);
+static uint8_t hrs_value[HRS_VISIBLE_LEN];
+static uint8_t pip_value[PIP_VALUE_LEN];
+
+#if defined(CONFIG_PHANTOMCHANNEL_CIS_ENABLE) && CONFIG_PHANTOMCHANNEL_CIS_ENABLE
+static uint32_t cis_rx_count;
+static uint32_t cis_invalid_count;
+
+static void cis_recv(struct bt_iso_chan *chan,
+		     const struct bt_iso_recv_info *info,
+		     struct net_buf *buf)
+{
+	ARG_UNUSED(chan);
+	if ((info->flags & BT_ISO_FLAGS_VALID) == 0U) {
+		cis_invalid_count++;
+		return;
+	}
+
+	cis_rx_count++;
+	printk("CIS_RX {\"seq\":%u,\"len\":%u,\"flags\":%u,"
+	       "\"count\":%u,\"timestamp_us\":%lld}\n",
+	       info->seq_num, buf->len, info->flags, cis_rx_count,
+	       k_uptime_get() * 1000LL);
+}
+
+static void cis_connected(struct bt_iso_chan *chan)
+{
+	ARG_UNUSED(chan);
+	cis_rx_count = 0U;
+	cis_invalid_count = 0U;
+	printk("CIS_CONNECTED {\"role\":\"peripheral\",\"sdu_interval_us\":%u,"
+	       "\"mtu\":%u}\n",
+	       (unsigned int)CONFIG_PHANTOMCHANNEL_CIS_SDU_INTERVAL_US,
+	       (unsigned int)CONFIG_PHANTOMCHANNEL_CIS_TX_MTU);
+}
+
+static void cis_disconnected(struct bt_iso_chan *chan, uint8_t reason)
+{
+	ARG_UNUSED(chan);
+	printk("CIS_DISCONNECTED {\"reason\":%u,\"rx_count\":%u,"
+	       "\"invalid_count\":%u}\n",
+	       reason, cis_rx_count, cis_invalid_count);
+}
+
+static struct bt_iso_chan_ops cis_ops = {
+	.recv = cis_recv,
+	.connected = cis_connected,
+	.disconnected = cis_disconnected,
+};
+
+static struct bt_iso_chan_io_qos cis_rx_qos = {
+	.sdu = CONFIG_PHANTOMCHANNEL_CIS_TX_MTU,
+	.path = NULL,
+};
+
+static struct bt_iso_chan_qos cis_qos = {
+	.rx = &cis_rx_qos,
+	.tx = NULL,
+};
+
+static struct bt_iso_chan cis_chan = {
+	.ops = &cis_ops,
+	.qos = &cis_qos,
+};
+
+static int cis_accept(const struct bt_iso_accept_info *info,
+		      struct bt_iso_chan **chan)
+{
+	printk("CIS_ACCEPT {\"cig_id\":%u,\"cis_id\":%u}\n",
+	       info->cig_id, info->cis_id);
+	if (cis_chan.iso != NULL) {
+		printk("CIS_ACCEPT_REJECT {\"reason\":\"channel_busy\"}\n");
+		return -ENOMEM;
+	}
+
+	*chan = &cis_chan;
+	return 0;
+}
+
+static struct bt_iso_server cis_server = {
+	.accept = cis_accept,
+};
+#endif
+
+static void ccc_changed(const struct bt_gatt_attr *attr, uint16_t value);
+
+BT_GATT_SERVICE_DEFINE(hrs_service,
+	BT_GATT_PRIMARY_SERVICE(BT_UUID_HRS),
+	BT_GATT_CHARACTERISTIC(BT_UUID_HRS_MEASUREMENT, BT_GATT_CHRC_NOTIFY,
+			       BT_GATT_PERM_NONE, NULL, NULL, NULL),
+	BT_GATT_CCC(ccc_changed, BT_GATT_PERM_READ | BT_GATT_PERM_WRITE),
+);
+
+/* The phone subscribes only to HRS. This separate carrier is consumed by
+ * the controller to create the hidden PIP waveform and is not phone data. */
+BT_GATT_SERVICE_DEFINE(pip_service,
+	BT_GATT_PRIMARY_SERVICE(&pip_service_uuid.uuid),
+	BT_GATT_CHARACTERISTIC(&pip_data_uuid.uuid, BT_GATT_CHRC_NOTIFY,
+			       BT_GATT_PERM_NONE, NULL, NULL, NULL),
+);
+
+static void build_hrs_value(uint16_t seq)
+{
+	memset(hrs_value, 0, sizeof(hrs_value));
+	/* HRS flags: 8-bit heart rate, sensor-contact support and detected. */
+	hrs_value[0] = 0x06U;
+	hrs_value[1] = (uint8_t)(60U + (seq % 41U));
+
+	memcpy(pip_value, hrs_value, HRS_VISIBLE_LEN);
+	/* The marker is never appended to the phone-facing HRS value. */
+	pip_value[HRS_VISIBLE_LEN + 0U] = 0xAAU;
+	pip_value[HRS_VISIBLE_LEN + 1U] = 0xAAU;
+	pip_value[HRS_VISIBLE_LEN + 2U] = 0x02U;
+	for (size_t index = 0U; index < PIP_COVERT_LEN; index++) {
+		pip_value[HRS_VISIBLE_LEN + PIP_MARKER_LEN + index] =
+			(index == 0U) ? PIP_MARKER_BYTE : (uint8_t)(index + seq);
+	}
+}
+
+static void log_tx(uint16_t seq, int hrs_status, int pip_status)
+{
+	printk("HRS_PIP_TX {\"seq\":%u,\"bpm\":%u,\"hrs_status\":%d,"
+	       "\"pip_status\":%d,"
+	       "\"covert_len\":%u,\"timestamp_us\":%lld}\n",
+	       seq, hrs_value[1], hrs_status, pip_status,
+	       (unsigned int)PIP_COVERT_LEN,
+	       k_uptime_get() * 1000LL);
+}
+
+static void schedule_notification(k_timeout_t delay)
+{
+	(void)k_work_reschedule(&notify_work, delay);
+}
+
+/* Track that the notify pipeline made real progress (a cycle started or a
+ * stage/sequence completed).  Retries are intentionally NOT pings: a retry
+ * storm that never completes a sequence is exactly the zombie behavior the
+ * watchdog must recover from. */
+static void watchdog_ping(void)
+{
+	last_progress_ms = k_uptime_get();
+	(void)k_work_reschedule(&watchdog_work, K_MSEC(WATCHDOG_TIMEOUT_MS));
+}
+
+static void watchdog_handler(struct k_work *work)
+{
+	struct bt_conn *conn = NULL;
+	int64_t stalled_ms = 0;
+
+	ARG_UNUSED(work);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	if (current_conn != NULL && notify_enabled && pending_notification) {
+		conn = bt_conn_ref(current_conn);
+		stalled_ms = k_uptime_get() - last_progress_ms;
+	}
+	k_mutex_unlock(&state_mutex);
+
+	if (conn == NULL) {
+		/* Idle between cycles (or not connected): keep watching. */
+		(void)k_work_reschedule(&watchdog_work, K_MSEC(WATCHDOG_TIMEOUT_MS));
+		return;
+	}
+
+	/* A cycle that retries for 3 s without completing a sequence is stale:
+	 * the timestamp is only refreshed at cycle start / stage success /
+	 * completion, so a pure retry loop shows up here as a stall. */
+	if (stalled_ms >= WATCHDOG_TIMEOUT_MS) {
+		printk("HRS_PIP_WATCHDOG {\"seq\":%u,\"pending_seq\":%u,"
+		       "\"stage\":%u,\"retries\":%u,\"stalled_ms\":%lld}\n",
+		       sequence, pending_sequence, pending_stage,
+		       pending_retry_count, stalled_ms);
+		/* Force the zombie link down; disconnected() re-advertises. */
+		(void)bt_conn_disconnect(conn,
+					BT_HCI_ERR_REMOTE_USER_TERM_CONN);
+	} else {
+		/* Progress happened before the deadline expired. */
+		(void)k_work_reschedule(&watchdog_work, K_MSEC(WATCHDOG_TIMEOUT_MS));
+	}
+	bt_conn_unref(conn);
+}
+
+static void notify_handler(struct k_work *work)
+{
+	struct bt_conn *conn = NULL;
+	int err;
+
+	ARG_UNUSED(work);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	if (current_conn != NULL && notify_enabled) {
+		conn = bt_conn_ref(current_conn);
+	}
+	k_mutex_unlock(&state_mutex);
+	if (conn == NULL) {
+		return;
+	}
+	if (!phy_settled) {
+		/* PIP must not start while a PHY update procedure is still in
+		 * flight: the fake TX event-close collides with the update's
+		 * ticker swaps and the connection stops being scheduled.  Wait
+		 * for le_phy_updated (or the settle fallback when no update is
+		 * requested) before the first notification. */
+		bt_conn_unref(conn);
+		schedule_notification(K_MSEC(200));
+		return;
+	}
+
+	if (!pending_notification) {
+		pending_sequence = sequence;
+		pending_retry_count = 0U;
+		build_hrs_value(pending_sequence);
+		pending_notification = true;
+		last_cycle_start_ms = k_uptime_get();
+		watchdog_ping();
+	}
+
+	if (pending_stage == 0U) {
+		err = bt_gatt_notify(conn, &hrs_service.attrs[2], hrs_value,
+				     sizeof(hrs_value));
+		if (err != 0) {
+			bt_conn_unref(conn);
+			pending_retry_count++;
+			if (pending_retry_count == 1U ||
+			    (pending_retry_count % 10U) == 0U) {
+				log_tx(pending_sequence, err, -EINPROGRESS);
+			}
+			schedule_notification(K_MSEC(100));
+			return;
+		}
+		pending_stage = 1U;
+		/* Let the legal HRS notification occupy its own connection events.
+		 * The hidden carrier must be queued after that node has left the
+		 * normal TX head; otherwise PIP release can mistake the visible node
+		 * for the carrier and the next notification stalls the queue. */
+		bt_conn_unref(conn);
+		schedule_notification(K_MSEC(100));
+		return;
+	}
+
+	if (pending_stage == 1U) {
+		/* This notification carries the same BPM, plus the PIP marker and
+		 * covert bytes. It is not the phone-facing HRS characteristic. */
+		err = bt_gatt_notify(conn, &pip_service.attrs[2], pip_value,
+				     sizeof(pip_value));
+		bt_conn_unref(conn);
+		if (err != 0) {
+			pending_retry_count++;
+			if (pending_retry_count == 1U ||
+			    (pending_retry_count % 10U) == 0U) {
+				log_tx(pending_sequence, 0, err);
+			}
+			schedule_notification(K_MSEC(100));
+			return;
+		}
+		pending_stage = 2U;
+	} else {
+		bt_conn_unref(conn);
+	}
+
+	if (pending_stage == 2U) {
+		sequence++;
+		pending_notification = false;
+		pending_stage = 0U;
+		pending_retry_count = 0U;
+		last_cycle_start_ms = 0;
+		log_tx(pending_sequence, 0, 0);
+		watchdog_ping();
+		schedule_notification(K_MSEC(CONFIG_PHANTOMCHANNEL_NOTIFY_INTERVAL_MS));
+	}
+}
+
+static void ccc_changed(const struct bt_gatt_attr *attr, uint16_t value)
+{
+	ARG_UNUSED(attr);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	notify_enabled = value == BT_GATT_CCC_NOTIFY;
+	k_mutex_unlock(&state_mutex);
+	printk("HRS_PIP_CCC {\"enabled\":%u,\"timestamp_us\":%lld}\n",
+	       notify_enabled ? 1U : 0U, k_uptime_get() * 1000LL);
+	if (notify_enabled) {
+		/* Arm the stall watchdog as soon as notifications are enabled,
+		 * even when a PHY update is still in flight (the original
+		 * zombie-link scenario). */
+		watchdog_ping();
+		if (phy_settled) {
+			/* The PHY update already finished (e.g. a 2M peer): start
+			 * notifications without waiting for the settle fallback. */
+			(void)k_work_cancel_delayable(&phy_settle_work);
+			schedule_notification(K_MSEC(500));
+		} else {
+			/* Kick the settle fallback so a peer that never requests a
+			 * PHY update can still start notifications once the link is
+			 * stable. */
+			(void)k_work_reschedule(&phy_settle_work, K_MSEC(3000));
+		}
+	} else {
+		(void)k_work_cancel_delayable(&notify_work);
+		(void)k_work_cancel_delayable(&phy_settle_work);
+	}
+}
+
+static void phy_settle_handler(struct k_work *work)
+{
+	ARG_UNUSED(work);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	phy_settled = true;
+	{
+		bool start = notify_enabled;
+		k_mutex_unlock(&state_mutex);
+		if (start) {
+			schedule_notification(K_MSEC(100));
+		}
+	}
+}
+
+static void le_phy_updated(struct bt_conn *conn,
+			   struct bt_conn_le_phy_info *param)
+{
+	bool start;
+
+	ARG_UNUSED(conn);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	phy_2m = (param->tx_phy == BT_GAP_LE_PHY_2M) &&
+		 (param->rx_phy == BT_GAP_LE_PHY_2M);
+	phy_settled = true;
+	start = notify_enabled;
+	k_mutex_unlock(&state_mutex);
+	(void)k_work_cancel_delayable(&phy_settle_work);
+	printk("HRS_PIP_PHY_UPDATED {\"tx_phy\":%u,\"rx_phy\":%u}\n",
+	       param->tx_phy, param->rx_phy);
+	if (start) {
+		schedule_notification(K_MSEC(100));
+	}
+}
+
+static int configure_identity(void)
+{
+	bt_addr_le_t address;
+	char address_text[BT_ADDR_LE_STR_LEN];
+	int err;
+	int id;
+
+	err = bt_addr_le_from_str(CONFIG_PHANTOMCHANNEL_STATIC_ADDRESS, "random",
+				  &address);
+	if (err != 0 || !BT_ADDR_IS_STATIC(&address.a)) {
+		printk("HRS_PIP_IDENTITY_ERROR {\"status\":%d}\n",
+		       err != 0 ? err : -EINVAL);
+		return err != 0 ? err : -EINVAL;
+	}
+	id = bt_id_create(&address, NULL);
+	if (id < 0) {
+		return id;
+	}
+	identity_id = (uint8_t)id;
+	bt_addr_le_to_str(&address, address_text, sizeof(address_text));
+	printk("HRS_PIP_IDENTITY {\"id\":%d,\"address\":\"%s\"}\n",
+	       id, address_text);
+	return 0;
+}
+
+static int start_advertising(void)
+{
+	struct bt_le_adv_param params = *BT_LE_ADV_CONN_FAST_1;
+	int err;
+
+	params.id = identity_id;
+	err = bt_le_adv_start(&params, ad, ARRAY_SIZE(ad), sd, ARRAY_SIZE(sd));
+	printk("HRS_PIP_ADV {\"status\":%d}\n", err);
+	return err;
+}
+
+static void advertising_handler(struct k_work *work)
+{
+	ARG_UNUSED(work);
+	(void)start_advertising();
+}
+
+static void connected(struct bt_conn *conn, uint8_t err)
+{
+	char peer[BT_ADDR_LE_STR_LEN];
+
+	bt_addr_le_to_str(bt_conn_get_dst(conn), peer, sizeof(peer));
+	if (err != 0U) {
+		printk("HRS_PIP_CONNECT_FAILED {\"error\":%u}\n", err);
+		return;
+	}
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	if (current_conn != NULL) {
+		bt_conn_unref(current_conn);
+	}
+	current_conn = bt_conn_ref(conn);
+	notify_enabled = false;
+	phy_2m = false;
+	phy_settled = false;
+	sequence = 0U;
+	pending_notification = false;
+	pending_stage = 0U;
+	pending_retry_count = 0U;
+	last_progress_ms = 0;
+	last_cycle_start_ms = 0;
+	(void)k_work_cancel_delayable(&watchdog_work);
+	k_mutex_unlock(&state_mutex);
+	printk("HRS_PIP_CONNECTED {\"peer\":\"%s\"}\n", peer);
+}
+
+static void disconnected(struct bt_conn *conn, uint8_t reason)
+{
+	ARG_UNUSED(conn);
+	printk("HRS_PIP_DISCONNECTED {\"reason\":%u}\n", reason);
+	(void)k_work_cancel_delayable(&notify_work);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	notify_enabled = false;
+	phy_2m = false;
+	phy_settled = false;
+	if (current_conn != NULL) {
+		bt_conn_unref(current_conn);
+		current_conn = NULL;
+	}
+	pending_notification = false;
+	pending_stage = 0U;
+	pending_retry_count = 0U;
+	last_progress_ms = 0;
+	last_cycle_start_ms = 0;
+	(void)k_work_cancel_delayable(&watchdog_work);
+	(void)k_work_cancel_delayable(&phy_settle_work);
+	k_mutex_unlock(&state_mutex);
+	(void)k_work_reschedule(&advertising_work, K_MSEC(100));
+}
+
+BT_CONN_CB_DEFINE(hrs_pip_conn_callbacks) = {
+	.connected = connected,
+	.disconnected = disconnected,
+	.le_phy_updated = le_phy_updated,
+};
+
+int main(void)
+{
+	int err;
+
+	k_work_init_delayable(&notify_work, notify_handler);
+	k_work_init_delayable(&advertising_work, advertising_handler);
+	k_work_init_delayable(&watchdog_work, watchdog_handler);
+	err = bt_enable(NULL);
+	printk("HRS_PIP_BOOT {\"bt_enable\":%d,\"service\":\"180d\","
+	       "\"measurement\":\"2a37\",\"covert_len\":%u,"
+	       "\"interval_ms\":%u,\"marker\":\"aaaa02\","
+	       "\"carrier\":\"70630012-5048-414e-544f-4d4348414e4c\"}\n",
+	       err, (unsigned int)PIP_COVERT_LEN,
+	       (unsigned int)CONFIG_PHANTOMCHANNEL_NOTIFY_INTERVAL_MS);
+	if (err != 0 || configure_identity() != 0) {
+		return 0;
+	}
+#if defined(CONFIG_PHANTOMCHANNEL_CIS_ENABLE) && CONFIG_PHANTOMCHANNEL_CIS_ENABLE
+	err = bt_iso_server_register(&cis_server);
+	printk("CIS_SERVER_REGISTER {\"status\":%d}\n", err);
+	if (err != 0) {
+		return 0;
+	}
+#endif
+	(void)start_advertising();
+	while (true) {
+		k_sleep(K_SECONDS(1));
+	}
+	return 0;
+}
