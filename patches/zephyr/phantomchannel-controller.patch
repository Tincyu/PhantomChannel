+/* Non-perturbing stall capture: plain memory writes at prepare/ISR/done
+ * points (no printk, no locks).  The ring is dumped once at the prepare
+ * pipeline assert so the state at the stall can be diagnosed. */
+#define PHANTOM_STALL_DEPTH 8U
+#define PHANTOM_STALL_PREP_ENTRY 1U
+#define PHANTOM_STALL_PREP_START 2U
+#define PHANTOM_STALL_RX_ISR 4U
+#define PHANTOM_STALL_TX_ISR 5U
+#define PHANTOM_STALL_DONE 6U
+#define PHANTOM_STALL_PREP_FULL 7U
+
+struct phantom_stall_entry {
+	uint32_t counter;
+	uint32_t phase;
+	uint32_t radio_state;
+	uint32_t radio_shorts;
+	uint32_t radio_events;
+	uint32_t rtc_counter;
+	uint32_t rtc_cc2;
+	uint32_t ppi_chen;
+	uint32_t ticks_start;
+	uint32_t ticks_now;
+	uint32_t nvic_ispr;
+};
+
+static struct phantom_stall_entry phantom_stall[PHANTOM_STALL_DEPTH];
+static uint32_t phantom_stall_idx;
+
+void lll_conn_phantom_stall_record(uint32_t phase, uint32_t ticks_start)
+{
+	struct phantom_stall_entry *e =
+		&phantom_stall[phantom_stall_idx & (PHANTOM_STALL_DEPTH - 1U)];
+
+	e->counter = phantom_stall_idx++;
+	e->phase = phase;
+	e->radio_state = NRF_RADIO->STATE;
+	e->radio_shorts = NRF_RADIO->SHORTS;
+	e->radio_events =
+		(NRF_RADIO->EVENTS_READY ? 1U : 0U) |
+		(NRF_RADIO->EVENTS_RXREADY ? 2U : 0U) |
+		(NRF_RADIO->EVENTS_END ? 4U : 0U) |
+		(NRF_RADIO->EVENTS_DISABLED ? 8U : 0U) |
+		(NRF_RADIO->EVENTS_TXREADY ? 16U : 0U) |
+		(NRF_RADIO->EVENTS_PHYEND ? 32U : 0U);
+	e->rtc_counter = NRF_RTC->COUNTER;
+	e->rtc_cc2 = NRF_RTC->CC[2];
+	e->ppi_chen = NRF_PPI->CHEN;
+	e->ticks_start = ticks_start;
+	e->ticks_now = ticker_ticks_now_get();
+	e->nvic_ispr = NVIC->ISPR[0];
+}
+
+void lll_conn_phantom_stall_dump(uint32_t ready, uint32_t ready_short,
+				 uint32_t curr_param, uint32_t curr_abort)
+{
+	uint32_t i;
+	uint32_t idx = phantom_stall_idx;
+	uint32_t start = idx >= PHANTOM_STALL_DEPTH ?
+			 idx - PHANTOM_STALL_DEPTH : 0U;
+
+	printk("STALL_DUMP idx=%u\n", idx);
+	for (i = start; i < idx; i++) {
+		struct phantom_stall_entry *e =
+			&phantom_stall[i & (PHANTOM_STALL_DEPTH - 1U)];
+
+		printk("  S%u c=%u p=%u radio=%u shorts=%08x ev=%02x "
+		       "rtc=%u cc2=%u ppi=%08x start=%u now=%u nvic=%08x\n",
+		       i - start, e->counter, e->phase, e->radio_state,
+		       e->radio_shorts, e->radio_events, e->rtc_counter,
+		       e->rtc_cc2, e->ppi_chen, e->ticks_start, e->ticks_now,
+		       e->nvic_ispr);
+	}
+	printk("  curr param=%u abort=%u ready=%u ready_short=%u\n",
+	       curr_param, curr_abort, ready, ready_short);
+}
+
+static uint16_t phantom_pdu_time_us(uint16_t octets, uint8_t phy,
+					    uint8_t phy_flags)
+{
+	return PDU_US(octets, 0U, phy, phy_flags);
+}
+
+static uint16_t phantom_pdu_payload_time_us(uint16_t octets, uint8_t phy,
+						    uint8_t phy_flags)
+{
+	uint16_t with_payload = phantom_pdu_time_us(octets, phy, phy_flags);
+	uint16_t without_payload = phantom_pdu_time_us(0U, phy, phy_flags);
+
+	/* Subtract the fixed preamble/access-address/header/CRC airtime. This
+	 * leaves only the airtime of the bytes appended after the standard CRC.
+	 * For an unencoded PHY this is exactly 8 us/octet at 1M and 4 us/octet
+	 * at 2M. The same difference also works for coded PHYs. */
+	return with_payload > without_payload ?
+		with_payload - without_payload : 0U;
+}
+
+void lll_conn_phantom_timing_get(const struct lll_conn *lll,
+					 const struct pdu_data *pdu,
+					 uint16_t base_tifs_us,
+					 struct lll_conn_phantom_timing *timing)
+{
+	uint16_t tail_len;
+	uint16_t tail_airtime;
+	int32_t correction;
+
+	memset(timing, 0, sizeof(*timing));
+	timing->base_tifs_us = base_tifs_us;
+	if (lll == NULL || pdu == NULL) {
+		timing->effective_tifs_us = base_tifs_us;
+		return;
+	}
+
+	timing->original_pdu_len = pdu->len;
+	if (!IS_ENABLED(CONFIG_PHANTOMCHANNEL_CENTRAL_TX) || lll->role != BT_HCI_ROLE_CENTRAL) {
+		timing->effective_tifs_us = base_tifs_us;
+		return;
+	}
+
+	for (uint16_t i = 0U; i + 2U < pdu->len; i++) {
+		if (pdu->lldata[i] == 0xAAU &&
+		    pdu->lldata[i + 1U] == 0xAAU &&
+		    pdu->lldata[i + 2U] == 0x00U) {
+			timing->marker_found = 1U;
+			timing->marker_pos = (uint8_t)i;
+			break;
+		}
+	}
+
+	if (!timing->marker_found ||
+	    ((uint16_t)pdu->len + 2U) <= ((uint16_t)timing->marker_pos + 5U)) {
+		timing->effective_tifs_us = base_tifs_us;
+		return;
+	}
+
+	/* Match the controller's existing post-marker length calculation. The
+	 * value includes the fixed PC frame bytes even when configured covert_len
+	 * is zero.
+	 */
+	tail_len = (uint16_t)pdu->len + 2U - timing->marker_pos - 5U;
+	timing->tail_len = tail_len;
+	timing->static_len = 3U + tail_len;
+	#if defined(CONFIG_PHANTOMCHANNEL_RX_GUARD_US)
+	timing->rx_guard_us = CONFIG_PHANTOMCHANNEL_RX_GUARD_US;
+	#else
+	timing->rx_guard_us = 0U;
+	#endif
+	timing->phy =
+#if defined(CONFIG_BT_CTLR_PHY)
+		lll->phy_tx;
+#else
+		PHY_1M;
+#endif
+	timing->phy_flags =
+#if defined(CONFIG_BT_CTLR_PHY)
+		lll->phy_flags;
+#else
+		PHY_FLAGS_S2;
+#endif
+
+	/* The receiver must open at the standard reply time measured from the
+	 * end of the standard CRC. Therefore subtract the complete post-CRC PC
+	 * frame airtime, not a fixed 6-byte baseline. */
+	tail_airtime = phantom_pdu_payload_time_us(tail_len, timing->phy,
+							 timing->phy_flags);
+	correction = (int32_t)tail_airtime + timing->rx_guard_us;
+	if (correction < 0) {
+		correction = 0;
+	}
+	if (correction > UINT16_MAX) {
+		correction = UINT16_MAX;
+	}
+	timing->correction_us = (uint16_t)correction;
+	if (base_tifs_us > timing->correction_us) {
+		timing->effective_tifs_us = base_tifs_us - timing->correction_us;
+	} else {
+		timing->effective_tifs_us = 1U;
+		timing->clamped = 1U;
+	}
+}
+
+uint16_t lll_conn_phantom_max_tx_time_us(uint8_t phy, uint8_t phy_flags)
+{
+#if defined(CONFIG_PHANTOMCHANNEL_CENTRAL_TX)
+	uint16_t tail_len;
+
+	if (!IS_ENABLED(CONFIG_PHANTOMCHANNEL_CENTRAL_TX)) {
+		return 0U;
+	}
+
+	/* PCNF1 STATLEN is 3 CRC-like bytes plus the controller tail. */
+	tail_len = (uint16_t)CONFIG_PHANTOMCHANNEL_COVERT_LEN +
+			   PHANTOM_PC_FRAME_OVERHEAD;
+	return phantom_pdu_time_us(3U + tail_len, phy, phy_flags);
+#else
+	ARG_UNUSED(phy);
+	ARG_UNUSED(phy_flags);
+	return 0U;
+#endif
+}
+
+#if defined(CONFIG_PHANTOMCHANNEL_TIMING_DEBUG)
+#define PHANTOM_TIMING_LOG_DEPTH 256U
+#define PHANTOM_TIMING_LOG_MASK (PHANTOM_TIMING_LOG_DEPTH - 1U)
+
+enum phantom_timing_log_type {
+	PHANTOM_TIMING_LOG_TX = 1U,
+	PHANTOM_TIMING_LOG_RX = 2U,
+	PHANTOM_TIMING_LOG_HCTO = 3U,
+};
+
+struct phantom_timing_log_entry {
+	uint8_t type;
+	uint8_t role;
+	uint8_t phy;
+	uint8_t phy_flags;
+	uint8_t marker_pos;
+	uint8_t clamped;
+	uint8_t rx_done;
+	uint8_t crc_ok;
+	uint16_t original_pdu_len;
+	uint16_t tail_len;
+	uint16_t static_len;
+	uint16_t correction_us;
+	uint16_t base_tifs_us;
+	uint16_t effective_tifs_us;
+	uint16_t hcto_tifs_us;
+	uint8_t rx_pdu_len;
+	uint32_t end_us;
+	uint32_t hcto_us;
+};
+
+static struct phantom_timing_log_entry phantom_timing_log[PHANTOM_TIMING_LOG_DEPTH];
+static volatile uint16_t phantom_timing_log_head;
+static volatile uint16_t phantom_timing_log_tail;
+static uint32_t phantom_timing_log_drops;
+
+static void phantom_timing_log_work_handler(struct k_work *work);
+static K_WORK_DEFINE(phantom_timing_log_work, phantom_timing_log_work_handler);
+
+static void phantom_timing_log_enqueue(uint8_t type, uint8_t role,
+					       const struct lll_conn_phantom_timing *timing,
+					       uint32_t end_us, uint32_t hcto_us,
+					       uint16_t hcto_tifs_us,
+					       uint8_t rx_done, uint8_t crc_ok,
+					       uint8_t rx_pdu_len)
+{
+	uint16_t head = phantom_timing_log_head;
+	uint16_t next = (head + 1U) & PHANTOM_TIMING_LOG_MASK;
+	struct phantom_timing_log_entry *entry;
+
+	if (next == phantom_timing_log_tail) {
+		phantom_timing_log_drops++;
+		return;
+	}
+
+	entry = &phantom_timing_log[head];
+	entry->type = type;
+	entry->role = role;
+	entry->phy = timing->phy;
+	entry->phy_flags = timing->phy_flags;
+	entry->marker_pos = timing->marker_pos;
+	entry->clamped = timing->clamped;
+	entry->rx_done = rx_done;
+	entry->crc_ok = crc_ok;
+	entry->original_pdu_len = timing->original_pdu_len;
+	entry->tail_len = timing->tail_len;
+	entry->static_len = timing->static_len;
+	entry->correction_us = timing->correction_us;
+	entry->base_tifs_us = timing->base_tifs_us;
+	entry->effective_tifs_us = timing->effective_tifs_us;
+	entry->hcto_tifs_us = hcto_tifs_us;
+	entry->rx_pdu_len = rx_pdu_len;
+	entry->end_us = end_us;
+	entry->hcto_us = hcto_us;
+	phantom_timing_log_head = next;
+	k_work_submit(&phantom_timing_log_work);
+}
+
+static void phantom_timing_log_work_handler(struct k_work *work)
+{
+	ARG_UNUSED(work);
+
+	while (phantom_timing_log_tail != phantom_timing_log_head) {
+		struct phantom_timing_log_entry entry =
+			phantom_timing_log[phantom_timing_log_tail];
+
+		phantom_timing_log_tail =
+			(phantom_timing_log_tail + 1U) & PHANTOM_TIMING_LOG_MASK;
+		if (entry.type == PHANTOM_TIMING_LOG_TX) {
+			printk("PHANTOM_TIMING_TX {\"role\":%u,\"marker_pos\":%u,"
+			       "\"original_pdu_len\":%u,\"tail_len\":%u,"
+			       "\"static_len\":%u,\"phy\":%u,\"phy_flags\":%u,"
+			       "\"end_us\":%u,\"correction_us\":%u,"
+			       "\"base_tifs_us\":%u,\"effective_tifs_us\":%u,"
+			       "\"tifs_clamped\":%u,\"timing_queue_drops\":%u}\n",
+			       entry.role, entry.marker_pos, entry.original_pdu_len,
+			       entry.tail_len, entry.static_len, entry.phy,
+			       entry.phy_flags, entry.end_us, entry.correction_us,
+			       entry.base_tifs_us, entry.effective_tifs_us,
+			       entry.clamped, phantom_timing_log_drops);
+		} else if (entry.type == PHANTOM_TIMING_LOG_RX) {
+			printk("PHANTOM_TIMING_RX {\"role\":%u,\"trx_done\":%u,"
+			       "\"crc_ok\":%u,\"rx_pdu_len\":%u,\"end_us\":%u,"
+			       "\"expected_tifs_us\":%u,\"tifs_clamped\":%u,"
+			       "\"timing_queue_drops\":%u}\n",
+			       entry.role, entry.rx_done, entry.crc_ok, entry.rx_pdu_len,
+			       entry.end_us, entry.effective_tifs_us, entry.clamped,
+			       phantom_timing_log_drops);
+		} else {
+			printk("PHANTOM_TIMING_HCTO {\"role\":%u,\"end_us\":%u,"
+			       "\"hcto_tifs_us\":%u,\"hcto_us\":%u,"
+			       "\"correction_us\":%u}\n",
+			       entry.role, entry.end_us, entry.hcto_tifs_us,
+			       entry.hcto_us, entry.correction_us);
+		}
+	}
+}
+#endif /* CONFIG_PHANTOMCHANNEL_TIMING_DEBUG */
+
+#if defined(CONFIG_PHANTOMCHANNEL_PERIPHERAL_TX) || \
+	(defined(CONFIG_PHANTOMCHANNEL_LL_TX_DEBUG) && CONFIG_PHANTOMCHANNEL_LL_TX_DEBUG)
+static bool phantom_ll_tx_meta_equal(const struct phantom_ll_tx_log_entry *left,
+				     const struct phantom_ll_tx_log_entry *right)
+{
+	for (size_t i = 0U; i < ARRAY_SIZE(left->access_address); i++) {
+		if (left->access_address[i] != right->access_address[i] ||
+		    left->parser_access_address[i] != right->parser_access_address[i]) {
+			return false;
+		}
+	}
+	for (size_t i = 0U; i < ARRAY_SIZE(left->crc_init); i++) {
+		if (left->crc_init[i] != right->crc_init[i]) {
+			return false;
+		}
+	}
+
+	for (size_t i = 0U; i < ARRAY_SIZE(left->fake_access_address); i++) {
+		if (left->fake_access_address[i] != right->fake_access_address[i]) {
+			return false;
+		}
+	}
+
+	return left->mode == right->mode &&
+	       left->phy == right->phy &&
+	       left->normal_pdu_len == right->normal_pdu_len &&
+	       left->flag_pos == right->flag_pos &&
+	       left->real_len == right->real_len &&
+	       left->fake_len == right->fake_len &&
+	       left->real_whiten_len == right->real_whiten_len &&
+	       left->fake_whiten_len == right->fake_whiten_len &&
+	       left->air_extra_len == right->air_extra_len &&
+	       left->covert_len == right->covert_len &&
+	       left->covert_marker == right->covert_marker;
+}
+#endif
