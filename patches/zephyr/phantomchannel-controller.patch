diff --git a/samples/bluetooth/phantomchannel_adv_broadcaster/src/main.c b/samples/bluetooth/phantomchannel_adv_broadcaster/src/main.c
new file mode 100644
index 00000000000..05aa75552c7
--- /dev/null
+++ b/samples/bluetooth/phantomchannel_adv_broadcaster/src/main.c
@@ -0,0 +1,168 @@
+/*
+ * PhantomChannel advertising broadcaster.
+ *
+ * Non-connectable BLE advertising with a PhantomChannel PC frame appended
+ * after the BLE CRC on advertising channel 39 only (controller-side
+ * lll_adv.c post-CRC embedding).  The readable advertising payload keeps
+ * the manufacturer-data marker (aa aa); the controller moves everything
+ * after the marker into the post-CRC tail.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <zephyr/bluetooth/addr.h>
+#include <zephyr/bluetooth/bluetooth.h>
+#include <zephyr/kernel.h>
+#include <zephyr/sys/byteorder.h>
+#include <zephyr/sys/printk.h>
+
+#define PHANTOM_PC_FRAME_OVERHEAD 6U
+#define PHANTOM_ADV_MARKER_LEN 2U
+#define PHANTOM_ADV_PADDING_LEN CONFIG_PHANTOMCHANNEL_ADV_PADDING_LEN
+#define PHANTOM_ADV_PREFIX_LEN (PHANTOM_ADV_PADDING_LEN + 2U) /* padding + marker */
+#define PHANTOM_COVERT_LEN CONFIG_PHANTOMCHANNEL_ADV_COVERT_LEN
+#define PHANTOM_FRAME_LEN (PHANTOM_PC_FRAME_OVERHEAD + PHANTOM_COVERT_LEN)
+#define PHANTOM_ADV_RAW_LEN (PHANTOM_ADV_PREFIX_LEN + PHANTOM_FRAME_LEN)
+
+#if CONFIG_PHANTOMCHANNEL_ADV_BENIGN
+static const struct bt_data *advertising_data;
+#define ADVERTISING_DATA_COUNT 0U
+#else
+BUILD_ASSERT(PHANTOM_ADV_RAW_LEN <= 249U,
+	     "raw advertising data exceeds the 255-byte LL payload minus AdvA");
+
+static uint8_t adv_raw[PHANTOM_ADV_RAW_LEN];
+#endif
+static uint16_t adv_seq;
+static uint8_t identity_id = BT_ID_DEFAULT;
+static struct k_work_delayable adv_work;
+
+#if !CONFIG_PHANTOMCHANNEL_ADV_BENIGN
+static const struct bt_data ad[] = {
+	BT_DATA(BT_DATA_PHANTOM_RAW, adv_raw, PHANTOM_ADV_RAW_LEN),
+};
+#define advertising_data ad
+#define ADVERTISING_DATA_COUNT ARRAY_SIZE(advertising_data)
+#endif
+
+static void build_adv_raw(void)
+{
+#if !CONFIG_PHANTOMCHANNEL_ADV_BENIGN
+	uint8_t *frame = &adv_raw[PHANTOM_ADV_PREFIX_LEN];
+
+	for (size_t i = 0U; i < PHANTOM_ADV_PADDING_LEN; i++) {
+		/* Non-aa pattern so the controller finds the marker only after
+		 * the padding.
+		 */
+		adv_raw[i] = (uint8_t)((0x50U + i) % 256U);
+	}
+	adv_raw[PHANTOM_ADV_PADDING_LEN + 0U] = 0xaa;
+	adv_raw[PHANTOM_ADV_PADDING_LEN + 1U] = 0xaa;
+
+	/* Standard PhantomChannel PC frame: 50 43 | seq_le16 | len | payload | xor */
+	frame[0] = 0x50;
+	frame[1] = 0x43;
+	sys_put_le16(adv_seq, &frame[2]);
+	frame[4] = (uint8_t)PHANTOM_COVERT_LEN;
+	frame[5] = 0xa5;
+	for (size_t i = 1U; i < PHANTOM_COVERT_LEN; i++) {
+		frame[5 + i] = (uint8_t)(((i - 1U) % 255U) + 1U);
+	}
+	uint8_t check = 0U;
+	for (size_t i = 0U; i < PHANTOM_FRAME_LEN - 1U; i++) {
+		check ^= frame[i];
+	}
+	frame[PHANTOM_FRAME_LEN - 1U] = check;
+#endif
+}
+
+static void adv_work_fn(struct k_work *work)
+{
+	ARG_UNUSED(work);
+
+	adv_seq++;
+	build_adv_raw();
+	int err = bt_le_adv_update_data(advertising_data, ADVERTISING_DATA_COUNT, NULL, 0U);
+
+	if (unlikely(err != 0)) {
+		printk("PHANTOM_ADV_UPDATE_ERR {\"seq\":%u,\"err\":%d}\n",
+		       adv_seq, err);
+	}
+	k_work_reschedule(&adv_work,
+			  K_MSEC(CONFIG_PHANTOMCHANNEL_ADV_INTERVAL_MS));
+}
+
+static int configure_static_identity(void)
+{
+	bt_addr_le_t identity_addr;
+	char addr_str[BT_ADDR_LE_STR_LEN];
+	int id;
+	int err;
+
+	err = bt_addr_le_from_str(CONFIG_PHANTOMCHANNEL_ADV_STATIC_ADDRESS,
+				  "random", &identity_addr);
+	if (err != 0) {
+		printk("ADV_IDENTITY_ERROR {\"address\":\"%s\",\"error\":%d}\n",
+		       CONFIG_PHANTOMCHANNEL_ADV_STATIC_ADDRESS, err);
+		return err;
+	}
+	if (!BT_ADDR_IS_STATIC(&identity_addr.a)) {
+		return -EINVAL;
+	}
+
+	id = bt_id_create(&identity_addr, NULL);
+	if (id < 0) {
+		return id;
+	}
+	identity_id = (uint8_t)id;
+	bt_addr_le_to_str(&identity_addr, addr_str, sizeof(addr_str));
+	printk("ADV_IDENTITY {\"id\":%d,\"address\":\"%s\"}\n",
+	       id, addr_str);
+	return 0;
+}
+
+int main(void)
+{
+	int err;
+
+	err = bt_enable(NULL);
+	if (err != 0) {
+		printk("ADV_BOOT {\"bt_enable\":%d}\n", err);
+		return 0;
+	}
+
+	if (configure_static_identity() != 0) {
+		return 0;
+	}
+
+	adv_seq = 0U;
+	build_adv_raw();
+
+	struct bt_le_adv_param param = BT_LE_ADV_PARAM_INIT(
+		BT_LE_ADV_OPT_USE_IDENTITY | BT_LE_ADV_OPT_SCANNABLE,
+		(CONFIG_PHANTOMCHANNEL_ADV_INTERVAL_MS * 1000U) / 625U,
+		(CONFIG_PHANTOMCHANNEL_ADV_INTERVAL_MS * 1000U) / 625U,
+		NULL);
+
+	param.id = identity_id;
+	err = bt_le_adv_start(&param, advertising_data, ADVERTISING_DATA_COUNT, NULL, 0U);
+	printk("ADV_START {\"status\":%d,\"interval_ms\":%u,\"covert_len\":%u}\n",
+	       err, (unsigned int)CONFIG_PHANTOMCHANNEL_ADV_INTERVAL_MS,
+	       (unsigned int)PHANTOM_COVERT_LEN);
+	if (err != 0) {
+		return 0;
+	}
+
+	k_work_init_delayable(&adv_work, adv_work_fn);
+	k_work_reschedule(&adv_work,
+			  K_MSEC(CONFIG_PHANTOMCHANNEL_ADV_INTERVAL_MS));
+
+	while (true) {
+		k_sleep(K_SECONDS(1));
+	}
+	return 0;
+}
