diff --git a/samples/bluetooth/phantomchannel_pip_peripheral/src/main.c b/samples/bluetooth/phantomchannel_pip_peripheral/src/main.c
new file mode 100644
index 00000000000..55de8944cdd
--- /dev/null
+++ b/samples/bluetooth/phantomchannel_pip_peripheral/src/main.c
@@ -0,0 +1,304 @@
+/*
+ * PhantomChannel PIP notification peripheral for nRF52840.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <zephyr/bluetooth/addr.h>
+#include <zephyr/bluetooth/bluetooth.h>
+#include <zephyr/bluetooth/conn.h>
+#include <zephyr/bluetooth/gatt.h>
+#include <zephyr/bluetooth/hci.h>
+#include <zephyr/bluetooth/uuid.h>
+#include <zephyr/kernel.h>
+#include <zephyr/sys/byteorder.h>
+#include <zephyr/sys/printk.h>
+
+#define PIP_SERVICE_UUID_VAL \
+	BT_UUID_128_ENCODE(0x70630001, 0x5048, 0x414e, 0x544f, 0x4d4348414e4c)
+#define PIP_DATA_UUID_VAL \
+	BT_UUID_128_ENCODE(0x70630002, 0x5048, 0x414e, 0x544f, 0x4d4348414e4c)
+
+#define PIP_MARKER_LEN 3U
+#define PIP_VISIBLE_LEN CONFIG_PHANTOMCHANNEL_PIP_VISIBLE_VALUE_LEN
+#define PIP_COVERT_LEN CONFIG_PHANTOMCHANNEL_COVERT_LEN
+#define PIP_NOTIFY_LEN (PIP_VISIBLE_LEN + PIP_MARKER_LEN + PIP_COVERT_LEN)
+#define PIP_COVERT_MARKER ((uint8_t)CONFIG_PHANTOMCHANNEL_COVERT_MARKER_BYTE)
+
+BUILD_ASSERT(PIP_VISIBLE_LEN >= 3U);
+BUILD_ASSERT(PIP_COVERT_LEN <= 32U);
+BUILD_ASSERT(PIP_NOTIFY_LEN <= 244U);
+
+static struct bt_uuid_128 pip_service_uuid = BT_UUID_INIT_128(PIP_SERVICE_UUID_VAL);
+static struct bt_uuid_128 pip_data_uuid = BT_UUID_INIT_128(PIP_DATA_UUID_VAL);
+
+static const struct bt_data ad[] = {
+	BT_DATA_BYTES(BT_DATA_FLAGS, BT_LE_AD_GENERAL | BT_LE_AD_NO_BREDR),
+	BT_DATA_BYTES(BT_DATA_UUID128_ALL, PIP_SERVICE_UUID_VAL),
+};
+
+static const struct bt_data sd[] = {
+	BT_DATA(BT_DATA_NAME_COMPLETE, CONFIG_BT_DEVICE_NAME,
+		sizeof(CONFIG_BT_DEVICE_NAME) - 1U),
+};
+
+static struct bt_conn *current_conn;
+static struct k_work_delayable notify_work;
+static struct k_work_delayable advertising_work;
+static K_MUTEX_DEFINE(state_mutex);
+static bool notify_enabled;
+static uint16_t sequence;
+static uint16_t pending_sequence;
+static uint16_t pending_retry_count;
+static bool pending_notification;
+static uint8_t identity_id = BT_ID_DEFAULT;
+static uint8_t notify_value[PIP_NOTIFY_LEN];
+
+static void ccc_changed(const struct bt_gatt_attr *attr, uint16_t value);
+
+BT_GATT_SERVICE_DEFINE(pip_service,
+	BT_GATT_PRIMARY_SERVICE(&pip_service_uuid),
+	BT_GATT_CHARACTERISTIC(&pip_data_uuid.uuid, BT_GATT_CHRC_NOTIFY,
+			       BT_GATT_PERM_NONE, NULL, NULL, NULL),
+	BT_GATT_CCC(ccc_changed, BT_GATT_PERM_READ | BT_GATT_PERM_WRITE),
+);
+
+static void hex_encode(const uint8_t *data, size_t len, char *out, size_t out_len)
+{
+	static const char digits[] = "0123456789abcdef";
+	size_t pos = 0U;
+
+	for (size_t index = 0U; index < len && pos + 2U < out_len; index++) {
+		out[pos++] = digits[data[index] >> 4];
+		out[pos++] = digits[data[index] & 0x0FU];
+	}
+	if (out_len != 0U) {
+		out[pos] = '\0';
+	}
+}
+
+static void build_notify(uint16_t seq)
+{
+	uint8_t check;
+
+	memset(notify_value, 0, sizeof(notify_value));
+	sys_put_le16(seq, &notify_value[0]);
+	notify_value[2] = (uint8_t)(0xC3U ^ notify_value[0] ^ notify_value[1]);
+	for (size_t index = 3U; index < PIP_VISIBLE_LEN; index++) {
+		notify_value[index] = (uint8_t)(0x30U + ((seq + index) % 0x40U));
+	}
+
+	notify_value[PIP_VISIBLE_LEN + 0U] = 0xAAU;
+	notify_value[PIP_VISIBLE_LEN + 1U] = 0xAAU;
+	notify_value[PIP_VISIBLE_LEN + 2U] = 0x02U;
+	check = (uint8_t)(seq ^ (seq >> 8) ^ PIP_COVERT_MARKER);
+	for (size_t index = 0U; index < PIP_COVERT_LEN; index++) {
+		notify_value[PIP_VISIBLE_LEN + PIP_MARKER_LEN + index] =
+			(index == 0U) ? PIP_COVERT_MARKER : (uint8_t)(check + index);
+	}
+}
+
+static void log_app_tx(uint16_t seq, int status)
+{
+	char visible_hex[(PIP_VISIBLE_LEN * 2U) + 1U];
+	char covert_hex[(PIP_COVERT_LEN * 2U) + 1U];
+
+	hex_encode(notify_value, PIP_VISIBLE_LEN, visible_hex, sizeof(visible_hex));
+	hex_encode(&notify_value[PIP_VISIBLE_LEN + PIP_MARKER_LEN], PIP_COVERT_LEN,
+		   covert_hex, sizeof(covert_hex));
+	printk("PIP_APP_TX {\"session\":0,\"seq\":%u,\"visible_hex\":\"%s\"," 
+	       "\"visible_len\":%u,\"covert_hex\":\"%s\",\"covert_len\":%u,"
+	       "\"flag_mode\":2,\"timestamp_us\":%lld,\"status\":%d}\n",
+	       seq, visible_hex, (unsigned int)PIP_VISIBLE_LEN, covert_hex,
+	       (unsigned int)PIP_COVERT_LEN, k_uptime_get() * 1000LL, status);
+}
+
+static void schedule_notification(k_timeout_t delay)
+{
+	(void)k_work_reschedule(&notify_work, delay);
+}
+
+static void notify_work_handler(struct k_work *work)
+{
+	struct bt_conn *conn = NULL;
+	int err;
+
+	ARG_UNUSED(work);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	if (current_conn != NULL && notify_enabled) {
+		conn = bt_conn_ref(current_conn);
+	}
+	k_mutex_unlock(&state_mutex);
+	if (conn == NULL) {
+		return;
+	}
+
+	/* A notification that cannot enter the controller queue is not a new
+	 * application notification. Keep its sequence and payload intact and
+	 * retry later so a slow fixed-channel PIP service rate cannot turn queue
+	 * pressure into a silent drop or an ever-growing sequence gap. */
+	if (!pending_notification) {
+		pending_sequence = sequence;
+		pending_retry_count = 0U;
+		build_notify(pending_sequence);
+		pending_notification = true;
+	}
+	err = bt_gatt_notify(conn, &pip_service.attrs[2], notify_value,
+			     PIP_VISIBLE_LEN + PIP_MARKER_LEN + PIP_COVERT_LEN);
+	bt_conn_unref(conn);
+	if (err == 0) {
+		sequence++;
+		pending_notification = false;
+		pending_retry_count = 0U;
+		log_app_tx(pending_sequence, err);
+		schedule_notification(K_MSEC(CONFIG_PHANTOMCHANNEL_NOTIFY_INTERVAL_MS));
+	} else {
+		/* Retry the same notification without advancing the application seq. */
+		pending_retry_count++;
+		if (pending_retry_count == 1U ||
+		    (pending_retry_count % 10U) == 0U) {
+			log_app_tx(pending_sequence, err);
+		}
+		schedule_notification(K_MSEC(100));
+	}
+}
+
+static void ccc_changed(const struct bt_gatt_attr *attr, uint16_t value)
+{
+	ARG_UNUSED(attr);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	notify_enabled = value == BT_GATT_CCC_NOTIFY;
+	k_mutex_unlock(&state_mutex);
+	printk("PIP_CCC {\"enabled\":%u,\"timestamp_us\":%lld}\n",
+	       notify_enabled ? 1U : 0U, k_uptime_get() * 1000LL);
+	if (notify_enabled) {
+		/* Leave discovery/CCC setup a quiet half-second before the first TX. */
+		schedule_notification(K_MSEC(500));
+	} else {
+		(void)k_work_cancel_delayable(&notify_work);
+	}
+}
+
+static int configure_identity(void)
+{
+	bt_addr_le_t address;
+	char address_text[BT_ADDR_LE_STR_LEN];
+	int err;
+	int id;
+
+	err = bt_addr_le_from_str(CONFIG_PHANTOMCHANNEL_STATIC_ADDRESS, "random", &address);
+	if (err != 0 || !BT_ADDR_IS_STATIC(&address.a)) {
+		printk("PIP_IDENTITY_ERROR {\"status\":%d}\n", err != 0 ? err : -EINVAL);
+		return err != 0 ? err : -EINVAL;
+	}
+	id = bt_id_create(&address, NULL);
+	if (id < 0) {
+		return id;
+	}
+	identity_id = (uint8_t)id;
+	bt_addr_le_to_str(&address, address_text, sizeof(address_text));
+	printk("PIP_IDENTITY {\"id\":%d,\"address\":\"%s\"}\n", id, address_text);
+	return 0;
+}
+
+static int start_advertising(void)
+{
+	struct bt_le_adv_param params = *BT_LE_ADV_CONN_FAST_1;
+	int err;
+
+	params.id = identity_id;
+	err = bt_le_adv_start(&params, ad, ARRAY_SIZE(ad), sd, ARRAY_SIZE(sd));
+	printk("PIP_ADV {\"status\":%d}\n", err);
+	return err;
+}
+
+static void advertising_work_handler(struct k_work *work)
+{
+	ARG_UNUSED(work);
+	(void)start_advertising();
+}
+
+static void connected(struct bt_conn *conn, uint8_t err)
+{
+	struct bt_conn_info info;
+	char peer[BT_ADDR_LE_STR_LEN];
+
+	bt_addr_le_to_str(bt_conn_get_dst(conn), peer, sizeof(peer));
+	if (err != 0U) {
+		printk("PIP_CONNECT_FAILED {\"error\":%u}\n", err);
+		return;
+	}
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	if (current_conn != NULL) {
+		bt_conn_unref(current_conn);
+	}
+	current_conn = bt_conn_ref(conn);
+	sequence = 0U;
+	pending_retry_count = 0U;
+	pending_notification = false;
+	k_mutex_unlock(&state_mutex);
+	printk("PIP_CONNECTED {\"peer\":\"%s\",\"timestamp_us\":%lld}\n",
+	       peer, k_uptime_get() * 1000LL);
+	if (bt_conn_get_info(conn, &info) == 0 && info.type == BT_CONN_TYPE_LE) {
+		printk("PIP_PHY {\"tx_phy\":%u,\"rx_phy\":%u,\"interval_ms\":%u}\n",
+		       info.le.phy != NULL ? info.le.phy->tx_phy : 0U,
+		       info.le.phy != NULL ? info.le.phy->rx_phy : 0U,
+		       BT_CONN_INTERVAL_TO_MS(info.le.interval));
+	}
+#if defined(CONFIG_PHANTOMCHANNEL_PIP_FORCE_2M) && CONFIG_PHANTOMCHANNEL_PIP_FORCE_2M
+	printk("PIP_PHY_REQUEST {\"mode\":\"2M\",\"status\":%d}\n",
+	       bt_conn_le_phy_update(conn, BT_CONN_LE_PHY_PARAM_2M));
+#endif
+}
+
+static void disconnected(struct bt_conn *conn, uint8_t reason)
+{
+	printk("PIP_DISCONNECTED {\"reason\":%u,\"timestamp_us\":%lld}\n",
+	       reason, k_uptime_get() * 1000LL);
+	(void)k_work_cancel_delayable(&notify_work);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	notify_enabled = false;
+	if (current_conn == conn) {
+		bt_conn_unref(current_conn);
+		current_conn = NULL;
+	}
+	pending_retry_count = 0U;
+	pending_notification = false;
+	k_mutex_unlock(&state_mutex);
+	(void)k_work_reschedule(&advertising_work, K_MSEC(100));
+}
+
+BT_CONN_CB_DEFINE(pip_conn_callbacks) = {
+	.connected = connected,
+	.disconnected = disconnected,
+};
+
+int main(void)
+{
+	int err;
+
+	k_work_init_delayable(&notify_work, notify_work_handler);
+	k_work_init_delayable(&advertising_work, advertising_work_handler);
+	err = bt_enable(NULL);
+	printk("PIP_BOOT {\"bt_enable\":%d,\"covert_len\":%u,\"visible_len\":%u,"
+	       "\"phy\":\"%s\",\"encryption\":0,\"bonding\":0}\n",
+	       err, (unsigned int)PIP_COVERT_LEN, (unsigned int)PIP_VISIBLE_LEN,
+#if defined(CONFIG_PHANTOMCHANNEL_PIP_FORCE_2M) && CONFIG_PHANTOMCHANNEL_PIP_FORCE_2M
+	       "2M"
+#else
+	       "1M"
+#endif
+	);
+	if (err != 0 || configure_identity() != 0) {
+		return 0;
+	}
+	(void)start_advertising();
+	while (true) {
+		k_sleep(K_SECONDS(1));
+	}
+}
