diff --git a/samples/bluetooth/phantomchannel_central_gatt_write/Kconfig b/samples/bluetooth/phantomchannel_central_gatt_write/Kconfig
new file mode 100644
index 00000000000..c80229dd199
--- /dev/null
+++ b/samples/bluetooth/phantomchannel_central_gatt_write/Kconfig
@@ -0,0 +1,126 @@
+# SPDX-License-Identifier: Apache-2.0
+
+mainmenu "Bluetooth: PhantomChannel central GATT write"
+
+menu "PhantomChannel central GATT write sample"
+
+config PHANTOMCHANNEL_CENTRAL_TX
+	bool "Enable central-side PhantomChannel TX embedding"
+	default y
+	depends on BT_CTLR && BT_LL_SW_SPLIT && BT_CENTRAL
+	help
+	  Enable the Nordic LLL post-CRC TX hook for central-role data PDUs.
+	  The application writes a aa aa 00 marker followed by the PC frame.
+
+config PHANTOMCHANNEL_COVERT_LEN
+	int "Covert payload length in bytes"
+	default 234
+	range 0 234
+	depends on PHANTOMCHANNEL_CENTRAL_TX
+	help
+	  Covert payload length. 234 bytes makes the complete write value 244
+	  bytes and fits in one 251-byte Link Layer data PDU.
+
+config PHANTOMCHANNEL_WRITE_INTERVAL_MS
+	int "Central write interval in milliseconds"
+	default 20
+	range 20 5000
+	depends on PHANTOMCHANNEL_CENTRAL_TX
+
+config PHANTOMCHANNEL_CONN_INTERVAL_UNITS
+	int "Requested LE connection interval in 1.25 ms units"
+	default 16
+	range 6 3200
+	depends on PHANTOMCHANNEL_CENTRAL_TX
+	help
+	  Requested connection interval for the central.  The event-timing
+	  calibration image can set this independently from the application write
+	  cadence so its benign link matches the formal capture parameters.
+
+config PHANTOMCHANNEL_FIXED_TARGET
+	bool "Connect to a fixed target address"
+	default y
+	depends on PHANTOMCHANNEL_CENTRAL_TX
+	help
+	  Connect directly to the configured static random address instead of
+	  selecting the strongest connectable advertisement. This is useful for
+	  isolating a dedicated PhantomChannel GATT sink during debugging.
+
+config PHANTOMCHANNEL_TARGET_ADDRESS
+	string "Fixed target static random address"
+	default "C0:DE:52:83:00:33"
+	depends on PHANTOMCHANNEL_FIXED_TARGET
+	help
+	  Bluetooth LE static random address of the dedicated GATT sink.
+
+config PHANTOMCHANNEL_TIMING_DEBUG
+	bool "Enable PhantomChannel controller timing diagnostics"
+	default n
+	depends on BT_CTLR && BT_LL_SW_SPLIT
+	help
+	  Emit non-blocking RTT diagnostics for marker position, post-CRC tail,
+	  END/PHYEND timestamps, TIFS, HCTO and RX hits.
+
+config PHANTOMCHANNEL_LL_TX_DEBUG
+	bool "Enable per-PDU PhantomChannel LL TX diagnostics"
+	default n
+	depends on PHANTOMCHANNEL_CENTRAL_TX
+	help
+	  Emit one PHANTOM_LL_TX record for every embedded data PDU. Keep this
+	  disabled for normal central tests so RTT retains connection and error
+	  records instead of being filled by per-PDU diagnostics.
+
+config PHANTOMCHANNEL_DYNAMIC_TIMING
+	bool "Use dynamic PhantomChannel TIFS and slot correction"
+	default y
+	depends on PHANTOMCHANNEL_CENTRAL_TX
+	help
+	  Apply PHY-aware marker/length correction to central TX-to-RX paths.
+
+config PHANTOMCHANNEL_FORCE_2M
+	bool "Require symmetric 2M PHY before central writes"
+	default y
+	depends on PHANTOMCHANNEL_CENTRAL_TX && BT_PHY_UPDATE
+	help
+	  Request 2M for both TX and RX after connection establishment and hold
+	  Phantom writes until the controller reports symmetric 2M operation.
+	  If the peer does not accept 2M, the central remains connected but does
+	  not send test writes, preventing an accidental 1M measurement.
+
+config PHANTOMCHANNEL_FORCE_1M
+	bool "Require symmetric 1M PHY before central writes"
+	default n
+	depends on PHANTOMCHANNEL_CENTRAL_TX && BT_PHY_UPDATE && !PHANTOMCHANNEL_FORCE_2M
+	help
+	  Keep the central on symmetric 1M operation and hold Phantom writes until
+	  the controller reports TX/RX 1M. This is the comparison mode for the
+	  default symmetric 2M configuration.
+
+config PHANTOMCHANNEL_RX_GUARD_US
+	int "Extra central RX guard time in microseconds"
+	default 0
+	range 0 32
+	depends on PHANTOMCHANNEL_DYNAMIC_TIMING
+	help
+	  Open the central RX window this many microseconds earlier than the
+	  nominal post-CRC tail correction. This is an independent timing margin,
+	  not part of the PhantomChannel tail airtime calculation.
+
+config PHANTOMCHANNEL_COUNTER_DEBUG
+	bool "Enable low-rate PhantomChannel ACK counters"
+	default n
+	depends on PHANTOMCHANNEL_CENTRAL_TX
+	help
+	  Print one aggregate controller counter line per second after the first
+	  embedded TX. This does not emit per-packet diagnostics.
+
+config PHANTOMCHANNEL_EMBED_ENABLE
+	bool "Enable central post-CRC embedding hook"
+	default y
+	depends on PHANTOMCHANNEL_CENTRAL_TX
+	help
+	  Enable the controller-side post-CRC PhantomChannel packet rewrite.
+
+endmenu
+
+source "Kconfig.zephyr"
