+static uint32_t phantom_pip_fingerprint(const struct pdu_data *pdu)
+{
+	uint32_t hash = 2166136261U;
+
+	if (!pdu) {
+		return 0U;
+	}
+
+	/* The controller mutates SN/NESN/MD/RFU while a queued notification is
+	 * waiting for its compatible channel.  The source identity therefore
+	 * covers the stable PDU content only; the eight radio images below cover
+	 * all possible sequence/MD header states. */
+	hash ^= pdu->len;
+	hash *= 16777619U;
+	for (uint16_t index = 0U; index < pdu->len; index++) {
+		hash ^= pdu->lldata[index];
+		hash *= 16777619U;
+	}
+
+	return hash;
+}
+
+static uint8_t phantom_pip_header_variant(const struct pdu_data *pdu)
+{
+	return (uint8_t)((pdu->sn & 1U) |
+			 ((pdu->nesn & 1U) << 1) |
+			 ((pdu->md & 1U) << 2));
+}
+
+static bool phantom_pip_preamble_valid(const struct lll_conn *lll,
+					       const struct pdu_data *pdu,
+					       uint16_t fake_len, uint8_t channel)
+{
+	uint8_t fake_header[2];
+	uint8_t real_preamble;
+
+	fake_header[0] = *((const uint8_t *)pdu);
+	fake_header[1] = (uint8_t)fake_len;
+	data_whitening_lut(fake_header, sizeof(fake_header), channel);
+	real_preamble = (lll->access_addr[0] & 1U) ? 0x55U : 0xAAU;
+
+#if defined(CONFIG_BT_CTLR_PHY)
+	if (lll->phy_tx == PHY_2M) {
+		return fake_header[0] == real_preamble &&
+			fake_header[1] == real_preamble;
+	}
+#endif
+
+	return fake_header[1] == real_preamble;
+}
+
+/* Select the shortest fake length (base..bound) that produces a legal real-AA
+ * preamble on at least one CSA#1 channel.  The real view (including covert)
+ * is unchanged; only trailing fake-view padding is added.  The caller passes
+ * the exact variant header so the 2M two-byte preamble contract is evaluated
+ * for the current SN/NESN/MD state. */
+static uint16_t phantom_pip_fake_len_select(const struct lll_conn *lll,
+					    const struct pdu_data *pdu,
+					    uint16_t base_len,
+					    uint16_t max_tx_octets)
+{
+	uint16_t bound = max_tx_octets;
+	uint16_t fake_len;
+
+	if (bound > MAX_RADIO_PAYLOAD) {
+		bound = MAX_RADIO_PAYLOAD;
+	}
+	if (base_len > bound) {
+		return 0U;
+	}
+	if (IS_ENABLED(CONFIG_PHANTOMCHANNEL_PIP_FORCE_EVERY_NOTIFY)) {
+		return base_len;
+	}
+	for (fake_len = base_len; fake_len <= bound; fake_len++) {
+		for (uint8_t channel = 0U;
+		     channel < PHANTOM_PIP_CHANNEL_COUNT; channel++) {
+			if (phantom_pip_preamble_valid(lll, pdu, fake_len,
+						       channel)) {
+				return fake_len;
+			}
+		}
+	}
+	return 0U;
+}
+
+static bool phantom_pip_build_image(const struct lll_conn *lll,
+					    const struct pdu_data *source,
+					    uint8_t channel,
+					    uint16_t selected_fake_len,
+					    struct phantom_pip_image *image)
+{
+	uint16_t marker_pos;
+	uint16_t fake_len;
+	uint16_t base_fake_len;
+	uint16_t real_ext_len;
+	size_t covert_len;
+	uint8_t fake_header_raw[2];
+	uint8_t crc_buf[PHANTOM_TX_PDU_SCRATCH_SIZE];
+	uint32_t crc_data;
+	struct pdu_data *out;
+
+	if (!phantom_pip_marker_find(source, &marker_pos) || marker_pos < 4U ||
+		(uint16_t)(marker_pos + 3U) > source->len) {
+		return false;
+	}
+
+	covert_len = (size_t)source->len - marker_pos - 3U;
+	real_ext_len = (uint16_t)(2U + marker_pos + 3U + covert_len);
+	base_fake_len = (uint16_t)(marker_pos + covert_len + 9U);
+	fake_len = selected_fake_len ? selected_fake_len : base_fake_len;
+	if (fake_len < base_fake_len) {
+		return false;
+	}
+	if (real_ext_len > sizeof(crc_buf) || fake_len > MAX_RADIO_PAYLOAD ||
+		(uint16_t)(fake_len + 2U) > sizeof(crc_buf) ||
+		PDU_DC_LL_HEADER_SIZE + fake_len + 1U > PHANTOM_PIP_IMAGE_SIZE) {
+		return false;
+	}
+
+	out = (struct pdu_data *)image->storage;
+	memset(image->storage, 0, sizeof(image->storage));
+	memcpy(out, source, PDU_DC_LL_HEADER_SIZE);
+	out->len = (uint8_t)fake_len;
+	out->octet3 = source->octet3;
+	fake_header_raw[0] = *((const uint8_t *)source);
+	fake_header_raw[1] = (uint8_t)fake_len;
+
+	/* R1 = W_r(H_r | payload_r | CRC_r) | covert_raw.  The L2CAP length
+	 * repair is part of the real view and therefore also gets whitened.
+	 * Covert stays raw and is covered by hardware whitening only. */
+	crc_buf[0] = fake_header_raw[0];
+	crc_buf[1] = (uint8_t)marker_pos;
+	memcpy(&crc_buf[2], source->lldata, marker_pos);
+	crc_buf[2] = (uint8_t)((marker_pos - 4U) & 0xFFU);
+	crc_buf[3] = (uint8_t)(((marker_pos - 4U) >> 8) & 0xFFU);
+	crc_data = ble_crc24_optimized(crc_buf, marker_pos + 2U, lll->crc_init);
+	crc_buf[2U + marker_pos + 0U] = bit_reverse8((crc_data >> 16) & 0xFFU);
+	crc_buf[2U + marker_pos + 1U] = bit_reverse8((crc_data >> 8) & 0xFFU);
+	crc_buf[2U + marker_pos + 2U] = bit_reverse8(crc_data & 0xFFU);
+	memcpy(&crc_buf[2U + marker_pos + 3U],
+	       &source->lldata[marker_pos + 3U], covert_len);
+	data_whitening_lut(crc_buf, 2U + marker_pos + 3U, channel);
+
+	/* F = H_f(raw) | AA_r | R1.  Header and LENGTH remain raw in DMA;
+	 * the second pass stops at the end of the real CRC; covert and any
+	 * fake-view padding stay raw for hardware whitening. */
+	memcpy(out->lldata, lll->access_addr, 4U);
+	memcpy(&out->lldata[4], crc_buf, real_ext_len);
+	/* Optional bytes after R1 are fake-view-only padding. */
+	if (fake_len > (uint16_t)(4U + real_ext_len)) {
+		memset(&out->lldata[4U + real_ext_len], 0U,
+		       fake_len - (uint16_t)(4U + real_ext_len));
+	}
+	crc_buf[0] = fake_header_raw[0];
+	crc_buf[1] = fake_header_raw[1];
+	memcpy(&crc_buf[2], out->lldata, fake_len);
+	data_whitening_lut(crc_buf, 2U + 4U + 2U + marker_pos + 3U, channel);
+	memcpy(out->lldata, &crc_buf[2], fake_len);
+	*((uint8_t *)out) = fake_header_raw[0];
+	out->len = (uint8_t)fake_len;
+	image->storage[PDU_DC_LL_HEADER_SIZE + fake_len] = 0xA5U;
+	if (image->storage[PDU_DC_LL_HEADER_SIZE + fake_len] != 0xA5U) {
+		return false;
+	}
+
+	image->flag_pos = marker_pos;
+	image->real_len = marker_pos;
+	image->covert_len = (uint16_t)covert_len;
+	image->fake_len = fake_len;
+	image->real_whiten_len = (uint16_t)(2U + marker_pos + 3U);
+	image->fake_whiten_len = (uint16_t)(2U + 4U + 2U + marker_pos + 3U);
+
+	return true;
+}
+
+static bool phantom_pip_identity_matches(const struct lll_conn *lll,
+						 const struct pdu_data *pdu)
+{
+#if !defined(CONFIG_PHANTOMCHANNEL_PIP_PERIPHERAL_TX)
+	ARG_UNUSED(lll);
+	ARG_UNUSED(pdu);
+	return false;
+#else
+	if (!phantom_pip_prepared.valid || !lll || !pdu ||
+		phantom_pip_prepared.handle != lll->handle ||
+		phantom_pip_prepared.source != pdu ||
+		phantom_pip_prepared.source_len != pdu->len ||
+		phantom_pip_prepared.source_ll_id != pdu->ll_id ||
+		memcmp(phantom_pip_prepared.real_access_address, lll->access_addr,
+		       sizeof(lll->access_addr)) != 0 ||
+		memcmp(phantom_pip_prepared.crc_init, lll->crc_init,
+		       sizeof(lll->crc_init)) != 0) {
+		return false;
+	}
+	if (phantom_pip_fingerprint(pdu) != phantom_pip_prepared.source_fingerprint) {
+		return false;
+	}
+
+#if defined(CONFIG_BT_CTLR_PHY)
+	if (phantom_pip_prepared.phy != lll->phy_tx) {
+		return false;
+	}
+#endif
+
+	/* The queued PDU storage is controller-owned and may be normalized by
+	 * lll_conn_pdu_tx_prep() after ULL hand-off.  The immutable prebuilt image
+	 * is the source of truth for the payload; pointer/length/LLID plus the
+	 * connection tuple above identify the node without re-reading mutable
+	 * bytes on the RADIO deadline. */
+	return true;
+#endif
+}
+
+static uint32_t phantom_pip_identity_mismatch_reason(const struct lll_conn *lll,
+							    const struct pdu_data *pdu)
+{
+#if !defined(CONFIG_PHANTOMCHANNEL_PIP_PERIPHERAL_TX)
+	ARG_UNUSED(lll);
+	ARG_UNUSED(pdu);
+	return 0U;
+#else
+	uint32_t reason = 0U;
+
+	if (!phantom_pip_prepared.valid) {
+		reason |= BIT(0);
+	}
+	if (!lll || !pdu) {
+		return reason | BIT(1);
+	}
+	if (phantom_pip_prepared.handle != lll->handle) {
+		reason |= BIT(2);
+	}
+	if (phantom_pip_prepared.source != pdu) {
+		reason |= BIT(3);
+	}
+	if (phantom_pip_prepared.source_len != pdu->len) {
+		reason |= BIT(4);
+	}
+	if (phantom_pip_prepared.source_ll_id != pdu->ll_id) {
+		reason |= BIT(5);
+	}
+	if (memcmp(phantom_pip_prepared.real_access_address, lll->access_addr,
+		   sizeof(lll->access_addr)) != 0) {
+		reason |= BIT(6);
+	}
+	if (memcmp(phantom_pip_prepared.crc_init, lll->crc_init,
+		   sizeof(lll->crc_init)) != 0) {
+		reason |= BIT(7);
+	}
+#if defined(CONFIG_BT_CTLR_PHY)
+	if (phantom_pip_prepared.phy != lll->phy_tx) {
+		reason |= BIT(8);
+	}
+#endif
+	return reason;
+#endif
+}
+
+bool lll_conn_phantom_pip_tx_ready(const struct lll_conn *lll,
+					   const struct pdu_data *pdu)
+{
+#if !defined(CONFIG_PHANTOMCHANNEL_PIP_PERIPHERAL_TX)
+	ARG_UNUSED(lll);
+	ARG_UNUSED(pdu);
+	return false;
+#else
+	if (!phantom_pip_identity_matches(lll, pdu)) {
+#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+		phantom_counters.pip_identity_mismatch_last =
+			phantom_pip_identity_mismatch_reason(lll, pdu);
+		if (phantom_pip_prepared.valid) {
+			phantom_counters.pip_source_mismatch_defer++;
+		} else {
+			phantom_counters.pip_wait_not_prepared++;
+		}
+		/* A rejected prepared image is still a strict-wait state.  Start the
+		 * deferred snapshot here as well so an identity regression cannot
+		 * leave the reason counters permanently invisible. */
+		phantom_counter_start();
+#endif
+		return false;
+	}
+
+#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+	/* prepare sees the real source PDU before RX ISR may replace it with the
+	 * strict-wait empty PDU.  Record the actual connection AA and every CSA#1
+	 * channel visited so UART evidence can distinguish "no compatible channel"
+	 * from a failed RADIO activation. */
+	phantom_counters.pip_marker_seen++;
+	memcpy((void *)phantom_counters.pip_real_access_address,
+	       lll->access_addr, sizeof(lll->access_addr));
+	phantom_counters.pip_real_access_address_valid = true;
+	if (cur_data_chan_use < 32U) {
+		phantom_counters.pip_channel_mask_low |= BIT(cur_data_chan_use);
+	} else if (cur_data_chan_use < PHANTOM_PIP_CHANNEL_COUNT) {
+		phantom_counters.pip_channel_mask_high |=
+			BIT(cur_data_chan_use - 32U);
+	}
+	phantom_counter_start();
+#endif
+	if (cur_data_chan_use >= PHANTOM_PIP_CHANNEL_COUNT) {
+		return false;
+	}
+
+	uint8_t header_variant = phantom_pip_header_variant(pdu);
+#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+	phantom_counters.pip_last_header_variant = header_variant;
+#endif
+	if (cur_data_chan_use < 32U) {
+		if (!(phantom_pip_prepared.channel_mask_low[header_variant] &
+			BIT(cur_data_chan_use))) {
+#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+			phantom_counters.pip_wait_incompatible_channel++;
+#endif
+			return false;
+		}
+		return true;
+	}
+
+	if (!(phantom_pip_prepared.channel_mask_high[header_variant] &
+		BIT(cur_data_chan_use - 32U))) {
+#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+		phantom_counters.pip_wait_incompatible_channel++;
+#endif
+		return false;
+	}
+
+	return true;
+#endif
+}
 
