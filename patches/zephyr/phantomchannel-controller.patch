+static bool phantom_pip_release_pending_node(struct lll_conn *lll)
+{
+	memq_link_t *link;
+	struct node_tx *tx;
+
+	if (!IS_ENABLED(CONFIG_PHANTOMCHANNEL_PIP_PERIPHERAL_TX) ||
+		!lll || lll->role != BT_HCI_ROLE_PERIPHERAL ||
+		!pip_node_pending_release) {
+		return false;
+	}
+
+	/* This is called from the next real-AA RX path after NESN advances.  It is
+	 * deliberately not called from the fake TX DISABLED edge: TX completion is
+	 * not an acknowledgement. */
+	link = memq_peek(lll->memq_tx.head, lll->memq_tx.tail,
+			 (void **)&tx);
+	if (!link || !tx) {
+		return false;
+	}
+
+	LL_ASSERT(lll->handle != 0xFFFF);
+	memq_dequeue(lll->memq_tx.tail, &lll->memq_tx.head, NULL);
+	link->next = tx->next;
+	tx->next = link;
+	ull_conn_lll_ack_enqueue(lll->handle, tx);
+	/* The fake source never entered the normal ACK path, so the ordinary
+	 * fragmentation bookkeeping was not cleared by isr_rx_pdu().  Without
+	 * this reset, the next legal notification inherits the carrier length. */
+	lll->packet_tx_head_len = 0U;
+	lll->packet_tx_head_offset = 0U;
+	pip_node_pending_release = false;
+	#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+	phantom_counters.pending_pip_ack = false;
+	#endif
+	if (!memq_peek(lll->memq_tx.head, lll->memq_tx.tail, NULL)) {
+		lll->empty = 1U;
+	}
+#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+	if (phantom_counters.pip_node_pending_release) {
+		phantom_counters.pip_node_release++;
+		phantom_counters.pip_node_pending_release = false;
+	} else {
+		phantom_counters.pip_duplicate_release++;
+	}
+#endif
+	return true;
+}
