+static void phantom_pip_ll_build_log_enqueue(const struct lll_conn *lll,
+						     const struct pdu_data *pdu,
+						     uint32_t generation,
+						     uint32_t source_fingerprint,
+						     uint8_t source_len,
+						     uint8_t covert_len,
+						     uint8_t fake_len,
+						     uint8_t phy)
+{
+	uint8_t head = phantom_ll_tx_log_head;
+	uint8_t next = (head + 1U) & PHANTOM_LL_TX_LOG_MASK;
+	struct phantom_ll_tx_log_entry *entry;
+
+	phantom_ll_tx_enqueued++;
+	if (next == phantom_ll_tx_log_tail) {
+		phantom_ll_tx_queue_drops++;
+		return;
+	}
+
+	entry = &phantom_ll_tx_log[head];
+	memset(entry, 0, sizeof(*entry));
+	entry->mode = 2U;
+	entry->generation = generation;
+	entry->source_fingerprint = source_fingerprint;
+	entry->app_seq = (pdu->len >= 9U) ?
+		((uint16_t)pdu->lldata[7] | ((uint16_t)pdu->lldata[8] << 8)) :
+		0xFFFFU;
+	entry->seq = 0xFFFFU;
+	entry->channel = 0xFFU;
+	entry->sn = pdu->sn;
+	entry->nesn = pdu->nesn;
+	entry->normal_pdu_len = source_len;
+	entry->flag_pos = (uint16_t)(source_len - covert_len - 3U);
+	entry->real_len = entry->flag_pos;
+	entry->fake_len = fake_len;
+	entry->covert_len = covert_len;
+	entry->real_whiten_len = (uint16_t)(2U + entry->real_len + 3U);
+	entry->fake_whiten_len = (uint16_t)(2U + 4U + 2U + entry->real_len + 3U);
+	entry->air_extra_len = (uint16_t)(entry->fake_len - entry->real_len);
+	memcpy(entry->parser_access_address, lll->access_addr,
+	       sizeof(entry->parser_access_address));
+	memcpy(entry->access_address, lll->access_addr,
+	       sizeof(entry->access_address));
+	memcpy(entry->crc_init, lll->crc_init, sizeof(entry->crc_init));
+	entry->phy = phy;
+
+	phantom_ll_tx_log_head = next;
+	k_work_submit(&phantom_ll_tx_log_work);
+}
