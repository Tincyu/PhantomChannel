+static void phantom_counter_start(void)
+{
+	if (!phantom_counters.reporting_started) {
+		phantom_counters.reporting_started = true;
+		/* UART is deliberately sampled sparsely: a long printk at 115200 baud
+		 * can otherwise delay a controller prepare callback and trip the
+		 * controller's overhead diagnostic while strict PIP is waiting. */
+		(void)k_work_reschedule(&phantom_counter_work, K_SECONDS(3));
+	}
