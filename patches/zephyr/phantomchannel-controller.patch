+static bool phantom_pip_marker_find(const struct pdu_data *pdu, uint16_t *position)
+{
+	if (pdu == NULL || position == NULL || pdu->len < 3U) {
+		return false;
+	}
+
+	for (uint16_t index = 0U; index + 2U < pdu->len; index++) {
+		if (pdu->lldata[index] == 0xAAU &&
+		    pdu->lldata[index + 1U] == 0xAAU &&
+		    pdu->lldata[index + 2U] == 0x02U) {
+			*position = index;
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool phantom_pip_waiting_head(const struct lll_conn *lll)
+{
+	memq_link_t *link;
+	struct node_tx *tx;
+	struct pdu_data *pdu;
+	uint16_t marker_pos;
+
+	if (!IS_ENABLED(CONFIG_PHANTOMCHANNEL_PIP_PERIPHERAL_TX) || !lll ||
+		lll->role != BT_HCI_ROLE_PERIPHERAL || lll->empty) {
+		return false;
+	}
+
+	link = memq_peek(lll->memq_tx.head, lll->memq_tx.tail,
+				 (void **)&tx);
+	if (!link || !tx) {
+		return false;
+	}
+
+	pdu = (void *)(tx->pdu + lll->packet_tx_head_offset);
+	return phantom_pip_marker_find(pdu, &marker_pos);
+}
