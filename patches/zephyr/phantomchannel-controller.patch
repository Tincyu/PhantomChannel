diff --git a/samples/bluetooth/phantomchannel_pip_central_52833/src/main.c b/samples/bluetooth/phantomchannel_pip_central_52833/src/main.c
new file mode 100644
index 00000000000..1d29fa7b41a
--- /dev/null
+++ b/samples/bluetooth/phantomchannel_pip_central_52833/src/main.c
@@ -0,0 +1,365 @@
+/*
+ * PhantomChannel PIP legal notification receiver for nRF52833.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <zephyr/bluetooth/addr.h>
+#include <zephyr/bluetooth/bluetooth.h>
+#include <zephyr/bluetooth/conn.h>
+#include <zephyr/bluetooth/gatt.h>
+#include <zephyr/bluetooth/hci.h>
+#include <zephyr/bluetooth/uuid.h>
+#include <zephyr/kernel.h>
+#include <zephyr/sys/byteorder.h>
+#include <zephyr/sys/printk.h>
+
+#define PIP_SERVICE_UUID_VAL \
+	BT_UUID_128_ENCODE(0x70630001, 0x5048, 0x414e, 0x544f, 0x4d4348414e4c)
+#define PIP_DATA_UUID_VAL \
+	BT_UUID_128_ENCODE(0x70630002, 0x5048, 0x414e, 0x544f, 0x4d4348414e4c)
+#define PIP_VISIBLE_LEN CONFIG_PHANTOMCHANNEL_PIP_VISIBLE_VALUE_LEN
+
+static struct bt_conn *default_conn;
+static struct bt_uuid_128 pip_service_uuid = BT_UUID_INIT_128(PIP_SERVICE_UUID_VAL);
+static struct bt_uuid_128 pip_data_uuid = BT_UUID_INIT_128(PIP_DATA_UUID_VAL);
+static struct bt_uuid_128 discover_uuid;
+static struct bt_gatt_discover_params discover_params;
+static struct bt_gatt_subscribe_params subscribe_params;
+static bt_addr_le_t target_address;
+static bool target_valid;
+static bool subscribed;
+static struct k_work_delayable stats_work;
+static K_MUTEX_DEFINE(state_mutex);
+
+static uint32_t notification_count;
+static uint32_t valid_count;
+static uint32_t malformed_count;
+static uint32_t marker_leak_count;
+static uint32_t duplicate_count;
+static uint32_t gap_count;
+static uint32_t previous_count;
+static uint16_t last_sequence;
+static bool have_sequence;
+
+static void start_discovery(struct bt_conn *conn);
+
+static bool is_marker_present(const uint8_t *data, uint16_t length)
+{
+	for (uint16_t index = 0U; index + 2U < length; index++) {
+		if (data[index] == 0xAAU && data[index + 1U] == 0xAAU &&
+		    data[index + 2U] == 0x02U) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool validate_visible(const uint8_t *data, uint16_t length,
+				    uint16_t *sequence, bool *marker_leak)
+{
+	*sequence = 0U;
+	*marker_leak = is_marker_present(data, length);
+	if (length != PIP_VISIBLE_LEN || length < 3U) {
+		return false;
+	}
+	*sequence = sys_get_le16(data);
+	if (data[2] != (uint8_t)(0xC3U ^ data[0] ^ data[1])) {
+		return false;
+	}
+	return !*marker_leak;
+}
+
+static uint8_t notify_func(struct bt_conn *conn,
+				   struct bt_gatt_subscribe_params *params,
+				   const void *data, uint16_t length)
+{
+	uint16_t seq;
+	bool marker_leak;
+	bool valid;
+
+	ARG_UNUSED(conn);
+	if (data == NULL) {
+		printk("PIP_UNSUBSCRIBED\n");
+		subscribed = false;
+		params->value_handle = 0U;
+		return BT_GATT_ITER_STOP;
+	}
+
+	valid = validate_visible(data, length, &seq, &marker_leak);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	notification_count++;
+	if (marker_leak) {
+		marker_leak_count++;
+	}
+	if (valid) {
+		valid_count++;
+		if (have_sequence) {
+			uint16_t delta = (uint16_t)(seq - last_sequence);
+			if (delta == 0U) {
+				duplicate_count++;
+			} else if (delta != 1U) {
+				gap_count++;
+			}
+		}
+		last_sequence = seq;
+		have_sequence = true;
+	} else {
+		malformed_count++;
+	}
+	k_mutex_unlock(&state_mutex);
+
+	printk("PIP_NOTIFY {\"seq\":%u,\"len\":%u,\"valid\":%u,"
+	       "\"marker_leak\":%u,\"timestamp_us\":%lld}\n",
+	       seq, length, valid ? 1U : 0U, marker_leak ? 1U : 0U,
+	       k_uptime_get() * 1000LL);
+	return BT_GATT_ITER_CONTINUE;
+}
+
+static void stats_work_handler(struct k_work *work)
+{
+	uint32_t count;
+	uint32_t valid;
+	uint32_t malformed;
+	uint32_t leaks;
+	uint32_t duplicates;
+	uint32_t gaps;
+	uint16_t last;
+
+	ARG_UNUSED(work);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	count = notification_count;
+	valid = valid_count;
+	malformed = malformed_count;
+	leaks = marker_leak_count;
+	duplicates = duplicate_count;
+	gaps = gap_count;
+	last = last_sequence;
+	k_mutex_unlock(&state_mutex);
+	printk("PIP_CENTRAL_STATS {\"connected\":%u,\"subscribed\":%u,"
+	       "\"notifications\":%u,\"delta\":%u,\"valid\":%u,"
+	       "\"malformed\":%u,\"marker_leak\":%u,\"duplicates\":%u,"
+	       "\"seq_gaps\":%u,\"last_seq\":%u}\n",
+	       default_conn != NULL ? 1U : 0U, subscribed ? 1U : 0U,
+	       count, count - previous_count, valid, malformed, leaks, duplicates,
+	       gaps, last);
+	previous_count = count;
+	(void)k_work_reschedule(&stats_work,
+				K_MSEC(CONFIG_PHANTOMCHANNEL_PIP_STATS_INTERVAL_MS));
+}
+
+static int start_scan(void);
+
+static uint8_t discover_func(struct bt_conn *conn,
+				     const struct bt_gatt_attr *attr,
+				     struct bt_gatt_discover_params *params)
+{
+	int err;
+
+	if (attr == NULL) {
+		printk("PIP_DISCOVERY_DONE\n");
+		memset(params, 0, sizeof(*params));
+		return BT_GATT_ITER_STOP;
+	}
+
+	{
+		char uuid_text[BT_UUID_STR_LEN];
+		bt_uuid_to_str(attr->uuid, uuid_text, sizeof(uuid_text));
+		printk("PIP_DISCOVERY_ATTR {\"handle\":%u,\"uuid\":\"%s\","
+		       "\"type\":%u}\n", attr->handle, uuid_text,
+		       (unsigned int)params->type);
+	}
+
+	if (!bt_uuid_cmp(params->uuid, &pip_service_uuid.uuid)) {
+		memcpy(&discover_uuid, &pip_data_uuid, sizeof(discover_uuid));
+		params->uuid = &discover_uuid.uuid;
+		params->start_handle = attr->handle + 1U;
+		params->type = BT_GATT_DISCOVER_CHARACTERISTIC;
+	} else if (!bt_uuid_cmp(params->uuid, &pip_data_uuid.uuid)) {
+		params->uuid = BT_UUID_GATT_CCC;
+		params->start_handle = attr->handle + 2U;
+		params->type = BT_GATT_DISCOVER_DESCRIPTOR;
+		subscribe_params.value_handle = bt_gatt_attr_value_handle(attr);
+	} else {
+		subscribe_params.notify = notify_func;
+		subscribe_params.value = BT_GATT_CCC_NOTIFY;
+		subscribe_params.ccc_handle = attr->handle;
+		err = bt_gatt_subscribe(conn, &subscribe_params);
+		printk("PIP_SUBSCRIBE {\"status\":%d,\"value_handle\":%u,"
+		       "\"ccc_handle\":%u}\n", err,
+		       subscribe_params.value_handle, subscribe_params.ccc_handle);
+		if (err == 0 || err == -EALREADY) {
+			subscribed = true;
+		}
+		return BT_GATT_ITER_STOP;
+	}
+
+	err = bt_gatt_discover(conn, params);
+	if (err != 0) {
+		printk("PIP_DISCOVERY_ERROR {\"status\":%d}\n", err);
+	}
+	return BT_GATT_ITER_STOP;
+}
+
+static void device_found(const bt_addr_le_t *addr, int8_t rssi, uint8_t type,
+				 struct net_buf_simple *ad)
+{
+	char address_text[BT_ADDR_LE_STR_LEN];
+	int err;
+
+	ARG_UNUSED(ad);
+	if (default_conn != NULL || !target_valid ||
+	    (type != BT_GAP_ADV_TYPE_ADV_IND && type != BT_GAP_ADV_TYPE_ADV_DIRECT_IND &&
+	     type != BT_GAP_ADV_TYPE_EXT_ADV) || bt_addr_le_cmp(addr, &target_address) != 0) {
+		return;
+	}
+	bt_addr_le_to_str(addr, address_text, sizeof(address_text));
+	printk("PIP_TARGET_FOUND {\"address\":\"%s\",\"rssi\":%d}\n",
+	       address_text, rssi);
+	err = bt_le_scan_stop();
+	if (err != 0) {
+		return;
+	}
+	/* Use a stable 15 ms interval so the fixed one-channel PIP
+	 * vector can accumulate its Gate-C/D sample count in a short run. */
+	err = bt_conn_le_create(addr, BT_CONN_LE_CREATE_CONN,
+				BT_LE_CONN_PARAM(BT_GAP_US_TO_CONN_INTERVAL(15000),
+						BT_GAP_US_TO_CONN_INTERVAL(15000), 0, 400),
+				&default_conn);
+	printk("PIP_CONNECT_CREATE {\"status\":%d}\n", err);
+	if (err != 0) {
+		default_conn = NULL;
+		(void)start_scan();
+	}
+}
+
+static int start_scan(void)
+{
+	struct bt_le_scan_param params = {
+		.type = BT_LE_SCAN_TYPE_ACTIVE,
+		.options = BT_LE_SCAN_OPT_NONE,
+		.interval = BT_GAP_SCAN_FAST_INTERVAL,
+		.window = BT_GAP_SCAN_FAST_WINDOW,
+	};
+	int err = bt_le_scan_start(&params, device_found);
+
+	printk("PIP_SCAN {\"status\":%d}\n", err);
+	return err;
+}
+
+static void mtu_exchange_cb(struct bt_conn *conn, uint8_t err,
+				    struct bt_gatt_exchange_params *params)
+{
+	ARG_UNUSED(params);
+	printk("PIP_MTU {\"status\":%u,\"mtu\":%u}\n", err,
+	       bt_gatt_get_mtu(conn));
+	if (err == 0U) {
+		start_discovery(conn);
+	}
+}
+
+static struct bt_gatt_exchange_params mtu_exchange_params = {
+	.func = mtu_exchange_cb,
+};
+
+static void start_discovery(struct bt_conn *conn)
+{
+	int err;
+
+	memcpy(&discover_uuid, &pip_service_uuid, sizeof(discover_uuid));
+	discover_params.uuid = &discover_uuid.uuid;
+	discover_params.func = discover_func;
+	discover_params.start_handle = BT_ATT_FIRST_ATTRIBUTE_HANDLE;
+	discover_params.end_handle = BT_ATT_LAST_ATTRIBUTE_HANDLE;
+	discover_params.type = BT_GATT_DISCOVER_PRIMARY;
+	err = bt_gatt_discover(conn, &discover_params);
+	printk("PIP_DISCOVERY_START {\"status\":%d,\"mtu\":%u}\n", err,
+	       bt_gatt_get_mtu(conn));
+}
+
+static void connected(struct bt_conn *conn, uint8_t err)
+{
+	struct bt_conn_info info;
+	char peer[BT_ADDR_LE_STR_LEN];
+
+	bt_addr_le_to_str(bt_conn_get_dst(conn), peer, sizeof(peer));
+	if (err != 0U) {
+		printk("PIP_CONNECTED {\"status\":%u,\"peer\":\"%s\"}\n", err, peer);
+		if (default_conn != NULL) {
+			bt_conn_unref(default_conn);
+			default_conn = NULL;
+		}
+		(void)start_scan();
+		return;
+	}
+	printk("PIP_CONNECTED {\"status\":0,\"peer\":\"%s\","
+	       "\"pairing\":0,\"bonding\":0,\"encryption\":0}\n", peer);
+	if (bt_conn_get_info(conn, &info) == 0 && info.type == BT_CONN_TYPE_LE) {
+		printk("PIP_PHY {\"tx_phy\":%u,\"rx_phy\":%u,\"interval_ms\":%u}\n",
+		       info.le.phy != NULL ? info.le.phy->tx_phy : 0U,
+		       info.le.phy != NULL ? info.le.phy->rx_phy : 0U,
+		       BT_CONN_INTERVAL_TO_MS(info.le.interval));
+	}
+#if defined(CONFIG_PHANTOMCHANNEL_PIP_REQUEST_2M) && CONFIG_PHANTOMCHANNEL_PIP_REQUEST_2M
+	printk("PIP_PHY_REQUEST {\"mode\":\"2M\",\"status\":%d}\n",
+	       bt_conn_le_phy_update(conn, BT_CONN_LE_PHY_PARAM_2M));
+#endif
+
+	err = bt_gatt_exchange_mtu(conn, &mtu_exchange_params);
+	if (err == -EALREADY) {
+		start_discovery(conn);
+	} else if (err != 0) {
+		printk("PIP_MTU {\"status\":%d,\"mtu\":%u}\n", err,
+		       bt_gatt_get_mtu(conn));
+	}
+}
+
+static void disconnected(struct bt_conn *conn, uint8_t reason)
+{
+	printk("PIP_DISCONNECTED {\"reason\":%u,\"timestamp_us\":%lld}\n",
+	       reason, k_uptime_get() * 1000LL);
+	subscribed = false;
+	if (default_conn == conn) {
+		bt_conn_unref(default_conn);
+		default_conn = NULL;
+	}
+	(void)start_scan();
+}
+
+BT_CONN_CB_DEFINE(pip_central_conn_callbacks) = {
+	.connected = connected,
+	.disconnected = disconnected,
+};
+
+int main(void)
+{
+	int err;
+
+	err = bt_addr_le_from_str(CONFIG_PHANTOMCHANNEL_PIP_TARGET_ADDRESS, "random",
+				  &target_address);
+	if (err != 0 || !BT_ADDR_IS_STATIC(&target_address.a)) {
+		printk("PIP_TARGET_ERROR {\"status\":%d}\n", err != 0 ? err : -EINVAL);
+		return 0;
+	}
+	target_valid = true;
+	err = bt_enable(NULL);
+	printk("PIP_CENTRAL_BOOT {\"bt_enable\":%d,\"target\":\"%s\","
+	       "\"phantom_tx\":0,\"pip_tx\":0,\"encryption\":0,\"bonding\":0}\n",
+	       err, CONFIG_PHANTOMCHANNEL_PIP_TARGET_ADDRESS);
+	if (err != 0) {
+		return 0;
+	}
+	k_work_init_delayable(&stats_work, stats_work_handler);
+	(void)k_work_reschedule(&stats_work,
+				K_MSEC(CONFIG_PHANTOMCHANNEL_PIP_STATS_INTERVAL_MS));
+	(void)start_scan();
+	while (true) {
+		k_sleep(K_SECONDS(1));
+	}
+}
