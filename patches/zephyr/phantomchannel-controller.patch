+/* Number of consecutive connection events skipped because the prepare
+ * pipeline stayed full.  Beyond this the link is considered stalled (the
+ * skipped event never reaches the radio, so no event_done is generated and
+ * the normal supervision-timeout path cannot run) and the connection is
+ * terminated locally so the host can reconnect. */
+#define ULL_PERIPH_PIPELINE_STALL_MAX 4U
+static uint8_t periph_pipeline_stall_count;
