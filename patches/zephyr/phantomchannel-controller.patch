diff --git a/samples/bluetooth/phantomchannel_sink_52833/src/main.c b/samples/bluetooth/phantomchannel_sink_52833/src/main.c
new file mode 100644
index 00000000000..8af63d839e3
--- /dev/null
+++ b/samples/bluetooth/phantomchannel_sink_52833/src/main.c
@@ -0,0 +1,406 @@
+/*
+ * Fixed-address PhantomChannel GATT sink for nRF52833 debugging.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <zephyr/bluetooth/addr.h>
+#include <zephyr/bluetooth/bluetooth.h>
+#include <zephyr/bluetooth/conn.h>
+#include <zephyr/bluetooth/gap.h>
+#include <zephyr/bluetooth/gatt.h>
+#include <zephyr/bluetooth/hci.h>
+#include <zephyr/bluetooth/uuid.h>
+#include <zephyr/kernel.h>
+#include <zephyr/sys/byteorder.h>
+#include <zephyr/sys/printk.h>
+#include <zephyr/sys/util.h>
+
+#define PHANTOM_SERVICE_UUID \
+	BT_UUID_128_ENCODE(0x0000ff00, 0x0000, 0x1000, 0x8000, 0x00805f9b34fb)
+#define PHANTOM_WRITE_UUID \
+	BT_UUID_128_ENCODE(0x0000ff01, 0x0000, 0x1000, 0x8000, 0x00805f9b34fb)
+
+#define PHANTOM_WRITE_PREFIX_LEN 1U
+#define PHANTOM_MARKER_LEN 3U
+#define PHANTOM_FRAME_OVERHEAD 6U
+#define PHANTOM_MIN_WRITE_LEN \
+	(PHANTOM_WRITE_PREFIX_LEN + PHANTOM_MARKER_LEN + PHANTOM_FRAME_OVERHEAD)
+#define PHANTOM_MAX_WRITE_LEN 244U
+#define PHANTOM_MARKER_0 0xAAU
+#define PHANTOM_MARKER_1 0xAAU
+#define PHANTOM_MARKER_2 0x00U
+#define PHANTOM_PC_MAGIC_0 0x50U
+#define PHANTOM_PC_MAGIC_1 0x43U
+#define PHANTOM_PAYLOAD_MARKER 0xA5U
+
+static struct bt_uuid_128 service_uuid = BT_UUID_INIT_128(PHANTOM_SERVICE_UUID);
+static struct bt_uuid_128 write_uuid = BT_UUID_INIT_128(PHANTOM_WRITE_UUID);
+
+static struct bt_conn *current_conn;
+static uint8_t identity_id = BT_ID_DEFAULT;
+static struct k_work_delayable stats_work;
+static struct k_work_delayable advertising_work;
+static K_MUTEX_DEFINE(state_mutex);
+#define PHANTOM_DEBUG_CONN_INTERVAL_UNITS 16U /* 20 ms; matched formal central */
+
+static uint32_t write_count;
+static uint32_t valid_count;
+static uint32_t invalid_count;
+static uint32_t post_crc_truncated_count;
+static uint32_t sequence_gap_count;
+static uint32_t callback_error_count;
+static uint32_t previous_write_count;
+static uint32_t previous_valid_count;
+static uint32_t previous_invalid_count;
+static uint32_t previous_truncated_count;
+static uint16_t last_sequence;
+static uint16_t last_length;
+static uint16_t last_frame_length;
+static uint8_t last_error;
+static bool have_sequence;
+
+static const struct bt_data ad[] = {
+	BT_DATA_BYTES(BT_DATA_FLAGS, BT_LE_AD_GENERAL | BT_LE_AD_NO_BREDR),
+	BT_DATA_BYTES(BT_DATA_UUID128_ALL, PHANTOM_SERVICE_UUID),
+};
+
+static const struct bt_data sd[] = {
+	BT_DATA(BT_DATA_NAME_COMPLETE, CONFIG_BT_DEVICE_NAME,
+		sizeof(CONFIG_BT_DEVICE_NAME) - 1U),
+};
+
+static void log_connection_info(const char *event, struct bt_conn *conn)
+{
+	struct bt_conn_info info;
+	char peer[BT_ADDR_LE_STR_LEN];
+
+	bt_addr_le_to_str(bt_conn_get_dst(conn), peer, sizeof(peer));
+	if (bt_conn_get_info(conn, &info) == 0 && info.type == BT_CONN_TYPE_LE) {
+		printk("SINK_%s peer=%s interval_ms=%u latency=%u timeout_ms=%u mtu=%u\n",
+		       event, peer, BT_CONN_INTERVAL_TO_MS(info.le.interval),
+		       info.le.latency, info.le.timeout * 10U, bt_gatt_get_mtu(conn));
+	} else {
+		printk("SINK_%s peer=%s info_error=1\n", event, peer);
+	}
+}
+
+static void reset_connection_counters(void)
+{
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	write_count = 0U;
+	valid_count = 0U;
+	invalid_count = 0U;
+	post_crc_truncated_count = 0U;
+	sequence_gap_count = 0U;
+	callback_error_count = 0U;
+	previous_write_count = 0U;
+	previous_valid_count = 0U;
+	previous_invalid_count = 0U;
+	previous_truncated_count = 0U;
+	last_sequence = 0U;
+	last_length = 0U;
+	last_frame_length = 0U;
+	last_error = 0U;
+	have_sequence = false;
+	k_mutex_unlock(&state_mutex);
+}
+
+static bool validate_write(const uint8_t *data, uint16_t len, uint8_t *error,
+				   uint16_t *sequence, uint16_t *frame_len)
+{
+	const uint8_t *frame;
+	uint8_t check = 0U;
+	uint8_t covert_len;
+
+	*error = 0U;
+	*sequence = 0U;
+	*frame_len = 0U;
+	if (len < PHANTOM_MIN_WRITE_LEN) {
+		*error = 1U;
+		return false;
+	}
+	if (len > PHANTOM_MAX_WRITE_LEN) {
+		*error = 2U;
+		return false;
+	}
+	if (data[0] != 0x01U || data[1] != PHANTOM_MARKER_0 ||
+	    data[2] != PHANTOM_MARKER_1 || data[3] != PHANTOM_MARKER_2) {
+		*error = 3U;
+		return false;
+	}
+
+	frame = &data[PHANTOM_WRITE_PREFIX_LEN + PHANTOM_MARKER_LEN];
+	*frame_len = len - (PHANTOM_WRITE_PREFIX_LEN + PHANTOM_MARKER_LEN);
+	if (*frame_len < PHANTOM_FRAME_OVERHEAD || frame[0] != PHANTOM_PC_MAGIC_0 ||
+	    frame[1] != PHANTOM_PC_MAGIC_1) {
+		*error = 4U;
+		return false;
+	}
+
+	*sequence = sys_get_le16(&frame[2]);
+	covert_len = frame[4];
+	if (*frame_len != (uint16_t)covert_len + PHANTOM_FRAME_OVERHEAD) {
+		*error = 5U;
+		return false;
+	}
+	for (uint16_t i = 0U; i < *frame_len - 1U; i++) {
+		check ^= frame[i];
+	}
+	if (check != frame[*frame_len - 1U]) {
+		*error = 6U;
+		return false;
+	}
+	if (covert_len > 0U && frame[5] != PHANTOM_PAYLOAD_MARKER) {
+		*error = 7U;
+		return false;
+	}
+
+	return true;
+}
+
+static ssize_t write_without_response(struct bt_conn *conn,
+					      const struct bt_gatt_attr *attr,
+					      const void *buf, uint16_t len,
+					      uint16_t offset, uint8_t flags)
+{
+	const uint8_t *data = buf;
+	uint16_t sequence;
+	uint16_t frame_len;
+	uint8_t error;
+	bool valid;
+
+	ARG_UNUSED(conn);
+	ARG_UNUSED(attr);
+	ARG_UNUSED(flags);
+
+	if (offset != 0U) {
+		k_mutex_lock(&state_mutex, K_FOREVER);
+		callback_error_count++;
+		last_error = 8U;
+		k_mutex_unlock(&state_mutex);
+		return BT_GATT_ERR(BT_ATT_ERR_INVALID_OFFSET);
+	}
+
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	write_count++;
+	last_length = len;
+	/* The central controller deliberately removes the post-marker bytes from
+	 * the on-air PDU and recomputes CRC. With covert_len=0, the peer GATT
+	 * server therefore receives the normal one-byte prefix. Count this as a
+	 * transport-level post-CRC observation, not as a malformed ATT write.
+	 */
+	if (len == PHANTOM_WRITE_PREFIX_LEN && data[0] == 0x01U) {
+		post_crc_truncated_count++;
+		last_frame_length = 0U;
+		last_error = 0U;
+		k_mutex_unlock(&state_mutex);
+		return len;
+	}
+
+	valid = validate_write(data, len, &error, &sequence, &frame_len);
+	last_frame_length = frame_len;
+	last_error = error;
+	if (valid) {
+		valid_count++;
+		if (have_sequence && (uint16_t)(sequence - last_sequence) != 1U) {
+			sequence_gap_count++;
+		}
+		last_sequence = sequence;
+		have_sequence = true;
+	} else {
+		invalid_count++;
+	}
+	k_mutex_unlock(&state_mutex);
+
+	/* Keep the ATT write accepted even when the diagnostic validator rejects
+	 * its contents. This separates transport instability from frame errors.
+	 */
+	return len;
+}
+
+BT_GATT_SERVICE_DEFINE(phantom_sink_service,
+	BT_GATT_PRIMARY_SERVICE(&service_uuid),
+	BT_GATT_CHARACTERISTIC(&write_uuid.uuid,
+			       BT_GATT_CHRC_WRITE_WITHOUT_RESP,
+			       BT_GATT_PERM_WRITE, NULL,
+			       write_without_response, NULL)
+);
+
+static void mtu_updated(struct bt_conn *conn, uint16_t tx, uint16_t rx)
+{
+	printk("SINK_MTU_UPDATED tx=%u rx=%u effective=%u\n", tx, rx,
+	       bt_gatt_get_mtu(conn));
+}
+
+static struct bt_gatt_cb gatt_callbacks = {
+	.att_mtu_updated = mtu_updated,
+};
+
+static void stats_work_fn(struct k_work *work)
+{
+	uint32_t writes;
+	uint32_t valid;
+	uint32_t invalid;
+	uint32_t truncated;
+	uint32_t gaps;
+	uint32_t callbacks;
+	uint32_t write_delta;
+	uint32_t valid_delta;
+	uint32_t invalid_delta;
+	uint32_t truncated_delta;
+	uint16_t sequence;
+	uint16_t length;
+	uint16_t frame_length;
+	uint8_t error;
+	bool connected;
+
+	ARG_UNUSED(work);
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	writes = write_count;
+	valid = valid_count;
+	invalid = invalid_count;
+	truncated = post_crc_truncated_count;
+	gaps = sequence_gap_count;
+	callbacks = callback_error_count;
+	write_delta = writes - previous_write_count;
+	valid_delta = valid - previous_valid_count;
+	invalid_delta = invalid - previous_invalid_count;
+	truncated_delta = truncated - previous_truncated_count;
+	previous_write_count = writes;
+	previous_valid_count = valid;
+	previous_invalid_count = invalid;
+	previous_truncated_count = truncated;
+	sequence = last_sequence;
+	length = last_length;
+	frame_length = last_frame_length;
+	error = last_error;
+	connected = current_conn != NULL;
+	k_mutex_unlock(&state_mutex);
+
+	printk("SINK_STATS connected=%u writes=%u(+%u) valid=%u(+%u) "
+	       "truncated=%u(+%u) invalid=%u(+%u) gaps=%u callback_errors=%u last_seq=%u "
+	       "last_len=%u frame_len=%u last_error=%u\n",
+	       connected ? 1U : 0U, writes, write_delta, valid, valid_delta,
+	       truncated, truncated_delta, invalid, invalid_delta, gaps, callbacks,
+	       sequence, length,
+	       frame_length, error);
+	k_work_reschedule(&stats_work, K_SECONDS(1));
+}
+
+static int configure_static_identity(void)
+{
+	bt_addr_le_t identity_addr;
+	char addr_str[BT_ADDR_LE_STR_LEN];
+	int id;
+	int err;
+
+	err = bt_addr_le_from_str("C0:DE:52:83:00:33", "random", &identity_addr);
+	if (err != 0 || !BT_ADDR_IS_STATIC(&identity_addr.a)) {
+		printk("SINK_IDENTITY_ERROR err=%d\n", err != 0 ? err : -EINVAL);
+		return err != 0 ? err : -EINVAL;
+	}
+
+	id = bt_id_create(&identity_addr, NULL);
+	if (id < 0) {
+		printk("SINK_IDENTITY_CREATE_ERROR=%d\n", id);
+		return id;
+	}
+	identity_id = (uint8_t)id;
+	bt_addr_le_to_str(&identity_addr, addr_str, sizeof(addr_str));
+	printk("SINK_IDENTITY id=%d address=%s\n", id, addr_str);
+	return 0;
+}
+
+static int start_advertising(void)
+{
+	struct bt_le_adv_param adv_param = *BT_LE_ADV_CONN_FAST_1;
+	int err;
+
+	adv_param.id = identity_id;
+	err = bt_le_adv_start(&adv_param, ad, ARRAY_SIZE(ad), sd, ARRAY_SIZE(sd));
+	printk("SINK_ADV_START status=%d\n", err);
+	return err;
+}
+
+static void advertising_work_fn(struct k_work *work)
+{
+	ARG_UNUSED(work);
+	(void)start_advertising();
+}
+
+static void connected(struct bt_conn *conn, uint8_t err)
+{
+	if (err != 0U) {
+		printk("SINK_CONNECT_FAILED err=0x%02x %s\n", err,
+		       bt_hci_err_to_str(err));
+		return;
+	}
+
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	if (current_conn != NULL) {
+		bt_conn_unref(current_conn);
+	}
+	current_conn = bt_conn_ref(conn);
+	k_mutex_unlock(&state_mutex);
+	reset_connection_counters();
+	log_connection_info("CONNECTED", conn);
+	printk("SINK_CONN_PARAM_REQUEST skipped=central_requested interval_ms=20 "
+	       "timeout_ms=4000\n");
+}
+
+static void disconnected(struct bt_conn *conn, uint8_t reason)
+{
+	char peer[BT_ADDR_LE_STR_LEN];
+
+	bt_addr_le_to_str(bt_conn_get_dst(conn), peer, sizeof(peer));
+	printk("SINK_DISCONNECTED peer=%s reason=0x%02x %s\n", peer, reason,
+	       bt_hci_err_to_str(reason));
+	k_mutex_lock(&state_mutex, K_FOREVER);
+	if (current_conn != NULL) {
+		bt_conn_unref(current_conn);
+		current_conn = NULL;
+	}
+	k_mutex_unlock(&state_mutex);
+	k_work_reschedule(&advertising_work, K_MSEC(100));
+}
+
+BT_CONN_CB_DEFINE(conn_callbacks) = {
+	.connected = connected,
+	.disconnected = disconnected,
+};
+
+int main(void)
+{
+	int err;
+
+	k_work_init_delayable(&stats_work, stats_work_fn);
+	k_work_init_delayable(&advertising_work, advertising_work_fn);
+
+	err = bt_enable(NULL);
+	printk("SINK_BOOT bt_enable=%d service=0000ff00-0000-1000-8000-00805f9b34fb "
+	       "characteristic=0000ff01-0000-1000-8000-00805f9b34fb address="
+	       "C0:DE:52:83:00:33\n", err);
+	if (err != 0) {
+		return 0;
+	}
+
+	bt_gatt_cb_register(&gatt_callbacks);
+	if (configure_static_identity() != 0) {
+		return 0;
+	}
+	(void)start_advertising();
+	k_work_reschedule(&stats_work, K_SECONDS(1));
+
+	while (true) {
+		k_sleep(K_SECONDS(1));
+	}
+
+	return 0;
+}
