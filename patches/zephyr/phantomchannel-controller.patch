+void lll_conn_tx_pkt_set(struct lll_conn *lll, struct pdu_data *pdu_data_tx)
+{
+	uint8_t phy, flags, pkt_flags;
+	uint16_t max_tx_octets;
+	struct pdu_data *pdu_data_tx_cp = NULL;
+	struct lll_conn_phantom_timing timing;
+	bool phantom_tx_enabled;
+	bool phantom_marker_found = false;
+	covert_done = 0U;
+#if defined(CONFIG_BT_CTLR_DATA_LENGTH)
+	max_tx_octets = lll->dle.eff.max_tx_octets;
+#else /* !CONFIG_BT_CTLR_DATA_LENGTH */
+	max_tx_octets = PDU_DC_PAYLOAD_SIZE_MIN;
+#endif /* !CONFIG_BT_CTLR_DATA_LENGTH */
+
+	if ((PDU_DC_CTRL_TX_SIZE_MAX > PDU_DC_PAYLOAD_SIZE_MIN) &&
+	    (max_tx_octets < PDU_DC_CTRL_TX_SIZE_MAX)) {
+		max_tx_octets = PDU_DC_CTRL_TX_SIZE_MAX;
+	}
+
+#if defined(CONFIG_BT_CTLR_PHY)
+	phy = lll->phy_tx;
+	flags = lll->phy_flags;
+#else /* !CONFIG_BT_CTLR_PHY */
+	phy = 0U;
+	flags = 0U;
+#endif /* !CONFIG_BT_CTLR_PHY */
+
+	radio_phy_set(phy, flags);
+
+#if defined(CONFIG_BT_CTLR_DF_CONN_CTE_TX)
+	if (pdu_data_tx->cp) {
+		pkt_flags = RADIO_PKT_CONF_FLAGS(RADIO_PKT_CONF_PDU_TYPE_DC, phy,
+						 RADIO_PKT_CONF_CTE_ENABLED);
+	} else
+#endif /* CONFIG_BT_CTLR_DF_CONN_CTE_TX */
+	{
+		pkt_flags = RADIO_PKT_CONF_FLAGS(RADIO_PKT_CONF_PDU_TYPE_DC, phy,
+						 RADIO_PKT_CONF_CTE_DISABLED);
+	}
+	
+	uint8_t upd;
+	size_t copy_len = pdu_data_tx->len + 2; 
+	upd = 0U;
+
+	uint8_t crc_buf[PHANTOM_TX_PDU_SCRATCH_SIZE];
+	
+	//00:data 01:cte 02:pip
+	uint8_t is_pip = 0;
+	uint8_t is_ctelike = 0;
+	uint8_t is_data = 0;
+
+#if defined(CONFIG_PHANTOMCHANNEL_DYNAMIC_TIMING)
+	lll_conn_phantom_timing_get(lll, pdu_data_tx, lll->tifs_rx_us, &timing);
+	phantom_last_timing = timing;
+	phantom_last_timing_valid = timing.marker_found != 0U;
+#else
+	memset(&timing, 0, sizeof(timing));
+	phantom_last_timing_valid = false;
+#endif
+
+	phantom_tx_enabled =
+		(IS_ENABLED(CONFIG_PHANTOMCHANNEL_EMBED_ENABLE) &&
+		 ((IS_ENABLED(CONFIG_PHANTOMCHANNEL_PERIPHERAL_TX) &&
+		 (lll->role == BT_HCI_ROLE_PERIPHERAL)) ||
+		  (IS_ENABLED(CONFIG_PHANTOMCHANNEL_CENTRAL_TX) &&
+		   (lll->role == BT_HCI_ROLE_CENTRAL))));
+	flag_pos = 0U;
+	if (phantom_tx_enabled && (pdu_data_tx != NULL)) {
+		for (int i = 0; i + 2 < pdu_data_tx->len; i++) {
+			if (pdu_data_tx->lldata[i] == 0xaa && pdu_data_tx->lldata[i + 1] == 0xaa) {
+				flag_pos = i;  // maker pos
+				phantom_marker_found = true;
+				break;
+			}
+		}
+	} 
+
+
+	// init_whitening_lut();
+	if(phantom_marker_found && pdu_data_tx->lldata[flag_pos + 2] == 0x02){
+		is_pip = 1;
+	}else if (phantom_marker_found && pdu_data_tx->lldata[flag_pos + 2] == 0x01)
+	{
+		is_ctelike = 1;
+	}else if(phantom_marker_found && pdu_data_tx->lldata[flag_pos + 2] == 0x00){
+		is_data = 1;
+	}
+	if (!IS_ENABLED(CONFIG_PHANTOMCHANNEL_PIP_PERIPHERAL_TX) ||
+	    lll->role != BT_HCI_ROLE_PERIPHERAL) {
+		is_pip = 0;
+	}
+	is_ctelike = 0;
+	if(phantom_tx_enabled && phantom_marker_found && is_data &&
+	   (flag_pos > 1) && pdu_data_tx->len > 7 &&
+	   copy_len > (size_t)flag_pos + 5U){
+			
+		size_t aa_covert_len = copy_len - flag_pos;
+		size_t covert_len = aa_covert_len - 3U - 2U;
+
+		pdu_data_tx_cp = phantom_tx_pdu_scratch_get(PDU_DC_LL_HEADER_SIZE +
+							    pdu_data_tx->len);
+		if (pdu_data_tx_cp != NULL) {
+			memcpy(pdu_data_tx_cp, pdu_data_tx,
+			       PDU_DC_LL_HEADER_SIZE + pdu_data_tx->len);
+		} 
+		LL_ASSERT(pdu_data_tx_cp);
+	
+		((uint8_t *)&pdu_data_tx_cp[0])[0] = ((uint8_t *)&pdu_data_tx[0])[0];
+		pdu_data_tx_cp->len = flag_pos;
+		pdu_data_tx_cp->lldata[0] = pdu_data_tx_cp->len - 4;
+
+		crc_buf[0] = (pdu_data_tx_cp->ll_id & 0x03) 	  | // bits 0-1: ll_id
+					((pdu_data_tx_cp->nesn & 0x01) << 2) |  // bit 2: nesn
+					((pdu_data_tx_cp->sn & 0x01) << 3)   |  // bit 3: sn
+					((pdu_data_tx_cp->md & 0x01) << 4)   |  // bit 4: md;    
+					((pdu_data_tx_cp->rfu & 0x07) << 5);   // bit 5: rfu                   
+		crc_buf[1] = pdu_data_tx_cp->len;                     // len
