+static void phantom_pip_ll_tx_done_log_enqueue(const struct lll_conn *lll,
+						       uint32_t generation,
+						       uint32_t source_fingerprint,
+						       uint8_t source_len,
+						       uint8_t flag_pos,
+						       uint8_t fake_len,
+						   uint8_t covert_len,
+						   uint8_t phy,
+						   const uint8_t *fake_addr,
+						   const struct pdu_data *source_pdu,
+						   const struct pdu_data *tx_pdu)
+{
+	uint8_t head = phantom_ll_tx_log_head;
+	uint8_t next = (head + 1U) & PHANTOM_LL_TX_LOG_MASK;
+	struct phantom_ll_tx_log_entry *entry;
+
+	phantom_ll_tx_enqueued++;
+	if (next == phantom_ll_tx_log_tail) {
+		phantom_ll_tx_queue_drops++;
+		return;
+	}
+
+	entry = &phantom_ll_tx_log[head];
+	memset(entry, 0, sizeof(*entry));
+	entry->mode = 3U;
+	entry->generation = generation;
+	entry->source_fingerprint = source_fingerprint;
+	if (source_pdu && source_pdu->len >= 9U) {
+		entry->app_seq = (uint16_t)source_pdu->lldata[7] |
+			((uint16_t)source_pdu->lldata[8] << 8);
+	} else {
+		entry->app_seq = 0xFFFFU;
+	}
+	entry->seq = 0xFFFFU;
+	entry->channel = cur_data_chan_use;
+	entry->sn = lll->sn;
+	entry->nesn = lll->nesn;
+	entry->normal_pdu_len = source_len;
+	entry->flag_pos = flag_pos;
+	entry->real_len = entry->flag_pos;
+	entry->fake_len = fake_len;
+	entry->covert_len = covert_len;
+	entry->real_whiten_len = (uint16_t)(2U + entry->real_len + 3U);
+	entry->fake_whiten_len = (uint16_t)(2U + 4U + 2U + entry->real_len + 3U);
+	entry->air_extra_len = (uint16_t)(entry->fake_len - entry->real_len);
+	entry->tifs_us = pip_tx_tifs_us;
+	entry->rx_end_us = pip_rx_end_us;
+	entry->tx_ready_us = radio_tmr_ready_get();
+	entry->tx_end_us = radio_tmr_end_get();
+	memcpy(entry->parser_access_address, lll->access_addr,
+	       sizeof(entry->parser_access_address));
+	memcpy(entry->access_address, lll->access_addr,
+	       sizeof(entry->access_address));
+	memcpy(entry->fake_access_address, fake_addr,
+	       sizeof(entry->fake_access_address));
+	memcpy(entry->crc_init, lll->crc_init, sizeof(entry->crc_init));
+	entry->phy = phy;
+	entry->radio_prefix0 = NRF_RADIO->PREFIX0;
+	entry->radio_base0 = NRF_RADIO->BASE0;
+	entry->radio_pcnf1 = NRF_RADIO->PCNF1;
+	entry->radio_shorts = NRF_RADIO->SHORTS;
+	if (tx_pdu) {
+		entry->dma_sn = tx_pdu->sn;
+		entry->dma_nesn = tx_pdu->nesn;
+		memcpy(entry->dma_prefix, tx_pdu->lldata,
+		       sizeof(entry->dma_prefix));
+	}
+
+	phantom_ll_tx_log_head = next;
+	k_work_submit(&phantom_ll_tx_log_work);
+}
