+				       sizeof(phantom_tx_pdu_scratch));
+				memcpy(pdu_data_tx_cp, pdu_data_tx,
+				       PDU_DC_LL_HEADER_SIZE);
+				pdu_data_tx_cp->len = (uint8_t)fake_len;
+				pdu_data_tx_cp->octet3 = pdu_data_tx->octet3;
+				fake_header_raw[0] = *((uint8_t *)pdu_data_tx);
+				fake_header_raw[1] = (uint8_t)fake_len;
+
+				/* First software pass: W_r(H_r | payload_r | CRC_r),
+				 * with a complete 16-bit L2CAP length repair.  Covert
+				 * stays raw and is covered by hardware whitening only. */
+				crc_buf[0] = fake_header_raw[0];
+				crc_buf[1] = (uint8_t)flag_pos;
+				memcpy(&crc_buf[2], pdu_data_tx->lldata, flag_pos);
+				crc_buf[2] = (uint8_t)((flag_pos - 4U) & 0xFFU);
+				crc_buf[3] = (uint8_t)(((flag_pos - 4U) >> 8) & 0xFFU);
+				crc_data = ble_crc24_optimized(crc_buf, flag_pos + 2U,
+							      lll->crc_init);
+				crc_buf[2U + flag_pos + 0U] =
+					bit_reverse8((crc_data >> 16) & 0xFFU);
+				crc_buf[2U + flag_pos + 1U] =
+					bit_reverse8((crc_data >> 8) & 0xFFU);
+				crc_buf[2U + flag_pos + 2U] =
+					bit_reverse8(crc_data & 0xFFU);
+				memcpy(&crc_buf[2U + flag_pos + 3U],
+				       &pdu_data_tx->lldata[flag_pos + 3U], covert_len);
+				data_whitening_lut(crc_buf, 2U + flag_pos + 3U,
+						   cur_data_chan_use);
+
+				/* F = H_f(raw) | AA_r | R1.  The second pass is done
+				 * in a contiguous temporary array and stops at the end
+				 * of the real CRC; covert stays raw. */
+				memcpy(pdu_data_tx_cp->lldata, lll->access_addr, 4U);
+				memcpy(&pdu_data_tx_cp->lldata[4], crc_buf,
+				       real_ext_len);
+				crc_buf[0] = fake_header_raw[0];
+				crc_buf[1] = fake_header_raw[1];
+				memcpy(&crc_buf[2], pdu_data_tx_cp->lldata, fake_len);
+				data_whitening_lut(crc_buf, 2U + 4U + 2U + flag_pos + 3U,
+						   cur_data_chan_use);
+				/* Keep H_f and LENGTH raw in DMA; write only F2[2:]. */
+				memcpy(pdu_data_tx_cp->lldata, &crc_buf[2], fake_len);
+				*((uint8_t *)pdu_data_tx_cp) = fake_header_raw[0];
+				pdu_data_tx_cp->len = (uint8_t)fake_len;
+				phantom_tx_pdu_scratch[PDU_DC_LL_HEADER_SIZE + fake_len] = canary;
+
+				/* PIP uses the mapped fake AA, hardware whitening, hardware
+				 * fake CRC, and STATLEN=0. */
+				radio_aa_set(fake_addr);
+				radio_pkt_configure(RADIO_PKT_CONF_LENGTH_8BIT,
+						    (uint8_t)max_tx_octets, pkt_flags);
+				NRF_RADIO->PCNF1 &= ~(RADIO_PCNF1_MAXLEN_Msk |
+					RADIO_PCNF1_STATLEN_Msk | RADIO_PCNF1_BALEN_Msk |
+					RADIO_PCNF1_ENDIAN_Msk);
+				NRF_RADIO->PCNF1 |=
+					(((uint32_t)max_tx_octets << RADIO_PCNF1_MAXLEN_Pos) &
+					 RADIO_PCNF1_MAXLEN_Msk) |
+					(((0UL) << RADIO_PCNF1_STATLEN_Pos) &
+					 RADIO_PCNF1_STATLEN_Msk) |
+					(((3UL) << RADIO_PCNF1_BALEN_Pos) &
+					 RADIO_PCNF1_BALEN_Msk) |
+					(((RADIO_PCNF1_ENDIAN_Little) << RADIO_PCNF1_ENDIAN_Pos) &
+					 RADIO_PCNF1_ENDIAN_Msk);
+				if (phantom_tx_pdu_scratch[PDU_DC_LL_HEADER_SIZE + fake_len] !=
+				    canary) {
+#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+					phantom_counters.pip_scratch_canary_fail++;
+#endif
+					pdu_data_tx_cp = NULL;
+				} else {
+					pip_tx_active = true;
+#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+					phantom_counters.pip_build_ok++;
+#endif
+#if defined(CONFIG_PHANTOMCHANNEL_PERIPHERAL_TX) || \
+	(defined(CONFIG_PHANTOMCHANNEL_LL_TX_DEBUG) && CONFIG_PHANTOMCHANNEL_LL_TX_DEBUG)
+					phantom_pip_ll_tx_log_enqueue(
+						lll, fake_addr, pdu_data_tx_cp, (uint16_t)flag_pos,
+						(uint16_t)flag_pos, (uint16_t)covert_len,
+						(uint16_t)fake_len,
+						(uint16_t)(2U + flag_pos + 3U),
+						(uint16_t)(2U + 4U + 2U + flag_pos + 3U),
+						phy);
+#endif
+					covert_done = 1U;
+				}
+			}
+#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+			else {
+				phantom_counters.pip_build_reject++;
+			}
+#endif
+		}
+	} else if (is_pip && IS_ENABLED(CONFIG_PHANTOMCHANNEL_PIP_PERIPHERAL_TX)) {
+#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+#if defined(CONFIG_BT_CTLR_LE_ENC)
+		if (lll->enc_tx) {
+			phantom_counters.pip_encrypted_reject++;
+		} else {
+			phantom_counters.pip_build_reject++;
+		}
+#else
+		phantom_counters.pip_build_reject++;
+#endif
+#endif
+	} else if (is_pip &&
+		   !IS_ENABLED(CONFIG_PHANTOMCHANNEL_PIP_PERIPHERAL_TX) &&
+		   (flag_pos > 1) && pdu_data_tx->len > 7){ /* legacy PIP */
+
+		uint8_t aa_covert_len = copy_len-flag_pos; //aa_covert_len = 2B flag + covert len
+		uint8_t covert_len = aa_covert_len - 3;
+		uint8_t extra_len = 3+ covert_len;//include crc cal
+		uint8_t extra_hdr = 2+4+2;
+
+		uint8_t fake_addr[4] = { //left rotate 1 bit 
+			(lll->access_addr[3] << 1) | (lll->access_addr[3] >> (7)),
+			(lll->access_addr[2] << 1) | (lll->access_addr[2] >> (7)),
+			(lll->access_addr[1] << 1) | (lll->access_addr[1] >> (7)),
+			(lll->access_addr[0] << 1) | (lll->access_addr[0] >> (7))
+		};
+		radio_aa_set(fake_addr);//fake addr
+
+		pdu_data_tx_cp = phantom_tx_pdu_scratch_get(PDU_DC_LL_HEADER_SIZE +
+							    pdu_data_tx->len +
+							    extra_len + extra_hdr);
+
+		if (pdu_data_tx_cp != NULL) {
+			memcpy(&pdu_data_tx_cp->lldata[extra_hdr-2], pdu_data_tx->lldata, pdu_data_tx->len);
+		} 
+		LL_ASSERT(pdu_data_tx_cp);
+
+		((uint8_t *)&pdu_data_tx_cp[0])[0] = ((uint8_t *)&pdu_data_tx[0])[0];
+		pdu_data_tx_cp->len = flag_pos + extra_hdr + extra_len;//fake len
+		pdu_data_tx_cp->octet3 = pdu_data_tx->octet3;
+
+		for(int i = 0; i < extra_hdr-4; i++){ //real addr
+			pdu_data_tx_cp->lldata[i] = lll->access_addr[i];
+		}
+
+		pdu_data_tx_cp->lldata[extra_hdr-4] = ((uint8_t *)&pdu_data_tx[0])[0];
+		pdu_data_tx_cp->lldata[extra_hdr-4+1] = flag_pos; //real len
+
+		pdu_data_tx_cp->lldata[extra_hdr-2] = flag_pos - 4; //L2cap len
+
+		//cal crc
+		crc_buf[0] = pdu_data_tx_cp->lldata[extra_hdr-2-2] ;
+		crc_buf[1] = pdu_data_tx_cp->lldata[extra_hdr-2 + 1-2]; //len
+		memcpy(&crc_buf[2], &pdu_data_tx_cp->lldata[extra_hdr-2], crc_buf[1]); 
+
+		uint32_t crc_data = ble_crc24_optimized(crc_buf, crc_buf[1]+2, lll->crc_init);
+		uint8_t crc0 = bit_reverse8((crc_data >> 16) & 0xFF);
+		uint8_t crc1 = bit_reverse8((crc_data >> 8) & 0xFF);
+		uint8_t crc2 = bit_reverse8(crc_data & 0xFF);
+
+		pdu_data_tx_cp->lldata[crc_buf[1]+extra_hdr+0-2] = crc0;
+		pdu_data_tx_cp->lldata[crc_buf[1]+extra_hdr+1-2] = crc1;
+		pdu_data_tx_cp->lldata[crc_buf[1]+extra_hdr+2-2] = crc2;
+	
+		for(int i = 1 ;i<covert_len;i++){
+			pdu_data_tx_cp->lldata[crc_buf[1]+extra_hdr+i] = 0x00;
+		}
+		
+		//add covert data
+		// memcpy(&pdu_data_tx_cp->lldata[crc_buf[1]+extra_hdr + 1],  &pdu_data_tx->lldata[flag_pos + 3] , covert_len);
+		// // bt_debug_rx_pdu(0x02, pdu_data_tx_cp->len + 3 + covert_len, 0x02, pdu_data_tx_cp->lldata);
+		
+		// // whiten
+		// // real payload whiten
+		// data_whitening_lut(&pdu_data_tx_cp->lldata[extra_hdr-2-2], flag_pos+2+3, cur_data_chan_use);
+		
+		// uint32_t cycles = DWT_CYCCNT - start;
+		// bt_debug_rx_pdu(cycles, 20, 0x02, pdu_data_tx_cp->lldata);
+		
+		// // whiten fake hdr
+		// whitening_buf[0] = ((uint8_t *)&pdu_data_tx_cp[0])[0];   // Header
+		// whitening_buf[1] = pdu_data_tx_cp->len = flag_pos + extra_hdr + extra_len;   // Length
+
+		// // data_whitening_lut(whitening_buf, 2, cur_data_chan_use);
+		// // ((uint8_t *)&pdu_data_tx_cp[0])[0] = whitening_buf[0];
+		// // pdu_data_tx_cp->len = whitening_buf[1];
+
+		// lll_chan_set_nowhiten(cur_data_chan_use);
+
+		// whiten
+		// real payload whiten
+		data_whitening_lut(&pdu_data_tx_cp->lldata[extra_hdr-2-2], flag_pos+2+3, cur_data_chan_use);
+		
+		crc_buf[0] = ((uint8_t *)&pdu_data_tx_cp[0])[0];
+		crc_buf[1] = pdu_data_tx_cp->len; //len
+		memcpy(&crc_buf[2], &pdu_data_tx_cp->lldata, crc_buf[1]); 
+		data_whitening_lut(crc_buf, flag_pos + 2 + 3 + 6, cur_data_chan_use);
+		((uint8_t *)&pdu_data_tx_cp[0])[0] = crc_buf[0];
+		pdu_data_tx_cp->len = crc_buf[1];
+		memcpy(&pdu_data_tx_cp->lldata[0], &crc_buf[2], flag_pos + 3 + 2 + 4);
+
+		radio_crc_disable(0UL);
+		radio_pkt_configure(RADIO_PKT_CONF_LENGTH_8BIT, max_tx_octets, pkt_flags);
+		// lll_chan_set(data_chan_use);
+		NRF_RADIO->PCNF1 &= ~(RADIO_PCNF1_MAXLEN_Msk | RADIO_PCNF1_STATLEN_Msk |
+					RADIO_PCNF1_BALEN_Msk | RADIO_PCNF1_ENDIAN_Msk);
+		NRF_RADIO->PCNF1 |=
+			((((uint32_t)(max_tx_octets)) << RADIO_PCNF1_MAXLEN_Pos) & RADIO_PCNF1_MAXLEN_Msk) |
+			(((3+covert_len) << RADIO_PCNF1_STATLEN_Pos) & RADIO_PCNF1_STATLEN_Msk) |
+			(((3UL) << RADIO_PCNF1_BALEN_Pos) & RADIO_PCNF1_BALEN_Msk) |
+			(((RADIO_PCNF1_ENDIAN_Little) << RADIO_PCNF1_ENDIAN_Pos) & RADIO_PCNF1_ENDIAN_Msk);
+		covert_done = 1;
+	#if defined(CONFIG_PHANTOMCHANNEL_COUNTER_DEBUG)
+		phantom_counter_embedded_tx(lll);
+	#endif
+	}
+
+	if (0) {
+#if defined(CONFIG_BT_CTLR_LE_ENC)
+	} else if (lll->enc_tx) {
+		radio_pkt_configure(RADIO_PKT_CONF_LENGTH_8BIT, (max_tx_octets + PDU_MIC_SIZE),
+				    pkt_flags);
+		if(covert_done){
+			radio_pkt_tx_set(radio_ccm_tx_pkt_set(&lll->ccm_tx, pdu_data_tx_cp));
+		}else{
+			radio_pkt_tx_set(radio_ccm_tx_pkt_set(&lll->ccm_tx, pdu_data_tx));
+		}
+#endif /* CONFIG_BT_CTLR_LE_ENC */
+	}else{
+
+		if(covert_done){
+
+			radio_pkt_tx_set(pdu_data_tx_cp);
+		}else{
+			if(pdu_data_tx->len >7 ){
+				// bt_debug_rx_pdu(0x00, pdu_data_tx->len, 0xff, pdu_data_tx->lldata);
+			}
+			radio_pkt_configure(RADIO_PKT_CONF_LENGTH_8BIT, max_tx_octets, pkt_flags);
+			radio_pkt_tx_set(pdu_data_tx);
+		}
+
+	}
+
+	if (pip_tx_active && pdu_data_tx_cp != NULL) {
+		pip_tx_pdu = pdu_data_tx_cp;
+		pip_tx_pcnf0 = NRF_RADIO->PCNF0;
+		pip_tx_pcnf1 = NRF_RADIO->PCNF1;
+		pip_tx_fake_addr[0] = (uint8_t)((lll->access_addr[3] << 1) |
+							(lll->access_addr[3] >> 7));
+		pip_tx_fake_addr[1] = (uint8_t)((lll->access_addr[2] << 1) |
+							(lll->access_addr[2] >> 7));
+		pip_tx_fake_addr[2] = (uint8_t)((lll->access_addr[1] << 1) |
+							(lll->access_addr[1] >> 7));
+		pip_tx_fake_addr[3] = (uint8_t)((lll->access_addr[0] << 1) |
+							(lll->access_addr[0] >> 7));
+	}
+}
