@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: Apache-2.0
+
+mainmenu "Bluetooth: PhantomChannel HRS Peripheral"
+
+menu "PhantomChannel HRS peripheral sample"
+
+config PHANTOMCHANNEL_PERIPHERAL_TX
+	bool "Enable peripheral-side PhantomChannel TX embedding"
+	default y
+	depends on BT_CTLR && BT_LL_SW_SPLIT && BT_PERIPHERAL
+	help
+	  Enable the existing Nordic LLL post-CRC TX hook. The application
+	  places a aa aa 00 marker in a normal HRS notification.
+
+config PHANTOMCHANNEL_EMBED_ENABLE
+	bool "Enable controller post-CRC embedding hook"
+	default y
+	depends on BT_CTLR && BT_LL_SW_SPLIT
+	help
+	  Enable the Nordic LLL controller packet rewrite that moves the Phantom
+	  PC frame from the notification payload to after the BLE CRC on air
+	  (post-CRC tail). The application keeps the aa aa 00 marker in the
+	  normal HRS notification; without this the full PC frame is sent inside
+	  the payload and the SDR parser/scorer cannot see the complete frame.
+
+config PHANTOMCHANNEL_COVERT_LEN
+	int "Covert payload length in bytes"
+	default 231
+	range 1 240
+	depends on PHANTOMCHANNEL_PERIPHERAL_TX
+
+config PHANTOMCHANNEL_COVERT_MARKER_BYTE
+	int "First covert payload byte marker"
+	default 165
+	range 0 255
+	depends on PHANTOMCHANNEL_PERIPHERAL_TX
+
+config PHANTOMCHANNEL_NOTIFY_INTERVAL_MS
+	int "Notification interval in milliseconds"
+	default 20
+	range 20 5000
+
+config PHANTOMCHANNEL_NORMAL_PREFIX_LEN
+	int "HRS measurement bytes before the Phantom marker"
+	default 2
+	range 2 16
+
+config PHANTOMCHANNEL_STATIC_ADDRESS
+	string "Peripheral random-static address"
+	default "C0:DE:52:84:00:03"
+
+config PHANTOMCHANNEL_LOW_BAND_CHAN_MAP
+	bool "Request BLE data channels 0-16"
+	default n
+	depends on BT
+
+endmenu
+
+source "Kconfig.zephyr"
