+uint32_t ble_crc24(const uint8_t *data, size_t len, const uint8_t *init)
+{
+    uint32_t crc = ((uint32_t)init[2] << 16) |
+                   ((uint32_t)init[1] << 8) |
+                   ((uint32_t)init[0]);
+
+    for (size_t i = 0; i < len; i++) {
+        uint8_t input = bit_reverse8(data[i]);  
+
+        crc ^= ((uint32_t)input) << 16;
+        for (int j = 0; j < 8; j++) {
+            if (crc & 0x800000) {
+                crc = (crc << 1) ^ 0x00065B;
+            } else {
+                crc <<= 1;
+            }
+            crc &= 0xFFFFFF;
+        }
+    }
+
+    return crc;
 }
 
