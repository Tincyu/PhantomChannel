@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: Apache-2.0
+
+mainmenu "Bluetooth: PhantomChannel PIP 52833 central"
+
+menu "PhantomChannel PIP 52833 central sample"
+
+config PHANTOMCHANNEL_PIP_TARGET_ADDRESS
+	string "PIP peripheral random-static address"
+	default "C0:DE:52:84:00:40"
+
+config PHANTOMCHANNEL_PIP_VISIBLE_VALUE_LEN
+	int "Expected visible notification value length"
+	default 120
+	range 3 200
+
+config PHANTOMCHANNEL_FORCE_ODD_ACCESS_ADDRESS
+	bool "Generate an odd first on-air data-AA byte for the PIP vector"
+	default n
+	help
+	  Test-only option for the isolated PIP sample.  Regenerate the legal
+	  connection access address until its first on-air byte has bit 0 set,
+	  so the fixed fake-length-44 vector uses the real 0x55 preamble.
+
+config PHANTOMCHANNEL_PIP_REQUEST_2M
+	bool "Request 2M PHY after connection"
+	default n
+	depends on BT_PHY_UPDATE
+
+config PHANTOMCHANNEL_PIP_STATS_INTERVAL_MS
+	int "Statistics interval in milliseconds"
+	default 1000
+	range 250 5000
+
+config PHANTOMCHANNEL_LL_RX_DEBUG
+	bool "Enable periodic link-layer RX diagnostics"
+	default n
+	depends on BT_CTLR && BT_LL_SW_SPLIT
+	help
+	  Count CRC-valid link-layer packets without printing from the radio ISR.
+	  This is a diagnostic option for separating radio reception from GATT
+	  notification delivery; it is not required by the PIP data path.
+
+endmenu
+
+source "Kconfig.zephyr"
