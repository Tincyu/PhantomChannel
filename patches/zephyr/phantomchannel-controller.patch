+#if defined(CONFIG_PHANTOMCHANNEL_TIMING_DEBUG)
+		phantom_timing_log_enqueue(PHANTOM_TIMING_LOG_TX, lll->role, &timing,
+						   radio_tmr_end_get(), 0U, 0U,
