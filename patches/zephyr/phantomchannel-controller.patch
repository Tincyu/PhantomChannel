diff --git a/samples/bluetooth/phantomchannel_adv_broadcaster/Kconfig b/samples/bluetooth/phantomchannel_adv_broadcaster/Kconfig
new file mode 100644
index 00000000000..6ddf6cc29e3
--- /dev/null
+++ b/samples/bluetooth/phantomchannel_adv_broadcaster/Kconfig
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: Apache-2.0
+
+mainmenu "Bluetooth: PhantomChannel Advertising Broadcaster"
+
+menu "PhantomChannel advertising broadcaster sample"
+
+config PHANTOMCHANNEL_ADV_COVERT_LEN
+	int "Covert payload length in bytes"
+	default 16
+	range 1 239
+	help
+	  Covert payload bytes carried in the post-CRC advertising tail.
+	  With the stack-wide legacy advertising data limit raised to 255,
+	  the usable maximum is 239 bytes: 255 (LL payload) - 6 (AdvA) - 2
+	  (AD length+type) - 2 (marker) - 6 (PC frame overhead).
+
+config PHANTOMCHANNEL_ADV_BENIGN
+	bool "Build benign broadcaster without PhantomChannel frame"
+	default n
+	help
+	  Advertise only the advertiser address with no marker, PC frame, or
+	  post-CRC tail. This provides a true 0-byte benign boundary baseline.
+
+config PHANTOMCHANNEL_ADV_INTERVAL_MS
+	int "Advertising event interval in milliseconds"
+	default 100
+	range 20 10000
+
+config PHANTOMCHANNEL_ADV_PADDING_LEN
+	int "Readable padding bytes before the marker"
+	default 0
+	range 0 240
+	help
+	  Padding bytes placed before the aa aa marker so the readable part of
+	  the advertising PDU is non-empty (used to test whether the post-CRC
+	  tail bit error rate depends on the preceding payload length).
+
+config PHANTOMCHANNEL_ADV_STATIC_ADDRESS
+	string "Broadcaster random-static address"
+	default "D1:22:33:44:55:66"
+
+config PHANTOMCHANNEL_ADV_EMBED_TEST_OFF
+	bool "Disable post-CRC embedding (isolation test)"
+	default n
+
+config PHANTOMCHANNEL_ADV_EMBED_EVERY
+	bool "Embed the post-CRC tail on every primary advertising channel"
+	default n
+	depends on !PHANTOMCHANNEL_ADV_BENIGN
+	help
+	  Stress-baseline mode for the event-level timing experiment.  When
+	  enabled, the controller moves the PhantomChannel tail after the CRC on
+	  channels 37, 38 and 39.  The formal construction keeps this disabled
+	  and embeds only on the terminal channel 39.
+
+endmenu
+
+source "Kconfig.zephyr"
