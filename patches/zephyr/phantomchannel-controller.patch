+	/* The prepare pipeline is bounded (EVENT_PIPELINE_MAX).  If it is
+	 * already full (events backed up, e.g. the first connection after a
+	 * PHY update), skip this event entirely: enqueuing would overflow and
+	 * asserting would hang the system, while incrementing and dropping
+	 * would leak the reference count.  The connection misses this event
+	 * and recovers via the normal supervision-timeout/reconnect path. */
+	if (ull_prepare_count_get() >= EVENT_PIPELINE_MAX) {
+		DEBUG_RADIO_CLOSE_S(0);
+		if (++periph_pipeline_stall_count >=
+		    ULL_PERIPH_PIPELINE_STALL_MAX) {
+			/* The prepare queue is permanently backed up: this
+			 * event is dropped and never completes, so the ULL
+			 * supervision-timeout check in ull_conn_done() will
+			 * never run.  Terminate the connection locally now to
+			 * let the host reconnect (the app watchdog re-advertises
+			 * when the disconnect callback fires). */
+			periph_pipeline_stall_count = 0U;
+			ull_conn_cleanup_timeout(conn);
+		}
+		return;
+	}
+
+	periph_pipeline_stall_count = 0U;
+
 	/* Increment prepare reference count */
 	ref = ull_ref_inc(&conn->ull);
 	LL_ASSERT(ref);
