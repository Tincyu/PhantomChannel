new file mode 100644
index 00000000000..68bd34e5b24
--- /dev/null
+++ b/samples/bluetooth/phantomchannel_pip_cis_hrs_peripheral/Kconfig
@@ -0,0 +1,102 @@
+# SPDX-License-Identifier: Apache-2.0
+
+mainmenu "Bluetooth: PhantomChannel PIP HRS peripheral"
+
+menu "PhantomChannel PIP HRS peripheral"
+
+config PHANTOMCHANNEL_CIS_ENABLE
+	bool "Enable controller-level CIS server"
+	default n
+	depends on BT_CTLR && BT_LL_SW_SPLIT && BT_PERIPHERAL
+
+config PHANTOMCHANNEL_CIS_SDU_INTERVAL_US
+	int "CIS SDU interval in microseconds"
+	default 10000
+	range 5000 100000
+	depends on PHANTOMCHANNEL_CIS_ENABLE
+
+config PHANTOMCHANNEL_CIS_TX_MTU
+	int "CIS receive SDU MTU"
+	default 247
+	range 1 247
+	depends on PHANTOMCHANNEL_CIS_ENABLE
+
+config PHANTOMCHANNEL_CIS_STATS_INTERVAL_MS
+	int "CIS statistics interval in milliseconds"
+	default 1000
+	range 250 5000
+	depends on PHANTOMCHANNEL_CIS_ENABLE
+
+config PHANTOMCHANNEL_CIS_AA_DEBUG
+	bool "Print controller-generated CIS access address"
+	default n
+	depends on PHANTOMCHANNEL_CIS_ENABLE
+
+config PHANTOMCHANNEL_PIP_PERIPHERAL_TX
+	bool "Enable PIP peripheral TX"
+	default n
+	depends on BT_CTLR && BT_LL_SW_SPLIT && BT_PERIPHERAL
+
+config PHANTOMCHANNEL_PIP_TIMING
+	bool "Enable PIP RX-to-TX timing compensation"
+	default y
+	depends on PHANTOMCHANNEL_PIP_PERIPHERAL_TX
+
+config PHANTOMCHANNEL_PIP_FORCE_EVERY_NOTIFY
+	bool "Attempt PIP on every marked notification"
+	default n
+	depends on PHANTOMCHANNEL_PIP_PERIPHERAL_TX
+
+config PHANTOMCHANNEL_PIP_RELEASE_ON_TX
+	bool "Release hidden PIP carrier after fake TX"
+	default n
+	depends on PHANTOMCHANNEL_PIP_PERIPHERAL_TX
+	help
+	  Release a hidden PIP carrier after its fake waveform is transmitted.
+	  This is required when the peer is an ordinary BLE central that listens
+	  only for the real access address and therefore cannot acknowledge the
+	  fake PIP packet. Keep disabled for the ordinary PIP link test, which
+	  measures a later real-AA NESN acknowledgement.
+
+config PHANTOMCHANNEL_PIP_COUNTER_DEBUG
+	bool "Enable PIP counters"
+	default y
+	depends on PHANTOMCHANNEL_PIP_PERIPHERAL_TX
+
+config PHANTOMCHANNEL_EMBED_ENABLE
+	bool "Enable PIP packet rewriting"
+	default y
+	depends on PHANTOMCHANNEL_PIP_PERIPHERAL_TX
+
+config PHANTOMCHANNEL_PERIPHERAL_TX
+	bool "Enable peripheral Phantom TX diagnostics"
+	default y
+	depends on PHANTOMCHANNEL_PIP_PERIPHERAL_TX
+
+config PHANTOMCHANNEL_COUNTER_DEBUG
+	bool "Enable controller counter diagnostics"
+	default y
+	depends on PHANTOMCHANNEL_PIP_PERIPHERAL_TX
+
+config PHANTOMCHANNEL_COVERT_LEN
+	int "Covert length in bytes"
+	default 2
+	range 0 32
+
+config PHANTOMCHANNEL_COVERT_MARKER_BYTE
+	int "First covert byte marker"
+	default 165
+	range 0 255
+
+config PHANTOMCHANNEL_NOTIFY_INTERVAL_MS
+	int "Heart-rate notification interval in milliseconds"
+	default 1000
+	range 20 5000
+
+config PHANTOMCHANNEL_STATIC_ADDRESS
+	string "Peripheral random-static address"
+	default "C0:DE:52:84:00:41"
+
+endmenu
+
+source "Kconfig.zephyr"
