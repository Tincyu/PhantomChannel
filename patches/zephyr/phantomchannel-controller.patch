diff --git a/samples/bluetooth/phantomchannel_hrs_minimal/src/main.c b/samples/bluetooth/phantomchannel_hrs_minimal/src/main.c
new file mode 100644
index 00000000000..6048cb37f0a
--- /dev/null
+++ b/samples/bluetooth/phantomchannel_hrs_minimal/src/main.c
@@ -0,0 +1,111 @@
+/*
+ * Minimal HRS peripheral for the first-connection 5.2 s death A/B test.
+ * Follows the stock peripheral_hr scheduling: main-loop state polling,
+ * periodic k_sleep notify, no k_work, no PHY callbacks, no PIP code.
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <zephyr/bluetooth/addr.h>
+#include <zephyr/bluetooth/bluetooth.h>
+#include <zephyr/bluetooth/conn.h>
+#include <zephyr/bluetooth/gatt.h>
+#include <zephyr/bluetooth/uuid.h>
+#include <zephyr/kernel.h>
+#include <zephyr/sys/printk.h>
+
+static bool notify_enabled;
+static struct bt_conn *current_conn;
+static uint16_t sequence;
+static uint8_t value[2];
+static uint8_t identity_id;
+
+static const struct bt_data ad[] = {
+	BT_DATA_BYTES(BT_DATA_FLAGS, BT_LE_AD_GENERAL | BT_LE_AD_NO_BREDR),
+	BT_DATA_BYTES(BT_DATA_UUID16_ALL, BT_UUID_16_ENCODE(BT_UUID_HRS_VAL)),
+};
+
+static void ccc_changed(const struct bt_gatt_attr *attr, uint16_t val)
+{
+	ARG_UNUSED(attr);
+	notify_enabled = val == BT_GATT_CCC_NOTIFY;
+	printk("MIN_CCC %u\n", notify_enabled ? 1U : 0U);
+}
+
+BT_GATT_SERVICE_DEFINE(hrs_service,
+	BT_GATT_PRIMARY_SERVICE(BT_UUID_HRS),
+	BT_GATT_CHARACTERISTIC(BT_UUID_HRS_MEASUREMENT, BT_GATT_CHRC_NOTIFY,
+			       BT_GATT_PERM_NONE, NULL, NULL, NULL),
+	BT_GATT_CCC(ccc_changed, BT_GATT_PERM_READ | BT_GATT_PERM_WRITE),
+);
+
+static void connected(struct bt_conn *conn, uint8_t err)
+{
+	if (err) {
+		printk("MIN_CONNECT_FAIL %u\n", err);
+		return;
+	}
+	current_conn = bt_conn_ref(conn);
+	printk("MIN_CONNECTED\n");
+}
+
+static void disconnected(struct bt_conn *conn, uint8_t reason)
+{
+	printk("MIN_DISCONNECTED reason=%u\n", reason);
+	if (current_conn == conn) {
+		bt_conn_unref(current_conn);
+		current_conn = NULL;
+	}
+	notify_enabled = false;
+	sequence = 0U;
+	{
+		struct bt_le_adv_param params = *BT_LE_ADV_CONN_FAST_1;
+
+		params.id = identity_id;
+		(void)bt_le_adv_start(&params, ad, ARRAY_SIZE(ad), NULL, 0);
+	}
+}
+
+BT_CONN_CB_DEFINE(min_conn_callbacks) = {
+	.connected = connected,
+	.disconnected = disconnected,
+};
+
+int main(void)
+{
+	int err;
+	int id;
+
+	err = bt_enable(NULL);
+	printk("MIN_BOOT bt=%d\n", err);
+	if (err != 0) {
+		return 0;
+	}
+	{
+		bt_addr_le_t addr = {
+			.type = BT_ADDR_LE_RANDOM,
+			.a = {{0x41, 0x00, 0x84, 0x52, 0xDE, 0xC0}},
+		};
+		id = bt_id_create(&addr, NULL);
+		printk("MIN_ID %d\n", id);
+		identity_id = (uint8_t)id;
+	}
+	{
+		struct bt_le_adv_param params = *BT_LE_ADV_CONN_FAST_1;
+
+		params.id = (uint8_t)id;
+		err = bt_le_adv_start(&params, ad, ARRAY_SIZE(ad), NULL, 0);
+	}
+	printk("MIN_ADV %d\n", err);
+
+	while (1) {
+		k_sleep(K_MSEC(500));
+		if (notify_enabled && current_conn != NULL) {
+			value[0] = 0x06U;
+			value[1] = (uint8_t)(60U + (sequence % 41U));
+			sequence++;
+			(void)bt_gatt_notify(current_conn, &hrs_service.attrs[2],
+					     value, sizeof(value));
+		}
+	}
+	return 0;
+}
