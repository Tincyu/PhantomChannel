+	}
+
+	entry = &phantom_ll_tx_log[head];
+	entry->mode = 0U;
+	entry->seq = seq;
+	entry->channel = channel;
+	entry->access_address[0] = access_addr[3];
+	entry->access_address[1] = access_addr[2];
+	entry->access_address[2] = access_addr[1];
+	entry->access_address[3] = access_addr[0];
+	entry->parser_access_address[0] = access_addr[0];
+	entry->parser_access_address[1] = access_addr[1];
+	entry->parser_access_address[2] = access_addr[2];
+	entry->parser_access_address[3] = access_addr[3];
+	memset(entry->fake_access_address, 0, sizeof(entry->fake_access_address));
+	entry->crc_init[0] = crc_init[2];
+	entry->crc_init[1] = crc_init[1];
+	entry->crc_init[2] = crc_init[0];
+	entry->normal_pdu_len = normal_pdu_len;
+	entry->phy = 0U;
+	entry->flag_pos = normal_pdu_len;
+	entry->real_len = normal_pdu_len;
+	entry->fake_len = normal_pdu_len + air_extra_len;
+	entry->real_whiten_len = 0U;
+	entry->fake_whiten_len = 0U;
+	entry->air_extra_len = air_extra_len;
+	entry->covert_len = covert_len;
+	entry->covert_marker = covert_marker;
+
+	phantom_ll_tx_log_head = next;
+	k_work_submit(&phantom_ll_tx_log_work);
+}
