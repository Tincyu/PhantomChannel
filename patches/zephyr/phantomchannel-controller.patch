+			       entry.dma_prefix[2], entry.dma_prefix[3], entry.dma_prefix[4],
+			       entry.dma_prefix[5], entry.dma_prefix[6], entry.dma_prefix[7]);
+		} else if (entry.mode == 2U) {
+			printk("PIP_LL_BUILD {\"generation\":%u,"
+			       "\"source_fingerprint\":\"0x%08x\","
+			       "\"app_seq\":%u,"
+			       "\"source_len\":%u,\"flag_pos\":%u,"
