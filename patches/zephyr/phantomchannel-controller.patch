+			phantom_ll_tx_log_meta = entry;
+			phantom_ll_tx_log_meta_valid = true;
+			}
+		}
+
+		if (entry.mode == 1U) {
+			printk("PIP_LL_TX {\"channel\":%u,\"flag_pos\":%u,"
+			       "\"real_len\":%u,\"fake_len\":%u,\"covert_len\":%u,"
+			       "\"real_whiten_len\":%u,\"fake_whiten_len\":%u,"
+			       "\"phy\":%u,\"radio_prefix0\":\"0x%08x\","
