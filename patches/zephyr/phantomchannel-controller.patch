+void ull_conn_iso_link_quality_event(struct lll_conn_iso_stream *cis_lll,
+						     enum ull_iso_link_quality_event event)
+{
+	struct ll_conn_iso_stream *cis;
+
+	cis = CONTAINER_OF(cis_lll, struct ll_conn_iso_stream, lll);
+
+	switch (event) {
+	case ULL_ISO_LINK_QUALITY_RX_UNRECEIVED:
+		cis->hdr.link_quality.rx_unreceived_packets++;
+		break;
+	case ULL_ISO_LINK_QUALITY_RX_CRC_ERROR:
+		cis->hdr.link_quality.crc_error_packets++;
+		break;
+	case ULL_ISO_LINK_QUALITY_RX_SN_MISMATCH:
+		cis->hdr.link_quality.duplicate_packets++;
+		break;
+	case ULL_ISO_LINK_QUALITY_TX_FLUSHED:
+		cis->hdr.link_quality.tx_flushed_packets++;
+		break;
+	case ULL_ISO_LINK_QUALITY_TX_DATA_PDU:
+		cis->hdr.link_quality.tx_last_subevent_packets++;
+		break;
+	default:
+		break;
+	}
+}
+
+void ull_conn_iso_link_quality_preempt_abort(struct lll_conn_iso_stream *cis_lll,
+							     uint32_t overhead)
+{
+	struct ll_conn_iso_stream *cis;
+	uint32_t overhead_us;
+
+	cis = CONTAINER_OF(cis_lll, struct ll_conn_iso_stream, lll);
+	overhead_us = HAL_TICKER_TICKS_TO_US(overhead);
+
+	/* Diagnostic image only: these two otherwise-unused fields expose
+	 * dynamic prepare/preempt cancellations without adding HCI fields.
+	 * tx_unacked_packets = cancellation count
+	 * retransmitted_packets = maximum actual overhead in microseconds
+	 */
+	cis->hdr.link_quality.tx_unacked_packets++;
+	if (overhead_us > cis->hdr.link_quality.retransmitted_packets) {
+		cis->hdr.link_quality.retransmitted_packets = overhead_us;
+	}
+}
+
+void ull_conn_iso_link_quality_tx_state(struct lll_conn_iso_stream *cis_lll,
+							uint64_t expected_payload_count,
+							uint64_t head_payload_count,
+							uint8_t head_valid)
+{
+	struct ll_conn_iso_stream *cis;
+
+	cis = CONTAINER_OF(cis_lll, struct ll_conn_iso_stream, lll);
+	cis->hdr.tx_diagnostic.expected_payload_count = expected_payload_count;
+	cis->hdr.tx_diagnostic.head_payload_count = head_valid ?
+		(uint32_t)head_payload_count : UINT32_MAX;
+	cis->hdr.tx_diagnostic.event_count = (uint32_t)cis_lll->event_count;
+	cis->hdr.tx_diagnostic.event_count_prepare =
+		(uint32_t)cis_lll->event_count_prepare;
+	cis->hdr.tx_diagnostic.bn_curr = cis_lll->tx.bn_curr;
+	cis->hdr.tx_diagnostic.bn = cis_lll->tx.bn;
+	if (!head_valid || head_payload_count != expected_payload_count) {
+		cis->hdr.tx_diagnostic.select_miss++;
+	}
+}
