+static void security_changed(struct bt_conn *conn, bt_security_t level,
+			     enum bt_security_err err)
+{
+	bool start_notifications;
+
+	security_ready = (err == 0 && level >= BT_SECURITY_L2);
+	printk("HRS_SECURITY_CHANGED {\"level\":%u,\"error\":%d,"
+	       "\"error_text\":\"%s\",\"encrypted\":%u}\n",
+	       level, err, bt_security_err_to_str(err),
+	       security_ready ? 1U : 0U);
+	if (!security_ready) {
+		k_work_cancel_delayable(&notify_work);
+		return;
+	}
+
+	start_notifications = notify_enabled;
+	if (start_notifications) {
+		schedule_notification();
+	}
+}
