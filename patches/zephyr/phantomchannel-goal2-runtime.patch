+static void log_active_channel_map(struct bt_conn *conn)
+{
+	struct bt_hci_cp_le_read_chan_map *cp;
+	struct bt_hci_rp_le_read_chan_map *rp;
+	struct net_buf *cmd;
+	struct net_buf *rsp = NULL;
+	uint16_t handle;
+	int err;
+
+	err = bt_hci_get_conn_handle(conn, &handle);
+	if (err != 0) {
+		printk("CENTRAL_CHAN_MAP_READ {\"status\":%d}\n", err);
+		return;
+	}
+	cmd = bt_hci_cmd_create(BT_HCI_OP_LE_READ_CHAN_MAP, sizeof(*cp));
+	if (cmd == NULL) {
+		printk("CENTRAL_CHAN_MAP_READ {\"status\":-ENOMEM}\n");
+		return;
+	}
+	cp = net_buf_add(cmd, sizeof(*cp));
+	cp->handle = sys_cpu_to_le16(handle);
+	err = bt_hci_cmd_send_sync(BT_HCI_OP_LE_READ_CHAN_MAP, cmd, &rsp);
+	if (err != 0 || rsp == NULL || rsp->len < sizeof(*rp)) {
+		printk("CENTRAL_CHAN_MAP_READ {\"status\":%d}\n", err);
+		if (rsp != NULL) {
+			net_buf_unref(rsp);
+		}
+		return;
+	}
+	rp = (struct bt_hci_rp_le_read_chan_map *)rsp->data;
+	printk("CENTRAL_CHAN_MAP_ACTIVE {\"status\":%u,\"map\":\"%02x%02x%02x%02x%02x\"}\n",
+	       rp->status, rp->ch_map[0], rp->ch_map[1], rp->ch_map[2],
+	       rp->ch_map[3], rp->ch_map[4]);
+	net_buf_unref(rsp);
